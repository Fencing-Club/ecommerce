# Local launchers set these per worktree. Deployments set their own canonical origin; see docs/domains.md.
APP_URL=https://main.local.copacker.ai
# Other addresses the same deployment answers on, comma-separated, e.g. https://staging.copacker.ai
APP_ALIAS_URLS=
# Separate browser key per environment, restricted to origins in docs/domains.md,
# Maps JavaScript API and Places API (New). Never use the production key locally.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
DATABASE_URL=postgres://copacker:copacker@127.0.0.1:54329/copacker
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://main.local.copacker.ai/callback
# Restricted browser key for local Maps/Places; never use the staging or production key here.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
TOKEN_ENCRYPTION_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
AMAZON_APPLICATION_ID=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
# Shared non-production callback. Leave all three blank in production.
AMAZON_ADS_RELAY_URL=
# Separate 32 random bytes, base64 encoded; shared only by trusted app environments and the relay.
AMAZON_ADS_RELAY_SECRET=
# Comma-separated exact HTTPS origins, or the restricted patterns documented in docs/amazon-ads.md.
AMAZON_ADS_RELAY_ORIGINS=
# Set to true while the SP-API app is a draft; Amazon requires version=beta on the consent link until it is published.
AMAZON_APP_DRAFT=
# eBay's App ID, Cert ID and redirect URL name (RuName). Without all three, Settings shows eBay as coming soon.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Must map to this checkout's exact HTTPS callback in eBay; never reuse production's RuName locally.
# Main checkout: Andrew_Craswell-AndrewCr-Copack-kmslwycva. Other worktrees need their own registration.
EBAY_RU_NAME=
# The verification token entered with the eBay account deletion endpoint: 32 to 80 letters, digits, _ or -.
EBAY_VERIFICATION_TOKEN=
# Public HTTPS origin for an owned webhook integration slot; never a local app origin.
# Blank locally disables eBay subscriptions. Deployments default to APP_URL.
WEBHOOK_BASE_URL=
# The EventBridge bus eBay notifications are sent on (such as "default"). Unset, the webhook queues their work itself.
EBAY_EVENT_BUS=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
EMAIL_API_KEY=
EMAIL_FROM=
# Where the contact page's messages and new waitlist signups go.
CONTACT_EMAIL=
OPENROUTER_API_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Set false to use Seller Central OAuth instead of private token entry.
AMAZON_SELF_AUTH_ENABLED=true

# Seller ID for the private self-authorization account (not a marketplace ID).
AMAZON_MERCHANT_TOKEN=
