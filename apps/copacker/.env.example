APP_URL=http://localhost:3000
# Other addresses the same deployment answers on, comma-separated, e.g. https://staging.copacker.ai
APP_ALIAS_URLS=
DATABASE_URL=postgres://copacker:copacker@127.0.0.1:54329/copacker
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
TOKEN_ENCRYPTION_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
AMAZON_APPLICATION_ID=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Set to true while the SP-API app is a draft; Amazon requires version=beta on the consent link until it is published.
AMAZON_APP_DRAFT=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
EMAIL_API_KEY=
EMAIL_FROM=
# The Resend segment the marketing page's mailing list adds signups to. Without it, they're contacts in no segment.
MAILING_LIST_SEGMENT_ID=
# Where the contact page's messages go.
CONTACT_EMAIL=
OPENROUTER_API_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
