                          "name": "3 / Reuse everywhere details",
                          "fill": "#52525B",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The editor, import review, server validation, release checks, checklist and PDF packet consume the same result.",
                          "lineHeight": 1.4,
