                    },
                    {
                      "type": "text",
                      "id": "fIwAU",
                      "name": "Template copy",
                      "fill": "#18181B",
                      "textGrowth": "fixed-width",
                      "width": 670,
                      "content": "Each carton must contain only one SKU. Do not mix SKUs.",
                      "lineHeight": 1.35,
                      "fontFamily": "Inter",
