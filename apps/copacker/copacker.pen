              "children": [
                {
                  "type": "text",
                  "id": "v8lDSK",
                  "name": "Keep instructions stable; put values in structured fields",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Keep instructions stable; put values in structured fields",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 18,
