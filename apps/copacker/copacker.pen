                },
                {
                  "type": "frame",
                  "id": "xEuwh",
                  "name": "Profiles are data",
                  "width": "fill_container",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "KJmVC",
                      "name": "Profiles are data label",
                      "fill": "#18181B",
                      "textGrowth": "fixed-width",
                      "width": 230,
                      "content": "Profiles are data",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "dtsFZ",
                      "name": "Profiles are data explanation",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Destination profiles define SKU mixing, quantity basis, size, weight and consistency constraints. Transport profiles define document and label requirements. Keep provider/service, transport mode and pickup/delivery distinct. AGL does not imply AWD, and AWD does not imply pickup.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "VXL2E",
                  "name": "Resolve once per revision",
                  "width": "fill_container",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "D2A4r9",
                      "name": "Resolve once per revision label",
                      "fill": "#18181B",
                      "textGrowth": "fixed-width",
                      "width": 230,
                      "content": "Resolve once per revision",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "JB7Z4",
                      "name": "Resolve once per revision explanation",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Use a pure resolveShipmentRequirements(context) function. The context includes the current route leg and party, so a supplier transfer and a forwarder’s outbound shipment receive the correct tasks and addresses. The server checks fresh state before release.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "QJRdz",
                  "name": "Explicit requirements",
                  "width": "fill_container",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "uEZXE",
                      "name": "Explicit requirements label",
                      "fill": "#18181B",
                      "textGrowth": "fixed-width",
                      "width": 230,
                      "content": "Explicit requirements",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "g8PxD",
                      "name": "Explicit requirements explanation",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Return structured constraints, documents and tasks with stable codes, parameters, scope, responsible party, due stage, source profile and profile version. Keep requirement applicability separate from task completion; an already applied FNSKU label removes the apply-label task, not the product’s Amazon identifiers.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "z09Lt3",
                  "name": "Combine without weakening",
                  "width": "fill_container",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "Z0eB8x",
                      "name": "Combine without weakening label",
                      "fill": "#18181B",
                      "textGrowth": "fixed-width",
                      "width": 230,
                      "content": "Combine without weakening",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "vFwcY",
                      "name": "Combine without weakening explanation",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Confirmed booking facts replace suggested defaults. Transport cannot waive destination requirements. Combine compatible constraints; use the stricter comparable limit. Reject conflicting assignments or missing required inputs instead of silently choosing the last value.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Ctk95",
                  "name": "Shared checks and copy",
                  "width": "fill_container",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "nLasb",
                      "name": "Shared checks and copy label",
                      "fill": "#18181B",
                      "textGrowth": "fixed-width",
                      "width": 230,
                      "content": "Shared checks and copy",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "jH2hV",
                      "name": "Shared checks and copy explanation",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Reusable validators and localized messages use the same rule parameters and quantity basis. Count sellable units consistently, displaying packs for multipacks. Check size, weight, SKU mixing and same-quantity constraints independently. Group weight, dimensions and SKU quantities into one packing-list completion task.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "gn132",
                  "name": "Release and revision history",
                  "width": "fill_container",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "FRsX4",
                      "name": "Release and revision history label",
                      "fill": "#18181B",
                      "textGrowth": "fixed-width",
                      "width": 230,
                      "content": "Release and revision history",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "S0PtD",
                      "name": "Release and revision history explanation",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Drafts resolve current profiles. A released packet stores the effective requirement snapshot, profile versions, shipment and packing revisions, label assignments and generated files. Repacking creates a new revision. Do not silently regenerate an old packet with changed rules.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "wxJIa",
                  "name": "Extension boundary",
                  "width": "fill_container",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "zDxJV",
                      "name": "Extension boundary label",
                      "fill": "#18181B",
                      "textGrowth": "fixed-width",
                      "width": 230,
                      "content": "Extension boundary",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "N5atBM",
                      "name": "Extension boundary explanation",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A new combination uses existing profiles. A new limit changes profile data. A new kind of rule adds a typed rule, validator and wording in one place. Start with ordinary functions and typed configuration; no subclass per route, expression language or admin rule builder.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "pv5M9",
                  "name": "Verification and migration",
                  "width": "fill_container",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "Ew9CV",
                      "name": "Verification and migration label",
                      "fill": "#18181B",
                      "textGrowth": "fixed-width",
                      "width": 230,
                      "content": "Verification and migration",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "VErQS",
                      "name": "Verification and migration explanation",
                      "fill": "#52525B",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "First centralize existing validation and confirm its intended rules. Then connect task resolution, documents and release checks. Cover boundary values, multipacks, unknown transport, direct versus forwarder pickup, required versus already applied labels and repacking. Test that all consumers use the same effective requirements.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
