            {
              "type": "text",
              "id": "aHgoh",
              "name": "Packing behavior specification",
              "fill": "$rd-fg-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Editing counts packs; show pack size and total units below the input. Read-only quantities show units first, then packs. Supplier SKU has its own column. Hide products with nothing left to pack from Add products.",
              "lineHeight": 1.5,
              "fontFamily": "$rd-font",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "J4TTu",
              "name": "Completion behavior specification",
              "fill": "$rd-fg-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Finish packing saves the packing list on the shipment and enables its download. The PO supplier pack includes shipment documents. Booking and Amazon label generation remain separate actions.",
              "lineHeight": 1.5,
              "fontFamily": "$rd-font",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
