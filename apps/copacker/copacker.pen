            },
            {
              "type": "frame",
              "id": "kq21j",
              "name": "Rendering and release rules",
              "width": "fill_container",
              "fill": "#FFFFFF",
              "layout": "vertical",
              "gap": 12,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "Pctfo",
                  "name": "Rendering and release",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Rendering and release",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 18,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "wenA9",
                  "name": "Rendering contract",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Repeat structured rows and wrap long names and identifiers. Never build a prose list of products. Group only genuinely identical cartons, preserving each carton ID and label assignment. Keep a complete group on one page and repeat table headers after a page break.",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "ueZZ3",
                  "name": "Release contract",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Missing required data prevents a final packet. Optional data is omitted. A draft must identify unresolved values; it must not turn an unknown value into “none” or imply that pickup is booked.",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "B4uhjD",
                  "name": "Atomic checklist contract",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Use one checkbox for recording carton weight, dimensions and SKU quantities in the packing list. Keep SKU mixing, quantity limits, size limits, weight limits, product preparation and each label type as separate checks.",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "nPrbk",
              "name": "Carton label reference contract",
              "width": "fill_container",
              "height": 340,
              "fill": "#FFFFFF",
              "layout": "vertical",
              "gap": 12,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "Xplrm",
                  "name": "Carton label reference / shared mapping",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Carton label reference / shared mapping",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 18,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "c6bTx8",
                  "name": "Reference source",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Use the same carton ID → carton label ID → carrier label ID assignments as the packing list and label files. Keep full identifiers. Read actual provider IDs; never derive assignments from PDF page order.",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "uzxbA",
                  "name": "Reference conditions",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Show the carrier column when per-carton carrier labels are required. If explicitly not required, say so once above the table and omit that column. Unknown or missing required labels prevent final release.",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "UdYBI",
                  "name": "Reference pagination",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "One carton per row, even when the packing list groups identical cartons. Keep every row together; move it to the next page if it will not fit. Repeat the document heading, order and shipment reference, and table column headings on every page. Repacking creates a new sheet for the new carton revision.",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "JGoLk",
                  "name": "Document identity and downloads",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Every generated page repeats its PO, shipment reference, shipment revision and generation date. The date describes when the file was generated, not a new packing revision. Use purpose-first filenames: Packing list / Carton labels / Carrier labels / Pallet labels / Carton label reference, followed by PO, shipment reference and revision. Preserve provider label PDFs unchanged.",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "VDU8z",
              "name": "Localization and print fonts",
              "width": "fill_container",
              "height": 320,
              "fill": "#FFFFFF",
              "layout": "vertical",
              "gap": 12,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "y0TmC",
                  "name": "Rendering and release",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Localization and print fonts",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 18,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "gmEeh",
                  "name": "Rendering contract",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Use one template with translated message keys and values for headings, checklist rules and handoff instructions. Reuse the app’s locale catalogue and requirement codes; do not create a separate template for each language. Format dates, numbers and money for the selected locale without changing quantities, currency or measurement units.",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Ego4Q",
                  "name": "Release contract",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Preserve company and product names, SKUs, addresses, shipment IDs, label numbers and original provider PDFs. Custom Markdown instructions stay as authored unless an explicit translation is requested and reviewed; do not silently machine-translate operational instructions.",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "MXTzX",
                  "name": "Directionality and font contract",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Embed fonts with correct glyph coverage and shaping for Chinese, Hindi, Urdu and Arabic. Use a right-to-left layout for RTL locales: headings, alignment, reading order and table columns follow the language. Isolate SKUs, shipment/label IDs, dimensions and other machine identifiers left to right so punctuation and digits stay in order. Never mirror barcodes or original provider PDFs.",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Tbg2u",
                  "name": "Localized print acceptance",
                  "fill": "#18181B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Allow translations to expand without clipping. Keep complete carton rows together and repeat localized headers after page breaks. Verify long translations, CJK and mixed Arabic/Latin examples with numbers, units and identifiers; check visual order and extracted PDF text. Missing glyphs must not be replaced with blanks.",
                  "lineHeight": 1.35,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
