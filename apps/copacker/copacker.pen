          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "l8H1iO",
              "name": "Title",
              "fill": "$rd-fg",
              "content": "Compared with 01.09",
              "fontFamily": "$rd-font",
              "fontSize": 13,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "W4KPh",
              "name": "Point 1",
              "fill": "$rd-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Comments show the author's name, not “You”, and the time sits on the name line.",
              "lineHeight": 1.45,
              "fontFamily": "$rd-font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "tmDfr",
              "name": "Point 2",
              "fill": "$rd-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Another company's comment adds its name, for example “Mei Chen at Lotus Manufacturing”.",
              "lineHeight": 1.45,
              "fontFamily": "$rd-font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "FOnz1",
              "name": "Point 3",
              "fill": "$rd-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Events are one line. A revision opens to list its lines, with prices only for people who see prices. 01.09's cost rows, totals and invoice file aren't in the timeline.",
              "lineHeight": 1.45,
              "fontFamily": "$rd-font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "q9oR9h",
              "name": "Point 4",
              "fill": "$rd-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The message hint reads “Your team and the supplier can see this message.”",
              "lineHeight": 1.45,
              "fontFamily": "$rd-font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "mvoeF",
              "name": "Point 5",
              "fill": "$rd-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A supplier's box offers “Message customer”, and its shared comments read “Shared with customer”.",
              "lineHeight": 1.45,
              "fontFamily": "$rd-font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "oMyZr",
              "name": "Point 6",
              "fill": "$rd-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The timeline sits under the order with its own “Timeline” heading. It has no PO header or status.",
              "lineHeight": 1.45,
              "fontFamily": "$rd-font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "jY1Im",
              "name": "Point 7",
              "fill": "$rd-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "On phone the whole history shows. There's no “Show earlier activity” button.",
              "lineHeight": 1.45,
              "fontFamily": "$rd-font",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        }
      ]
