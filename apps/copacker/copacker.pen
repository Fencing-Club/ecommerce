                      "fill": "#18181B",
                      "textGrowth": "fixed-width",
                      "width": 230,
                      "content": "Same quantity",
                      "lineHeight": 1.35,
                      "fontFamily": "Inter",
                      "fontSize": 15,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "PdSU4",
                      "name": "Template copy",
                      "fill": "#18181B",
                      "textGrowth": "fixed-width",
                      "width": 670,
                      "content": "For each SKU, use the same number of {quantityUnit} in every carton.",
                      "lineHeight": 1.35,
