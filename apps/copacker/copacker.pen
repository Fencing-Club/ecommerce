            {
              "type": "text",
              "id": "z6IPN",
              "name": "Implementation notes heading",
              "fill": "$rd-fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Design notes",
              "lineHeight": 1.5,
              "fontFamily": "$rd-font",
              "fontSize": 16,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "L9NKi",
              "name": "Validation behavior",
              "fill": "$rd-fg-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Validate while editing and after imports. Keep drafts saved. Stack errors beneath each carton and mark the affected fields. Save draft remains available; Finish packing requires complete quantities and valid required fields. Check Amazon requirements during submission and show actionable failures without losing packing.",
              "lineHeight": 1.5,
              "fontFamily": "$rd-font",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "iSEY9",
              "name": "Rules scope",
              "fill": "$rd-fg-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Use the destination marketplace, FBA packing method, product eligibility and current Amazon shipment requirements. FBA individual-unit cartons may mix compatible SKUs; case packs may not. Do not apply the 150-unit case-pack cap to all FBA individual-unit cartons. Handle single oversize-item and category-specific exceptions separately. Use Amazon’s current packing options where available.",
              "lineHeight": 1.5,
              "fontFamily": "$rd-font",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "fIOnV",
              "name": "Counting rules",
              "fill": "$rd-fg-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Limits count Amazon sellable units. A six-piece retail pack sold as one listing is one sellable unit, not six. Validate SKU-to-listing mapping, quantities allocated to the shipment, positive whole counts, required measurements, duplicate carton IDs and consistent AWD templates. Use exact conversions: 50 lb = 22.6796185 kg; displayed 22.68 kg is rounded.",
              "lineHeight": 1.5,
              "fontFamily": "$rd-font",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "WZxnE",
              "name": "Source notes",
              "fill": "$rd-fg-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "US rules checked October 15, 2026. Standard carton examples: AWD 25 × 25 × 25 in and 50 lb; FBA 36 × 25 × 25 in and 50 lb. AWD and FBA case packs: 150 sellable units per carton. Recheck rules before implementation; product and carrier requirements can be stricter.",
              "lineHeight": 1.5,
              "fontFamily": "$rd-font",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "fpvlJ",
              "name": "FBA shipping and routing source",
              "fill": "$rd-fg-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "FBA shipping and routing: https://sellercentral.amazon.com/help/hub/reference/external/200141510?locale=en-EN",
              "lineHeight": 1.5,
              "fontFamily": "$rd-font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "CEkuK",
              "name": "FBA case-packed products source",
              "fill": "$rd-fg-muted",
              "textGrowth": "fixed-width",
