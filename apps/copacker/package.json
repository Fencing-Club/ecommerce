{
  "name": "copacker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --max-warnings=0",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "predeploy": "pnpm db:migrate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:drift": "node --env-file-if-exists=.env --import tsx scripts/schema-drift.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-dev.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/server/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/client-sqs": "^3.1136.0",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@mantine/hooks": "^9.6.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@repo/aisle": "workspace:*",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/sprinkles": "^1.7.1",
    "@workos-inc/authkit-nextjs": "^4.0.0",
    "@workos-inc/node": "^10.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "pdf-lib": "1.17.1",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.88.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.0",
    "ts-extras": "^1.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.9",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
