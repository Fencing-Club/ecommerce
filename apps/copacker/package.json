{
  "name": "copacker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ]
  },
  "scripts": {
    "dev": "dev-domains run app",
    "storybook": "dev-domains run stories",
    "build-storybook": "storybook build",
    "build": "next build",
    "lint": "oxlint --max-warnings=0",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node --use-system-ca --import tsx scripts/test-e2e.ts test",
    "update:address-regions": "tsx scripts/update-address-regions.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "predeploy": "pnpm db:migrate",
    "preview:deploy": "node --import tsx scripts/preview.ts deploy",
    "preview:remove": "node --import tsx scripts/preview.ts remove",
    "preview:sweep": "node --import tsx scripts/preview.ts sweep",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:drift": "node --env-file-if-exists=.env --import tsx scripts/schema-drift.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-dev.ts",
    "db:seed:e2e": "node --env-file-if-exists=.env --import tsx scripts/seed-e2e.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/server/worker.ts",
    "dev:setup": "dev-domains setup",
    "dev:urls": "dev-domains urls",
    "dev:status": "dev-domains status",
    "dev:doctor": "dev-domains doctor",
    "build:e2e": "node --import tsx scripts/dev.ts build-e2e",
    "worker:dev": "node --import tsx scripts/dev.ts worker"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "^3.1136.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/client-sqs": "^3.1136.0",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@mantine/hooks": "^9.6.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@repo/aisle": "workspace:*",
    "@repo/copacker-emails": "workspace:*",
    "@uploadcn/react": "0.1.1",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/sprinkles": "^1.7.1",
    "@workos-inc/authkit-nextjs": "^4.0.0",
    "@workos-inc/node": "^10.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "next-intl": "^4.14.5",
    "nuqs": "^2.10.1",
    "pdf-lib": "1.17.1",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-dropzone": "^20.1.2",
    "react-hook-form": "^7.88.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.0",
    "tiny-invariant": "^1.3.3",
    "ts-extras": "^1.3.0",
    "ts-pattern": "^5.9.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@buildkitgg/dev-domains": "0.1.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.9",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "1.63.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  }
}
