{
  "name": "copacker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ]
  },
  "scripts": {
    "dev": "dev-domains run app",
    "storybook": "dev-domains run stories",
    "build-storybook": "storybook build",
    "storybook:seal": "node --import tsx scripts/seal-storybook.ts",
    "build": "vite build --mode staging",
    "build:preview": "vite build --mode preview",
    "lint": "oxlint --max-warnings=0",
    "check:types": "pnpm typegen && tsc --noEmit && tsc --noEmit --project tsconfig.worker.json && tsc --noEmit --project tests/start-runtime/tsconfig.json",
    "typegen:start-runtime": "pnpm --dir tests/start-runtime exec cf workers types",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node --use-system-ca --import tsx scripts/test-e2e.ts test",
    "test:start-runtime": "node --import tsx scripts/test-start-runtime.ts",
    "test:worker-webhooks": "node --import tsx scripts/test-worker-webhooks.ts",
    "test:worker-jobs": "node --import tsx scripts/test-worker-jobs.ts",
    "test:start-auth": "node --import tsx scripts/test-start-auth.ts",
    "update:address-regions": "tsx scripts/update-address-regions.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:drift": "node --env-file-if-exists=.env --import tsx scripts/schema-drift.ts",
    "analytics:audit:amazon": "node --import tsx scripts/audit-amazon-finances.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-dev.ts",
    "db:seed:e2e": "node --env-file-if-exists=.env --import tsx scripts/seed-e2e.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/server/worker.ts",
    "dev:setup": "dev-domains setup",
    "dev:urls": "dev-domains urls",
    "dev:status": "dev-domains status",
    "build:e2e": "node --import tsx scripts/dev.ts build-e2e",
    "worker:dev": "node --import tsx scripts/dev.ts worker",
    "typegen": "node --import tsx scripts/generate-routes.ts && cf workers types && pnpm typegen:start-runtime",
    "release": "node --import tsx scripts/release.ts",
    "build:stories-release": "node --import tsx scripts/build-stories-release.ts",
    "storage:transfer": "node --import tsx scripts/storage-transfer.ts",
    "infra:tags": "node --import tsx scripts/terraform-tags.ts",
    "infra:operate": "node --import tsx scripts/terraform-runner.ts",
    "dev:doctor": "dev-domains doctor",
    "preview:deploy": "node --import tsx scripts/preview.ts deploy",
    "preview:remove": "node --import tsx scripts/preview.ts remove",
    "preview:discover": "node --import tsx scripts/preview.ts discover",
    "export:shipment-packet": "node --import tsx scripts/export-shipment-packet.ts",
    "carrier-label-examples": "node --import tsx scripts/carrier-label-examples.ts"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@hookform/resolvers": "^5.9.2",
    "@mantine/hooks": "^9.7.3",
    "@react-pdf/renderer": "^4.9.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@repo/copacker-marketplaces": "workspace:*",
    "@repo/copacker-shipments": "workspace:*",
    "@repo/copacker-emails": "workspace:*",
    "@repo/copacker-packing-rules": "workspace:*",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tesseract.js-data/eng": "1.0.0",
    "@uploadcn/react": "0.1.3",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/sprinkles": "^1.7.1",
    "@workos-inc/node": "^11.0.0",
    "@workos/authkit-session": "0.7.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "1.59.0",
    "nuqs": "^2.10.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.0",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "three": "^0.186.1",
    "tiny-invariant": "^1.3.3",
    "ts-extras": "^1.3.0",
    "ts-pattern": "^5.9.2",
    "ts-tracking-number": "^1.0.17",
    "tw-animate-css": "^1.4.0",
    "use-intl": "4.14.9",
    "zod": "^4.6.7",
    "zxing-wasm": "3.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.7",
    "@buildkitgg/dev-domains": "0.1.0",
    "@cloudflare/vite-plugin": "1.64.0",
    "@electric-sql/pglite": "^0.5.10",
    "@napi-rs/canvas": "1.0.11",
    "@playwright/test": "^1.64.1",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/router-generator": "1.167.45",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "cf": "1.0.0-beta.17",
    "drizzle-kit": "^0.31.11",
    "miniflare": "5.20261012.0-beta",
    "msw": "^3.0.3",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "1.64.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
