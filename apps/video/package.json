{
  "name": "video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio --port=3100",
    "voices": "node --env-file-if-exists=.env scripts/elevenlabs.ts voices",
    "audition": "node --env-file-if-exists=.env scripts/elevenlabs.ts audition",
    "record": "node --env-file-if-exists=.env scripts/elevenlabs.ts record",
    "check:takes": "node --env-file-if-exists=.env scripts/elevenlabs.ts check",
    "audio": "node scripts/score.ts && node scripts/sfx.ts && remotion render Voiceover public/audio/voiceover.wav --codec=wav --log=error",
    "subtitles": "node scripts/subtitles.ts",
    "lint": "vp lint --max-warnings=0",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "typescript": "catalog:",
    "zod": "4.6.7"
  }
}
