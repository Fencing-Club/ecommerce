{
  "name": "video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio --port=3100",
    "voices": "node --env-file-if-exists=.env scripts/elevenlabs.ts voices",
    "audition": "node --env-file-if-exists=.env scripts/elevenlabs.ts audition",
    "record": "node --env-file-if-exists=.env scripts/elevenlabs.ts record",
    "audio": "node scripts/score.ts && node scripts/sfx.ts",
    "lint": "oxlint --max-warnings=0",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.526",
    "@remotion/google-fonts": "4.0.526",
    "@remotion/noise": "4.0.526",
    "lucide-react": "1.31.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "typescript": "catalog:",
    "zod": "4.5.4"
  }
}
