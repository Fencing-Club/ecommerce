// Deployed with `pnpm dlx wrangler deploy` from this folder; see docs/README.md.
{
  // The ecommerce monorepo's Turborepo remote cache.
  "name": "ecommerce-turbo-cache",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "turbo.copacker.ai", "custom_domain": true }],
  // Turbo's signed task outputs, kept 30 days.
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "ecommerce-turbo-cache" }]
}
