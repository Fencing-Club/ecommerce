{
  "$schema": "https://turborepo.dev/schema.json",
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "env": [
        "APP_URL",
        "APP_COMMIT_SHA",
        "CLOUDFLARE_HYPERDRIVE_ID",
        "CLOUDFLARE_DOCUMENTS_BUCKET",
        "CLOUDFLARE_DOMAINS",
        "VITE_GOOGLE_MAPS_API_KEY"
      ],
      "dependsOn": ["^build", "^transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".cloudflare/output/**"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check:types": {
      "dependsOn": ["^check:types"]
    },
    "check:unused": {
      "dependsOn": ["^check:unused"]
    },
    "test": {
      "dependsOn": ["^transit"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^transit"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
