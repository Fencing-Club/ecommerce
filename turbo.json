{
  "$schema": "https://turborepo.dev/schema.json",
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "env": [
        "APP_URL",
        "APP_COMMIT_SHA",
        "CLOUDFLARE_HYPERDRIVE_ID",
        "CLOUDFLARE_DOCUMENTS_BUCKET",
        "CLOUDFLARE_DOMAINS",
        "VITE_GOOGLE_MAPS_API_KEY"
      ],
      "dependsOn": ["^build", "^transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".cloudflare/output/**"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "build:preview": {
      "env": [
        "APP_URL",
        "APP_COMMIT_SHA",
        "PR_NUMBER",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_HYPERDRIVE_ID",
        "CLOUDFLARE_DOCUMENTS_BUCKET",
        "WORKOS_*",
        "TOKEN_ENCRYPTION_KEY",
        "VITE_*"
      ],
      "dependsOn": ["^build", "^transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".cloudflare/output/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vite.config.ts",
        "$TURBO_ROOT$/packages/oxlint-config/base.json",
        "!**/*.pen",
        "!**/*.md",
        "!docs/**"
      ]
    },
    "check:types": {
      "dependsOn": ["^check:types"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.pen", "!**/*.md", "!docs/**"]
    },
    "check:unused": {
      "dependsOn": ["^check:unused"]
    },
    "test": {
      "dependsOn": ["^transit"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.pen", "!**/*.md", "!docs/**"]
    },
    "test:coverage": {
      "dependsOn": ["^transit"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.pen", "!**/*.md", "!docs/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
