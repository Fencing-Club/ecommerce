{
  "private": true,
  "name": "ecommerce",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=copacker",
    "verify": "run-s check:format check:lint check:types check:unused test:changed",
    "verify:ci": "run-s check:format check:lint check:types check:unused test:coverage",
    "check": "run-p check:format check:lint check:types check:unused",
    "check:change": "beachball check",
    "check:format": "vp fmt --check",
    "check:lint": "turbo run lint",
    "check:types": "turbo run check:types",
    "check:unused": "knip",
    "test": "turbo run test",
    "test:changed": "turbo run test --filter=...[origin/main] --filter=!copacker && pnpm --filter copacker test:changed",
    "test:coverage": "turbo run test:coverage",
    "change": "beachball change",
    "change:release": "beachball publish",
    "prepare": "vp config --no-agent",
    "guidance:sync": "playbook-sync",
    "guidance:check": "playbook-sync --check",
    "guidance:update": "pnpm update @betterapps/playbook --latest && playbook-sync",
    "skills:add": "skills add",
    "skills:update": "skills update -p",
    "skills:remove": "skills remove",
    "skills:check": "skills check"
  },
  "devDependencies": {
    "@betterapps/playbook": "github:betterapps-hq/playbook",
    "@repo/oxlint-config": "workspace:*",
    "beachball": "^2.65.5",
    "knip": "^6.45.1",
    "npm-run-all2": "^9.0.4",
    "rulesync": "43.9.0",
    "skills": "1.9.0",
    "turbo": "2.11.11",
    "vite-plus": "^1.7.0"
  },
  "packageManager": "pnpm@12.10.1"
}
