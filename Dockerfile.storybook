FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libatomic1 && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@12.10.1
COPY . .
ENV LEFTHOOK=0
RUN npm pkg delete scripts.prepare && pnpm install --frozen-lockfile --registry=https://registry.npmjs.org/
ARG APP_COMMIT_SHA=unknown
# Storybook uses fixtures and MSW. Do not supply application credentials or browser API keys.
RUN pnpm --filter copacker build-storybook && \
    node -e "require('fs').writeFileSync('apps/copacker/storybook-static/health.json', JSON.stringify({status:'ok',service:'copacker-stories',commit:process.env.APP_COMMIT_SHA}))"

FROM nginxinc/nginx-unprivileged:stable-alpine
COPY apps/copacker/storybook.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/copacker/storybook-static /usr/share/nginx/html
EXPOSE 8080
