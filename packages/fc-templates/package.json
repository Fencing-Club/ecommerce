{
  "name": "@repo/fc-templates",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "shopify-emails build --dir src/emails --out dist && node --import tsx src/emails/signatures/build.mts",
    "build:signatures": "node --import tsx src/emails/signatures/build.mts",
    "cli": "shopify-emails",
    "dev": "shopify-emails preview --dir src/emails",
    "check:types": "tsc --noEmit",
    "check:unused": "knip --directory ../.. --workspace packages/fc-templates",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@repo/shopify-emails": "workspace:*",
    "react": "^19.3.1",
    "react-email": "^6.11.3"
  },
  "devDependencies": {
    "@react-email/render": "^2.1.1",
    "@react-email/ui": "6.11.3",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  }
}
