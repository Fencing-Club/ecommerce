    {
      "type": "frame",
      "id": "q3y1tO",
      "x": 0,
      "y": 48374,
      "name": "Library / Cart interaction states",
      "context": "Reusable cart feedback states, shared by full page and flyout. All scenarios use illustrative merchandise and promotions. Static design specifications, not runtime interactions.",
      "width": 1800,
      "fill": "$muted",
      "layout": "vertical",
      "gap": 24,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "R9fIH3",
          "name": "Interaction library title",
          "fill": "$foreground",
          "content": "Cart interaction states",
          "fontFamily": "$font-display",
          "fontSize": 32,
          "fontWeight": "600"
        },
        {
          "type": "frame",
          "id": "AZFFM",
          "name": "Empty and message components",
          "width": "fill_container",
          "gap": 32,
          "children": [
            {
              "type": "frame",
              "id": "LctLY",
              "name": "Component/Cart empty state",
              "context": "Shown only after a successful cart response with zero paid items and no eligible gift lines. Never substitute this state for load failure. Hide rewards, discount/note inputs and totals; keep close or navigation available. No Check out action.",
              "reusable": true,
              "width": 560,
              "fill": "$background",
              "layout": "vertical",
              "gap": 20,
              "padding": [
                40,
                24
              ],
              "alignItems": "center",
