                          "name": "Policy list text 13",
                          "fill": "$foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Order information including your name, billing address, shipping address, payment confirmation, email address, and phone number.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
