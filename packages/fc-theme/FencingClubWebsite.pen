                        {
                          "type": "text",
                          "id": "I42qw",
                          "name": "Policy list text 62",
                          "fill": "$foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Right to Correct: You may have a right to request that we correct inaccurate personal information we maintain about you.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "Qpm7e",
                      "name": "Policy list item 63",
                      "width": "fill_container",
                      "gap": 12,
                      "children": [
                        {
                          "type": "text",
                          "id": "ZdKRc",
                          "name": "List marker 63",
                          "fill": "$foreground",
