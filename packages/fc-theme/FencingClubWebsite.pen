                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "E991E",
                          "name": "Text",
                          "fill": "$foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Pick the lightest blade you can control cleanly, not the heaviest you can lift.",
                          "lineHeight": 1.7,
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        }
