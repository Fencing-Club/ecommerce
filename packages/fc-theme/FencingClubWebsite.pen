                {
                  "type": "frame",
                  "id": "uWbqN",
                  "name": "Policy article",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "ZGUVD",
                      "name": "Policy paragraph 0",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$foreground",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Last updated: July 8, 2026",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "WYNRn",
                      "name": "Policy paragraph 1",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$foreground",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "This Privacy Policy describes how Fencing Club (the \"Site\", \"we\", \"us\", or \"our\") collects, uses, and discloses your personal information when you visit, use our services, or make a purchase from fencing.club (the \"Site\") or otherwise communicate with us regarding the Site (collectively, the \"Services\"). For purposes of this Privacy Policy, \"you\" and \"your\" means you as the user of the Services, whether you are a customer, website visitor, or another individual whose information we have collected pursuant to this Privacy Policy.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "mpBvF",
                      "name": "Policy paragraph 2",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$foreground",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Please read this Privacy Policy carefully.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "DEY8A",
                      "name": "Policy heading spacing 3",
                      "width": "fill_container",
                      "layout": "vertical",
                      "padding": [
                        16,
                        0,
                        0,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "JnvRL",
                          "name": "Policy H2 3",
                          "context": "Published H2. Anchor policy-block-3",
                          "fill": "$foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Changes to This Privacy Policy",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-display",
                          "fontSize": 22,
                          "fontWeight": "600"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "ueQlP",
                      "name": "Policy paragraph 4",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$foreground",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "We may update this Privacy Policy from time to time, including to reflect changes to our practices or for other operational, legal, or regulatory reasons. We will post the revised Privacy Policy on the Site, update the \"Last updated\" date and take any other steps required by applicable law.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "des7l",
                      "name": "Policy heading spacing 5",
                      "width": "fill_container",
                      "layout": "vertical",
                      "padding": [
                        16,
                        0,
                        0,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "WeegK",
                          "name": "Policy H2 5",
                          "context": "Published H2. Anchor policy-block-5",
                          "fill": "$foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "How We Collect and Use Your Personal Information",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-display",
                          "fontSize": 22,
                          "fontWeight": "600"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "D4huu",
                      "name": "Policy paragraph 6",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$foreground",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "To provide the Services, we collect and have collected over the past 12 months personal information about you from a variety of sources, as set out below. The information that we collect and use varies depending on how you interact with us.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "nfkxS",
                      "name": "Policy paragraph 7",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$foreground",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "In addition to the specific uses set out below, we may use information we collect about you to communicate with you, provide or improve or improve the Services, comply with any applicable legal obligations, enforce any applicable terms of service, and to protect or defend the Services, our rights, and the rights of our users or others.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "Th73E",
                      "name": "Policy heading spacing 8",
                      "width": "fill_container",
                      "layout": "vertical",
                      "padding": [
                        16,
                        0,
                        0,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "h0EyT",
                          "name": "Policy H3 8",
                          "context": "Published H3. Anchor policy-block-8",
                          "fill": "$foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "What Personal Information We Collect",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-display",
                          "fontSize": 18,
                          "fontWeight": "600"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "cHVUh",
                      "name": "Policy paragraph 9",
                      "context": "Published Privacy Policy paragraph; retain wording and source anchors. Capture date 2026-09-06.",
                      "fill": "$foreground",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The types of personal information we obtain about you depends on how you interact with our Site and use our Services. When we use the term \"personal information\", we are referring to information that identifies, relates to, describes or can be associated with you. The following sections describe the categories and specific types of personal information we collect.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "C9qOFF",
                      "name": "Policy heading spacing 10",
                      "width": "fill_container",
                      "layout": "vertical",
                      "padding": [
                        16,
                        0,
                        0,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "EgYjA",
                          "name": "Policy H3 10",
                          "context": "Published H3. Anchor policy-block-10",
                          "fill": "$foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Information We Collect Directly from You",
