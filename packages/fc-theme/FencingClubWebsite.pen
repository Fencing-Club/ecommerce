              "name": "Fit guidance text",
              "fill": "$muted-foreground",
              "textGrowth": "fixed-width",
              "width": 800,
              "content": "For a close, athletic fit, choose the size that matches your measurements. Choose one size larger for extra shoulder room or a looser layer underneath.",
