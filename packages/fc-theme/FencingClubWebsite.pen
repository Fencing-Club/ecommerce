                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "lVu76",
                          "name": "Policy list text 12",
                          "fill": "$foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Contact details including your name, address, phone number, and email.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "d9plQ4",
                      "name": "Policy list item 13",
                      "width": "fill_container",
                      "gap": 12,
