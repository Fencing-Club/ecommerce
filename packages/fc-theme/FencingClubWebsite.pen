      "children": [
        {
          "type": "frame",
          "id": "sVeH6",
          "x": 0,
          "y": 0,
          "name": "Scrollable policy content",
          "context": "Full published Privacy Policy from https://fencing.club/policies/privacy-policy, captured 2026-09-06. Last updated July 8, 2026 as published. Preserve legal wording, lists, tables, and inline links; no legal rewrite. Source links: Shopify cookies https://www.shopify.com/legal/cookies; GPC https://globalprivacycontrol.org/; supervisory authorities https://edpb.europa.eu/about-edpb/about-edpb/members; Shopify Privacy Policy and Consumer Privacy Policy as original anchors.",
          "clip": true,
          "width": 1440,
          "fill": "$background",
          "layout": "vertical",
