                          "name": "Policy list item 67",
                          "width": "fill_container",
                          "gap": 12,
                          "children": [
                            {
                              "type": "text",
                              "id": "QeHDU",
                              "name": "List marker 67",
                              "fill": "$foreground",
                              "content": "-",
                              "fontFamily": "$font-body",
                              "fontSize": 16,
