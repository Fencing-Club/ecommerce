                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "hXuGq",
                      "name": "Policy list item 67",
                      "width": "fill_container",
                      "gap": 12,
                      "children": [
                        {
                          "type": "text",
                          "id": "utCOx",
                          "name": "List marker 67",
