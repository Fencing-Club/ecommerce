<script src="{{ 'fc-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign slide_label = 'sections.announcement_bar.slide_label' | t: index: '[index]', count: '[count]'
-%}
<fc-carousel
  class="announcement-bar"
  data-carousel="fade"
  data-slide-label="{{ slide_label | escape }}"
  role="region"
  aria-roledescription="{{ 'sections.announcement_bar.carousel' | t }}"
  aria-label="{{ 'sections.announcement_bar.label' | t }}"
  {% if section.settings.autoplay and section.blocks.size > 1 %}
    data-autoplay="{{ section.settings.autoplay_speed | times: 1000 }}"
  {% endif %}
>
  <div class="announcement-bar__track" data-carousel-track>{%- content_for 'blocks' -%}</div>
  {%- if section.blocks.size > 1 -%}
    {%- assign previous_label = 'sections.announcement_bar.previous' | t -%}
    {%- assign next_label = 'sections.announcement_bar.next' | t -%}
    {%- render 'ui-button',
      aria_label: previous_label,
      variant: 'icon',
      icon: 'chevron-left',
      class: 'announcement-bar__control announcement-bar__control--previous',
      additional_props: 'data-carousel-prev'
    -%}
    {%- render 'ui-button',
      aria_label: next_label,
      variant: 'icon',
      icon: 'chevron-right',
      class: 'announcement-bar__control announcement-bar__control--next',
      additional_props: 'data-carousel-next'
    -%}
  {%- endif -%}
</fc-carousel>

{% stylesheet %}
  .announcement-bar {
    position: relative;
    display: block;
    background: var(--primary);
  }
  /* Every announcement sits in the same cell, so the bar is as tall as the tallest and they fade in place. */
  .announcement-bar__track {
    display: grid;
  }
  /* Each announcement stretches to the cell, so a shorter one still paints the bar's full height in its tone. */
  .announcement-bar__track > * {
    display: flex;
    grid-area: 1 / 1;
  }
  /* Room for the arrows on either side of the message. */
  .announcement-bar:has(.announcement-bar__control) .ui-banner {
    padding-inline: calc(var(--page-gutter) + var(--spacing-10));
  }
  .announcement-bar__control {
    --foreground: var(--primary-foreground);
    --muted-foreground: var(--primary-foreground);
    --accent:color-mix(in srgb, var(--primary-foreground) 12%, transparent);
    --accent-foreground: var(--primary-foreground);
    position: absolute;
    top: 50%;
    z-index: 1;
    translate: 0 -50%;
  }
  /* The arrow's icon lines up with the page gutter. */
  .announcement-bar__control--previous {
    left: calc(var(--page-gutter) - var(--spacing-2-5));
  }
  .announcement-bar__control--next {
    right: calc(var(--page-gutter) - var(--spacing-2-5));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 12,
  "blocks": [{ "type": "_announcement" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.announcement_bar.settings.autoplay.label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:sections.announcement_bar.settings.autoplay_speed.label",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name",
      "blocks": [{ "type": "_announcement" }]
    }
  ]
}
{% endschema %}
