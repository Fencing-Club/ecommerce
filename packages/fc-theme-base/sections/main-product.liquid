{%- comment -%}
  The product page's top: the photos beside the buy box. The buy box has the brand, name and rating, then the price
  and the options inside `product-options`, which reloads this section for each variant so price, stock and the
  buttons come from Liquid. Size starts unpicked, so nobody adds a size they didn't choose. Under the buttons sit app
  blocks, such as a back-in-stock form, then one-line trust notes led by the ships row, then the description. The
  sticky buy bar, the size chart drawer and the photo viewer belong to the section too. `<product-page>`
  (`assets/product-page.js`) runs the viewer, the bar, Size guide and the ships line.
{%- endcomment -%}
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'photo-gallery.js' | asset_url }}" type="module"></script>
<script src="{{ 'product-options.js' | asset_url }}" type="module"></script>
<script src="{{ 'product-page.js' | asset_url }}" type="module"></script>
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign viewer_id = 'PhotoViewer-' | append: section.id
  assign size_chart_id = 'SizeChart-' | append: section.id

  capture size_unpicked_text
    render 'product-size-unpicked', product: product
  endcapture
  assign size_unpicked = false
  if size_unpicked_text contains 'true'
    assign size_unpicked = true
  endif

  assign size_chart = product.metafields.custom.size_chart.value
  capture size_chart_ready
    render 'size-chart-validity', chart: size_chart
  endcapture
  assign size_guide_url = ''
  assign size_guide_dialog = ''
  if size_chart_ready contains 'true'
    assign size_guide_url = size_chart.system.url
    assign size_guide_dialog = size_chart_id
  endif

  # The choice in words for the buy bar, such as Right-handed, size 46, in the pickers' order: color, hand, the rest.
  # The size also goes in the stock line.
  assign selection = ''
  assign chosen_size = ''
  unless product.has_only_default_variant
    for pass in (1..3)
      for option in product.options_with_values
        assign option_handle = option.name | handle
        assign group = 3
        if option_handle contains 'color' or option_handle contains 'colour'
          assign group = 1
        elsif option_handle contains 'hand'
          assign group = 2
        endif
        if group != pass
          continue
        endif
        assign value = current.options[forloop.index0]
        assign part = value | escape
        if option_handle contains 'size'
          if size_unpicked
            continue
          endif
          assign chosen_size = value
          assign part = 'products.product.selected_size' | t: size: value
        elsif group == 2
          assign value_handle = value | handle
          if value_handle == 'right' or value_handle == 'left'
            assign part = 'products.option.handed' | t: side: value
          endif
        endif
        if selection != blank
          assign selection = selection | append: ', '
        endif
        assign selection = selection | append: part
      endfor
    endfor
  endunless

  assign subtitle = product.metafields.custom.subtitle.value
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
-%}
<product-page class="product-page page-width">
  <div class="product-page__grid">
    <div class="product-page__gallery">
      {%- render 'product-gallery', product: product, viewer_id: viewer_id -%}
    </div>

    <div class="product-page__buy">
      <div class="product-page__head">
        {%- capture brand_url -%}{%- render 'brand-url', vendor: product.vendor -%}{%- endcapture -%}
        <a class="product-page__brand" href="{{ brand_url | strip }}">
          {{- 'products.product.shop_all' | t: brand: product.vendor -}}
        </a>
        <h1 class="product-page__title">{{ product.title | escape }}</h1>
        {%- if subtitle != blank -%}
          <p class="product-page__subtitle">{{ subtitle | escape }}</p>
        {%- endif -%}
        {%- if rating != blank -%}
          {%- render 'ui-rating', rating: rating.rating, max: rating.scale_max, count: rating_count, size: 'md' -%}
        {%- endif -%}
      </div>

      <product-options class="product-page__options" data-section="{{ section.id }}" data-url="{{ product.url }}" data-update-url>
        <div class="product-page__price">
          {%- render 'ui-price', price: current.price, compare_at_price: current.compare_at_price, size: 'lg' -%}
          {%- assign installments_id = 'ProductInstallments-' | append: section.id -%}
          {%- form 'product', product, id: installments_id, class: 'product-page__installments' -%}
            <input type="hidden" name="id" value="{{ current.id }}">
            {{ form | payment_terms }}
          {%- endform -%}
        </div>

        <hr class="product-page__rule">

        {%- unless product.has_only_default_variant -%}
          <div class="product-page__pickers">
            {%- render 'product-option-pickers',
              product: product,
              id_prefix: section.id,
              form_id: form_id,
              size_unpicked: size_unpicked,
              size_guide_url: size_guide_url,
              size_guide_dialog: size_guide_dialog
            -%}
            <p class="product-page__option-error" data-option-error hidden></p>
          </div>
        {%- endunless -%}

        {%- render 'product-stock-line', variant: current, detailed: true, size: chosen_size -%}

        <product-form class="product-page__actions" data-section-id="{{ section.id }}">
          {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input
              type="hidden"
              name="id"
              value="{% unless size_unpicked %}{{ current.id }}{% endunless %}"
              class="product-variant-id"
              data-choose-message="{{ 'products.quick_view.choose_first' | t: option: 'size' | escape }}"
            >
            <div class="product-page__add-row" data-product-add-row>
              {%- liquid
                assign quantity_id = 'Quantity-' | append: section.id
                assign sold_out = false
                unless current.available or size_unpicked
                  assign sold_out = true
                endunless
              -%}
              {%- render 'ui-quantity-stepper',
                id: quantity_id,
                name: 'quantity',
                product_title: product.title,
                form_id: form_id,
                disabled: sold_out
              -%}
              {%- liquid
                assign add_label = 'products.product.add_to_cart' | t
                assign add_props = 'name="add"'
                unless current.available or size_unpicked
                  assign add_label = 'products.product.sold_out' | t
                  assign add_props = 'name="add" aria-disabled="true"'
                endunless
              -%}
              {%- render 'ui-button',
                label: add_label,
                type: 'submit',
                variant: 'primary',
                size: 'lg',
                spinner: true,
                class: 'product-page__add',
                additional_props: add_props
              -%}
            </div>
            {%- if current.available and size_unpicked == false -%}
              <div class="product-page__express">{{ form | payment_button }}</div>
            {%- endif -%}
          {%- endform -%}
          <p class="product-page__error product-form__error-message-wrapper" role="alert" hidden>
            {%- render 'ui-icon', icon: 'circle-alert', size: 16 -%}
            <span class="product-form__error-message"></span>
          </p>
        </product-form>

        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="product-page__app">{% render block %}</div>
          {%- endif -%}
        {%- endfor -%}

        <ul class="product-page__trust list-unstyled">
          {%- render 'product-ships-line', variant: current, dispatch: section.settings -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust' -%}
              <li class="product-page__trust-item" {{ block.shopify_attributes }}>
                {%- render 'ui-icon', icon: block.settings.icon, size: 16 -%}
                <span class="product-page__trust-text">
                  <span class="product-page__trust-title">{{ block.settings.title | escape }}</span>
                  {% if block.settings.detail != blank %}<span class="product-page__trust-detail">{{ block.settings.detail | escape }}</span>{% endif %}
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- render 'product-sticky-bar', product: product, variant: current, form_id: form_id, selection: selection, unpicked: size_unpicked -%}

        <script type="application/json" data-product-variants>
          [
            {%- for variant in product.variants -%}
              {"id":{{ variant.id }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"media":{{ variant.featured_media.id | json }}}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        </script>
      </product-options>

      {%- if product.description != blank -%}
        <div class="product-page__description rte">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- render 'product-photo-viewer', product: product, id: viewer_id -%}
  {%- render 'size-chart-flyout', product: product, id: size_chart_id -%}
</product-page>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section main-product-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-product.settings.dispatch.content"
    },
    {
      "type": "range",
      "id": "cutoff_hour",
      "min": 8,
      "max": 20,
      "step": 1,
      "default": 14,
      "label": "t:sections.main-product.settings.cutoff_hour.label",
      "info": "t:sections.main-product.settings.cutoff_hour.info"
    },
    {
      "type": "range",
      "id": "transit_min",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2,
      "label": "t:sections.main-product.settings.transit_min.label"
    },
    {
      "type": "range",
      "id": "transit_max",
      "min": 1,
      "max": 15,
      "step": 1,
      "default": 5,
      "label": "t:sections.main-product.settings.transit_max.label",
      "info": "t:sections.main-product.settings.transit_max.info"
    },
    {
      "type": "range",
      "id": "partner_min",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1,
      "label": "t:sections.main-product.settings.partner_min.label"
    },
    {
      "type": "range",
      "id": "partner_max",
      "min": 1,
      "max": 15,
      "step": 1,
      "default": 2,
      "label": "t:sections.main-product.settings.partner_max.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "trust",
      "name": "t:sections.main-product.blocks.trust.name",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.main-product.blocks.trust.settings.icon.label",
          "default": "rotate-ccw",
          "options": [
            { "value": "rotate-ccw", "label": "t:sections.main-product.blocks.trust.settings.icon.options__1.label" },
            { "value": "badge-check", "label": "t:sections.main-product.blocks.trust.settings.icon.options__2.label" },
            { "value": "message-circle", "label": "t:sections.main-product.blocks.trust.settings.icon.options__3.label" },
            { "value": "truck", "label": "t:sections.main-product.blocks.trust.settings.icon.options__4.label" },
            { "value": "shield-check", "label": "t:sections.main-product.blocks.trust.settings.icon.options__5.label" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.main-product.blocks.trust.settings.title.label",
          "default": "Free returns"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "t:sections.main-product.blocks.trust.settings.detail.label",
          "default": "30 days in the US"
        }
      ]
    }
  ]
}
{% endschema %}
