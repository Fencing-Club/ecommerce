{{ 'section-about.css' | asset_url | stylesheet_tag }}

<div class="about-section about-clubs">
  {%- content_for 'block', type: 'group', id: 'header' -%}
  <div class="about-clubs__grid">{%- content_for 'blocks' -%}</div>
  {%- content_for 'block', type: '_clubs-callout', id: 'callout' -%}
</div>

{% schema %}
{
  "name": "t:sections.about_clubs.name",
  "tag": "section",
  "blocks": [{ "type": "_club" }],
  "presets": [
    {
      "name": "t:sections.about_clubs.name",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": { "direction": "column", "gap": "md" },
          "blocks": [
            { "type": "text", "settings": { "text": "<p>USA Fencing Region 1</p>", "style": "eyebrow" } },
            { "type": "heading", "settings": { "heading": "The clubs we call home", "size": "lg" } },
            { "type": "text", "settings": { "text": "<p>Our team trains at these clubs most weeks.</p>", "style": "lead" } }
          ]
        },
        { "type": "_clubs-callout", "id": "callout", "static": true },
        { "type": "_club", "settings": { "discipline": "Épée", "name": "Club name", "location": "City, State" } },
        { "type": "_club", "settings": { "discipline": "Foil", "name": "Club name", "location": "City, State" } }
      ]
    }
  ]
}
{% endschema %}
