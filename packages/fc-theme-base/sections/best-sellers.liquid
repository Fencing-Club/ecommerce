{{ 'section-home.css' | asset_url | stylesheet_tag }}

<div class="home-section">
  {%- content_for 'block', type: 'group', id: 'header' -%}
  <div class="home-grid home-grid--4">{%- content_for 'blocks' -%}</div>
</div>

{% schema %}
{
  "name": "t:sections.best_sellers.name",
  "tag": "section",
  "blocks": [{ "type": "product-card" }],
  "presets": [
    {
      "name": "t:sections.best_sellers.name",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": { "direction": "row", "gap": "lg", "align": "end", "justify": "between" },
          "blocks": [
            {
              "type": "group",
              "settings": { "direction": "column", "gap": "sm", "align": "start" },
              "blocks": [
                { "type": "text", "settings": { "text": "<p>Featured products</p>", "style": "eyebrow" } },
                { "type": "heading", "settings": { "heading": "Best sellers", "size": "xl" } }
              ]
            },
            { "type": "link", "settings": { "label": "View all", "link": "shopify://collections/all" } }
          ]
        },
        { "type": "product-card" },
        { "type": "product-card" },
        { "type": "product-card" },
        { "type": "product-card" }
      ]
    }
  ]
}
{% endschema %}
