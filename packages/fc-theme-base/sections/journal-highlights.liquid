{{ 'section-home.css' | asset_url | stylesheet_tag }}

{%- assign blog = blogs[section.settings.blog] -%}
{%- if blog != blank and blog.articles_count > 0 -%}
  <div class="home-section">
    {%- content_for 'block', type: 'group', id: 'header' -%}
    <div class="home-grid">
      {%- for article in blog.articles limit: 3 -%}
        {%- render 'ui-article-card', article: article, read_label: section.settings.read_label, heading_level: 3 -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.journal_highlights.name",
  "tag": "section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.journal_highlights.settings.blog.label"
    },
    {
      "type": "text",
      "id": "read_label",
      "label": "t:sections.journal_highlights.settings.read_label.label",
      "default": "t:sections.journal_highlights.settings.read_label.default"
    }
  ],
  "presets": [
    {
      "name": "t:sections.journal_highlights.name",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": { "direction": "row", "gap": "lg", "align": "end", "justify": "between" },
          "blocks": [
            {
              "type": "group",
              "settings": { "direction": "column", "gap": "md", "align": "start" },
              "blocks": [
                { "type": "text", "settings": { "text": "<p>The journal</p>", "style": "eyebrow" } },
                { "type": "heading", "settings": { "heading": "From the journal", "size": "xl" } }
              ]
            },
            { "type": "link", "settings": { "label": "View all posts" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
