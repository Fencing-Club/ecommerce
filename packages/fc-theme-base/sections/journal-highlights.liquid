{%- comment -%}
  Three Journal posts under a heading: the chosen blog's latest, or on a product page the articles the product links in
  `custom.articles`. With no posts to show, the section is left out.
{%- endcomment -%}
{{ 'section-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.source == 'product'
    assign posts = product.metafields.custom.articles.value
  else
    assign posts = blogs[section.settings.blog].articles
  endif
-%}
{%- if posts.size > 0 -%}
  <div class="home-section">
    {%- content_for 'block', type: 'group', id: 'header' -%}
    <div class="home-grid">
      {%- for article in posts limit: 3 -%}
        {%- render 'ui-article-card', article: article, read_label: section.settings.read_label, heading_level: 3 -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.journal_highlights.name",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "t:sections.journal_highlights.settings.source.label",
      "options": [
        { "value": "latest", "label": "t:sections.journal_highlights.settings.source.options__latest" },
        { "value": "product", "label": "t:sections.journal_highlights.settings.source.options__product" }
      ],
      "default": "latest"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.journal_highlights.settings.blog.label"
    },
    {
      "type": "text",
      "id": "read_label",
      "label": "t:sections.journal_highlights.settings.read_label.label",
      "default": "t:sections.journal_highlights.settings.read_label.default"
    }
  ],
  "presets": [
    {
      "name": "t:sections.journal_highlights.name",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": { "direction": "row", "gap": "lg", "align": "end", "justify": "between" },
          "blocks": [
            {
              "type": "group",
              "settings": { "direction": "column", "gap": "md", "align": "start" },
              "blocks": [
                { "type": "text", "settings": { "text": "<p>The journal</p>", "style": "eyebrow" } },
                { "type": "heading", "settings": { "heading": "From the journal", "size": "xl" } }
              ]
            },
            { "type": "link", "settings": { "label": "View all posts" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
