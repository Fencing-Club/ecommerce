{{ 'section-home.css' | asset_url | stylesheet_tag }}

<div class="home-section brand-logos">
  {%- content_for 'block', type: 'group', id: 'header' -%}
  <div class="brand-logos__grid">{%- content_for 'blocks' -%}</div>
</div>

{% stylesheet %}
  .home-section.brand-logos {
    padding-block: var(--spacing-20);
  }
  .brand-logos__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--spacing-10) var(--spacing-12);
    align-items: center;
    padding-block: var(--spacing-10);
  }
  @media (max-width: 749px) {
    .home-section.brand-logos { padding-block: var(--spacing-14); }
    .brand-logos__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--spacing-8);
      padding-block: var(--spacing-8);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.brand_logos.name",
  "tag": "section",
  "blocks": [{ "type": "_logo" }],
  "presets": [
    {
      "name": "t:sections.brand_logos.name",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": { "direction": "column", "gap": "md", "align": "start" },
          "blocks": [
            { "type": "text", "settings": { "text": "<p>Authorized seller</p>", "style": "eyebrow" } },
            { "type": "heading", "settings": { "heading": "Official dealer for the sport's best brands", "size": "md" } }
          ]
        },
        { "type": "_logo" },
        { "type": "_logo" },
        { "type": "_logo" },
        { "type": "_logo" }
      ]
    }
  ]
}
{% endschema %}
