{{ 'section-about.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The About page opens on a full-bleed photo, with the header floating over it on wide screens. Breadcrumbs sit at the
  top; the call, headline, mission and buttons sit at the bottom, over the row of chapter links.
{%- endcomment -%}
<div class="about-dark about-hero">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2880
      | image_tag:
        class: 'about-hero__photo',
        alt: section.settings.image.alt,
        widths: '750, 1100, 1500, 2200, 2880',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high'
    }}
  {%- endif -%}
  <div class="about-hero__crumbs">
    {%- assign home_label = 'general.breadcrumb_home' | t -%}
    {%- render 'ui-breadcrumbs', root_label: home_label, root_url: routes.root_url, current_label: page.title -%}
  </div>
  <div class="about-hero__bottom">
    <div class="about-hero__copy">
      {%- content_for 'block', type: 'phase-heading', id: 'phase' -%}
      {%- content_for 'blocks' -%}
    </div>
    {%- content_for 'block', type: '_bout-nav', id: 'nav' -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.about_hero.name",
  "tag": "section",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.about_hero.settings.image.label",
      "info": "t:sections.about_hero.settings.image.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.about_hero.name",
      "blocks": [
        {
          "type": "phase-heading",
          "id": "phase",
          "static": true,
          "settings": { "meaning": "On guard", "word": "En garde", "tag": "p", "style": "eyebrow" }
        },
        {
          "type": "_bout-nav",
          "id": "nav",
          "static": true,
          "blocks": [
            { "type": "_bout-link", "settings": { "call": "En garde", "topic": "Who we are", "link": "#our-story" } },
            { "type": "_bout-link", "settings": { "call": "Prêts", "topic": "What we stand for", "link": "#what-we-stand-for" } },
            { "type": "_bout-link", "settings": { "call": "Allez", "topic": "How far we've come", "link": "#how-far-weve-come" } },
            { "type": "_bout-link", "settings": { "call": "Touché", "topic": "The numbers", "link": "#the-numbers" } },
            { "type": "_bout-link", "settings": { "call": "La belle", "topic": "Work with us", "link": "#work-with-us" } }
          ]
        },
        { "type": "heading", "settings": { "heading": "From first lesson to the final touch.", "tag": "h1", "size": "xl" } },
        {
          "type": "text",
          "settings": {
            "text": "<p>We're a team of fencers in Woodinville, Washington. Since 2023 we've bought straight from the makers so clubs, schools, and fencers at every level get dependable gear at fair prices.</p>",
            "style": "lead"
          }
        },
        {
          "type": "group",
          "settings": { "direction": "row", "gap": "sm", "align": "center" },
          "blocks": [
            { "type": "button", "settings": { "label": "Shop all gear", "link": "/collections/all", "style": "primary", "size": "lg" } },
            { "type": "button", "settings": { "label": "Read our story", "link": "#our-story", "style": "outline", "size": "lg" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
