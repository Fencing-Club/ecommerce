{{ 'section-about.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The About page opens on a full-bleed photo, with the header floating over it on wide screens. Breadcrumbs sit at the
  top; the call, headline, mission and buttons sit at the bottom, over the row of chapter links.
{%- endcomment -%}
<div class="about-dark about-hero">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2880
      | image_tag:
        class: 'about-hero__photo',
        alt: section.settings.image.alt,
        widths: '750, 1100, 1500, 2200, 2880',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high'
    }}
  {%- endif -%}
  <div class="about-hero__crumbs">
    {%- assign home_label = 'general.breadcrumb_home' | t -%}
    {%- render 'ui-breadcrumbs', root_label: home_label, root_url: routes.root_url, current_label: page.title -%}
  </div>
  <div class="about-hero__bottom">
    <div class="about-hero__copy">
      {%- content_for 'block', type: 'phase-heading', id: 'phase' -%}
      {%- content_for 'blocks' -%}
    </div>
    {%- content_for 'block', type: '_bout-nav', id: 'nav' -%}
  </div>
</div>

{% stylesheet %}
  .about-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--spacing-10);
    min-height: calc(var(--spacing) * 250);
    padding: calc(var(--spacing) * 59.5) var(--page-gutter) 0;
    overflow: hidden;
  }
  .about-hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Scrims darken the top under the header, the left behind the copy and the bottom behind the links. */
  .about-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--background) 80%, transparent), transparent 32rem),
      linear-gradient(to top, color-mix(in srgb, var(--background) 96%, transparent), transparent 58rem),
      linear-gradient(to right, color-mix(in srgb, var(--background) 90%, transparent), transparent 100rem);
  }
  .about-hero__crumbs,
  .about-hero__bottom {
    position: relative;
    z-index: 1;
  }
  .about-hero__crumbs .ui-breadcrumbs {
    flex-wrap: wrap;
  }
  .about-hero__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }
  .about-hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-7);
    max-width: calc(var(--spacing) * 195);
  }
  .about-hero__copy .block-heading {
    font-size: calc(var(--spacing) * 23);
    line-height: 0.98;
    letter-spacing: -0.033em;
  }
  .about-hero__copy .block-text--lead {
    max-width: calc(var(--spacing) * 150);
  }
  @media (max-width: 989px) {
    .about-hero {
      min-height: calc(var(--spacing) * 190);
      padding-top: 0;
      justify-content: flex-end;
    }
    .about-hero__crumbs { display: none; }
    .about-hero__bottom { gap: var(--spacing-10); }
    .about-hero__copy { gap: var(--spacing-5); }
    .about-hero__copy .block-heading {
      font-size: calc(var(--spacing) * 16);
      line-height: 1;
    }
  }
  @media (max-width: 749px) {
    .about-hero::after {
      background: linear-gradient(to top, color-mix(in srgb, var(--background) 96%, transparent), transparent 58rem);
    }
    .about-hero__copy .block-heading {
      font-size: calc(var(--spacing) * 11.5);
      letter-spacing: -0.035em;
    }
    .about-hero__copy .block-text--lead {
      font-size: var(--text-base);
    }
    /* Phones stack the buttons full width. */
    .about-hero__copy .block-group--row {
      flex-direction: column;
      align-items: stretch;
    }
    .about-hero__copy .ui-button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.about_hero.name",
  "tag": "section",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.about_hero.settings.image.label",
      "info": "t:sections.about_hero.settings.image.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.about_hero.name",
      "blocks": [
        {
          "type": "phase-heading",
          "id": "phase",
          "static": true,
          "settings": { "meaning": "On guard", "word": "En garde", "tag": "p", "style": "eyebrow" }
        },
        {
          "type": "_bout-nav",
          "id": "nav",
          "static": true,
          "blocks": [
            { "type": "_bout-link", "settings": { "call": "En garde", "topic": "Who we are", "link": "#our-story" } },
            { "type": "_bout-link", "settings": { "call": "Prêts", "topic": "What we stand for", "link": "#what-we-stand-for" } },
            { "type": "_bout-link", "settings": { "call": "Allez", "topic": "How far we've come", "link": "#how-far-weve-come" } },
            { "type": "_bout-link", "settings": { "call": "Touché", "topic": "The numbers", "link": "#the-numbers" } },
            { "type": "_bout-link", "settings": { "call": "La belle", "topic": "Work with us", "link": "#work-with-us" } }
          ]
        },
        { "type": "heading", "settings": { "heading": "Fencers equipping fencers.", "tag": "h1", "size": "xl" } },
        {
          "type": "text",
          "settings": {
            "text": "<p>We're a team of fencers in Woodinville, Washington. Since 2023 we've bought straight from the makers so clubs, schools, and fencers at every level get dependable gear at fair prices, from a first lesson to the finals.</p>",
            "style": "lead"
          }
        },
        {
          "type": "group",
          "settings": { "direction": "row", "gap": "sm", "align": "center" },
          "blocks": [
            { "type": "button", "settings": { "label": "Shop all gear", "link": "/collections/all", "style": "primary", "size": "lg" } },
            { "type": "button", "settings": { "label": "Read our story", "link": "#our-story", "style": "outline", "size": "lg" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
