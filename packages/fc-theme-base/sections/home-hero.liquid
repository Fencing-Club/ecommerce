{{ 'section-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fc-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign slide_label = 'sections.home_hero.slide_label' | t: index: '[index]', count: '[count]'
-%}
<fc-carousel
  class="home-hero"
  data-carousel="fade"
  data-slide-label="{{ slide_label | escape }}"
  aria-roledescription="carousel"
  aria-label="{{ 'sections.home_hero.label' | t }}"
  {% if section.settings.autoplay %}
    data-autoplay="{{ section.settings.autoplay_speed | times: 1000 }}"
  {% endif %}
>
  <div class="home-hero__track" data-carousel-track>{%- content_for 'blocks' -%}</div>

  {%- if section.blocks.size > 1 -%}
    <div class="home-hero__controls">
      {%- assign previous_label = 'sections.home_hero.previous' | t -%}
      {%- render 'ui-button', aria_label: previous_label, variant: 'icon', icon: 'chevron-left', additional_props: 'data-carousel-prev' -%}
      <div class="carousel-dots" role="tablist" aria-label="{{ 'sections.home_hero.choose' | t }}">
        {%- for slide in section.blocks -%}
          <button
            class="carousel-dot"
            type="button"
            role="tab"
            data-carousel-dot
            aria-label="{{ 'sections.home_hero.go_to' | t: index: forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {%- endfor -%}
      </div>
      {%- assign next_label = 'sections.home_hero.next' | t -%}
      {%- render 'ui-button', aria_label: next_label, variant: 'icon', icon: 'chevron-right', additional_props: 'data-carousel-next' -%}
    </div>
  {%- endif -%}
</fc-carousel>

{% stylesheet %}
  .home-hero {
    position: relative;
    display: block;
    height: calc(var(--spacing) * 180);
    overflow: hidden;
    background: var(--primary);
  }
  .home-hero__track {
    position: absolute;
    inset: 0;
  }
  /* Light controls over the photo. */
  .home-hero__controls {
    position: absolute;
    right: 0;
    bottom: var(--spacing-6);
    left: 0;
    z-index: 1;
    display: flex;
    gap: var(--spacing-2);
    align-items: center;
    justify-content: center;
    --foreground: var(--primary-foreground);
    --muted-foreground: var(--primary-foreground);
  }
  @media (max-width: 989px) {
    .home-hero { height: calc(var(--spacing) * 150); }
  }
  @media (max-width: 749px) {
    .home-hero { height: calc(var(--spacing) * 130); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home_hero.name",
  "tag": "section",
  "blocks": [{ "type": "_hero-slide" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.home_hero.settings.autoplay.label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:sections.home_hero.settings.autoplay_speed.label",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_hero.name",
      "blocks": [
        {
          "type": "_hero-slide",
          "blocks": [
            { "type": "text", "settings": { "text": "<p>Olympic fencing gear</p>", "style": "eyebrow" } },
            { "type": "heading", "settings": { "heading": "Gear for every bout", "tag": "h1", "size": "xl" } },
            { "type": "text", "settings": { "text": "<p>Competition equipment for fencers at every level.</p>" } },
            {
              "type": "group",
              "settings": { "direction": "row", "gap": "lg", "align": "center" },
              "blocks": [
                { "type": "button", "settings": { "label": "Shop now", "style": "secondary", "size": "lg" } },
                { "type": "link", "settings": { "label": "Starter kits" } }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
