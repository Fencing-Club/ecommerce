{{ 'section-home.css' | asset_url | stylesheet_tag }}

<div class="home-section">
  {%- content_for 'block', type: 'group', id: 'header' -%}
  <div class="home-grid">{%- content_for 'blocks' -%}</div>
</div>

{% schema %}
{
  "name": "t:sections.category_grid.name",
  "tag": "section",
  "blocks": [{ "type": "_category-card" }],
  "presets": [
    {
      "name": "t:sections.category_grid.name",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": { "direction": "column", "gap": "md", "align": "start" },
          "blocks": [
            { "type": "text", "settings": { "text": "<p>Browse the range</p>", "style": "eyebrow" } },
            { "type": "heading", "settings": { "heading": "Shop by category", "size": "xl" } }
          ]
        },
        { "type": "_category-card" },
        { "type": "_category-card" },
        { "type": "_category-card" }
      ]
    }
  ]
}
{% endschema %}
