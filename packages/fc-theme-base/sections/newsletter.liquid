<div class="newsletter newsletter--{{ section.settings.layout }}">
  <div class="newsletter__inner">
    <div class="newsletter__copy">{%- content_for 'blocks' -%}</div>
    <div class="newsletter__capture">{%- content_for 'block', type: 'email-signup', id: 'signup' -%}</div>
  </div>
</div>

{% stylesheet %}
  /* A dark band. A custom property reads the values its own element sets, so the light-on-dark roles go in three
     steps, each reading only roles set further out: the band makes --primary light, so the subscribe button turns
     light; */
  .newsletter {
    --primary: var(--primary-foreground);
    background: var(--foreground);
  }
  /* the inner row gives the button dark text and the field its translucent fill, border and a light focus ring; */
  .newsletter__inner {
    --primary-foreground: var(--foreground);
    --background: color-mix(in srgb, var(--primary) 8%, var(--foreground));
    --input: color-mix(in srgb, var(--primary) 15%, transparent);
    --ring: var(--primary);
    --muted-foreground: #9f9fa9; /* zinc-400 */
    display: flex;
    gap: var(--spacing-12);
    align-items: center;
    justify-content: space-between;
    padding: calc(var(--spacing) * 13) var(--page-gutter);
  }
  /* and the columns turn their text light. */
  .newsletter__copy,
  .newsletter__capture {
    --foreground: var(--primary);
    color: var(--foreground);
  }
  .newsletter__copy {
    display: flex;
    flex: 0 1 calc(var(--spacing) * 130);
    flex-direction: column;
    gap: var(--spacing-2-5);
    min-width: 0;
  }
  .newsletter__capture {
    flex: 0 1 calc(var(--spacing) * 115);
    min-width: 0;
  }
  .newsletter--stacked .newsletter__inner {
    flex-direction: column;
    text-align: center;
  }
  .newsletter--stacked .newsletter__copy {
    flex-basis: auto;
    align-items: center;
  }
  .newsletter--stacked .newsletter__capture {
    flex-basis: auto;
    width: min(100%, calc(var(--spacing) * 115));
  }
  @media (max-width: 989px) {
    .newsletter__inner {
      flex-direction: column;
      gap: var(--spacing-6);
      align-items: stretch;
      padding-block: var(--spacing-10);
    }
    .newsletter__copy,
    .newsletter__capture {
      flex-basis: auto;
    }
    .newsletter--stacked .newsletter__inner {
      align-items: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "blocks": [{ "type": "heading" }, { "type": "text" }],
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.newsletter.settings.layout.label",
      "default": "split",
      "options": [
        { "value": "split", "label": "t:sections.newsletter.settings.layout.options__split" },
        { "value": "stacked", "label": "t:sections.newsletter.settings.layout.options__stacked" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.name",
      "blocks": [
        { "type": "heading", "settings": { "heading": "Get first access to new gear & restocks", "size": "lg" } },
        {
          "type": "text",
          "settings": {
            "text": "<p>Join the list for early drops, limited restocks, and fitting guides. No noise, just the essentials.</p>",
            "style": "subtle"
          }
        },
        { "type": "email-signup", "id": "signup", "static": true }
      ]
    }
  ]
}
{% endschema %}
