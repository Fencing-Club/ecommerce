{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "announcement-bar": {
      "type": "announcement-bar",
      "settings": {
        "autoplay": true,
        "autoplay_speed": 5
      },
      "blocks": {
        "announcement-bar-0": {
          "type": "_announcement",
          "settings": {
            "content": "free_shipping",
            "tone": "default",
            "link": "shopify://collections/all",
            "link_label": "Shop now"
          }
        },
        "announcement-bar-1": {
          "type": "_announcement",
          "settings": {
            "title": "Hassle-free returns",
            "message": "30-day postage paid returns",
            "tone": "default",
            "link": "shopify://pages/refund-policy",
            "link_label": "See policy"
          }
        },
        "announcement-bar-3": {
          "type": "_announcement",
          "settings": {
            "title": "New athletic season",
            "message": "Up to 30% off",
            "tone": "sale",
            "link": "shopify://collections/all",
            "link_label": "Shop the sale"
          }
        },
        "announcement-bar-4": {
          "type": "_announcement",
          "settings": {
            "title": "Summer nationals",
            "message": "Visit us at booth 14",
            "tone": "event",
            "link": "shopify://pages/about-us",
            "link_label": "Event details"
          }
        },
        "announcement-bar-5": {
          "type": "_announcement",
          "settings": {
            "title": "Traveling to our factories",
            "message": "Orders ship from July 20",
            "tone": "vacation",
            "link": "shopify://pages/shipping-policy",
            "link_label": "Learn more"
          }
        }
      },
      "block_order": [
        "announcement-bar-0",
        "announcement-bar-1",
        "announcement-bar-3",
        "announcement-bar-4",
        "announcement-bar-5"
      ]
    },
    "header": {
      "type": "header",
      "blocks": {
        "home": {
          "type": "_utility-link",
          "settings": {
            "label": "Home",
            "link": "/"
          }
        },
        "about": {
          "type": "_utility-link",
          "settings": {
            "label": "About us",
            "link": "shopify://pages/about-us"
          }
        },
        "contact": {
          "type": "_utility-link",
          "settings": {
            "label": "Contact",
            "link": "shopify://pages/contact"
          }
        },
        "order-tracking": {
          "type": "_utility-link",
          "settings": {
            "label": "Order tracking",
            "link": "/account/orders"
          }
        },
        "returns": {
          "type": "_utility-link",
          "settings": {
            "label": "Returns",
            "link": "shopify://pages/refund-policy"
          }
        }
      },
      "block_order": [
        "home",
        "about",
        "contact",
        "order-tracking",
        "returns"
      ],
      "settings": {
        "menu": "main-menu",
        "enable_language_selector": true,
        "enable_country_selector": true
      }
    }
  },
  "order": [
    "announcement-bar",
    "header"
  ]
}
