{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "announcement-bar": {
      "type": "announcement-bar",
      "settings": {
        "autoplay": true,
        "autoplay_speed": 5
      },
      "blocks": {
        "announcement-bar-0": {
          "type": "_announcement",
          "settings": {
            "title": "Free US shipping",
            "message": "On orders over $375",
            "tone": "default",
            "link": "shopify://collections/all",
            "link_label": "Shop now"
          }
        },
        "announcement-bar-1": {
          "type": "_announcement",
          "settings": {
            "title": "Hassle-free returns",
            "message": "30-day postage paid returns",
            "tone": "default",
            "link": "shopify://policies/refund-policy",
            "link_label": "See policy"
          }
        },
        "announcement-bar-3": {
          "type": "_announcement",
          "settings": {
            "title": "New athletic season",
            "message": "Up to 30% off",
            "tone": "sale",
            "link": "shopify://collections/all",
            "link_label": "Shop the sale"
          }
        },
        "announcement-bar-4": {
          "type": "_announcement",
          "settings": {
            "title": "Summer nationals",
            "message": "Visit us at booth 14",
            "tone": "event",
            "link": "shopify://pages/about",
            "link_label": "Event details"
          }
        },
        "announcement-bar-5": {
          "type": "_announcement",
          "settings": {
            "title": "Traveling to our factories",
            "message": "Orders ship from July 20",
            "tone": "vacation",
            "link": "shopify://policies/shipping-policy",
            "link_label": "Learn more"
          }
        }
      },
      "block_order": [
        "announcement-bar-0",
        "announcement-bar-1",
        "announcement-bar-3",
        "announcement-bar-4",
        "announcement-bar-5"
      ]
    },
    "header": {
      "type": "header",
      "settings": {
        "color_scheme": "scheme-1",
        "menu_color_scheme": "scheme-1",
        "logo_position": "middle-left",
        "menu": "main-menu",
        "menu_type_desktop": "mega",
        "sticky_header_type": "on-scroll-up",
        "show_line_separator": true,
        "enable_country_selector": true,
        "enable_language_selector": true,
        "mobile_logo_position": "center",
        "margin_bottom": 0,
        "padding_top": 20,
        "padding_bottom": 20
      }
    }
  },
  "order": [
    "announcement-bar",
    "header"
  ]
}
