{{ 'section-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fc-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign slide_label = 'sections.testimonials.slide_label' | t: index: '[index]', count: '[count]'
-%}
<fc-carousel
  class="home-section testimonials"
  data-slide-label="{{ slide_label | escape }}"
  aria-roledescription="carousel"
  aria-label="{{ 'sections.testimonials.label' | t }}"
>
  <div class="testimonials__head">
    {%- content_for 'block', type: 'group', id: 'header' -%}
    {%- if section.blocks.size > 1 -%}
      <div class="testimonials__nav">
        {%- assign previous_label = 'sections.testimonials.previous' | t -%}
        {%- assign next_label = 'sections.testimonials.next' | t -%}
        {%- render 'ui-button', aria_label: previous_label, variant: 'icon', size: 'md', icon: 'chevron-left', additional_props: 'data-carousel-prev' -%}
        {%- render 'ui-button', aria_label: next_label, variant: 'icon', size: 'md', icon: 'chevron-right', additional_props: 'data-carousel-next' -%}
      </div>
    {%- endif -%}
  </div>

  <div class="testimonials__viewport">
    <div class="testimonials__track" data-carousel-track>{%- content_for 'blocks' -%}</div>
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="carousel-dots" role="tablist" aria-label="{{ 'sections.testimonials.choose' | t }}">
      {%- for quote in section.blocks -%}
        <button
          class="carousel-dot"
          type="button"
          role="tab"
          data-carousel-dot
          aria-label="{{ 'sections.testimonials.go_to' | t: index: forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</fc-carousel>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "blocks": [{ "type": "_testimonial" }],
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": { "direction": "column", "gap": "md", "align": "start" },
          "blocks": [
            { "type": "text", "settings": { "text": "<p>Testimonials</p>", "style": "eyebrow" } },
            { "type": "heading", "settings": { "heading": "Loved by the fencing community", "size": "xl" } }
          ]
        },
        { "type": "_testimonial" },
        { "type": "_testimonial" },
        { "type": "_testimonial" }
      ]
    }
  ]
}
{% endschema %}
