{{ 'section-about.css' | asset_url | stylesheet_tag }}

<div class="about-section about-section--phase about-section--muted about-principles" id="what-we-stand-for">
  {%- content_for 'block', type: 'phase-heading', id: 'phase' -%}
  <div class="about-lead">{%- content_for 'block', type: 'text', id: 'lead' -%}</div>
  <div class="about-principles__grid">{%- content_for 'blocks' -%}</div>
  <div class="about-principles__operations">
    <div class="about-principles__photo">
      {%- content_for 'block', type: 'image', id: 'operations_image' -%}
    </div>
    <div class="about-principles__copy">
      {%- content_for 'block', type: 'text', id: 'operations_eyebrow' -%}
      {%- content_for 'block', type: 'heading', id: 'operations_heading' -%}
      {%- content_for 'block', type: 'text', id: 'operations_start' -%}
      {%- content_for 'block', type: 'text', id: 'operations_end' -%}
      {%- content_for 'block', type: 'text', id: 'company' -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.about_principles.name",
  "tag": "section",
  "blocks": [{ "type": "feature" }],
  "presets": [
    {
      "name": "t:sections.about_principles.name",
      "blocks": [
        {
          "type": "phase-heading",
          "id": "phase",
          "static": true,
          "settings": { "meaning": "Ready", "word": "Prêts" }
        },
        {
          "type": "text",
          "id": "lead",
          "static": true,
          "settings": { "text": "<p>Before the bout, you settle into your stance. Here's ours.</p>", "style": "body" }
        },
        { "type": "image", "id": "operations_image", "static": true, "settings": { "aspect_ratio": "landscape" } },
        { "type": "text", "id": "operations_eyebrow", "static": true, "settings": { "text": "<p>How we operate</p>", "style": "eyebrow" } },
        { "type": "heading", "id": "operations_heading", "static": true, "settings": { "heading": "Our own stock, our own team", "tag": "h3", "size": "md" } },
        { "type": "text", "id": "operations_start", "static": true, "settings": { "text": "<p>We hold our own inventory.</p>", "style": "lead" } },
        { "type": "text", "id": "operations_end", "static": true, "settings": { "text": "<p>Our own team handles every order.</p>", "style": "lead" } },
        { "type": "text", "id": "company", "static": true, "settings": { "text": "<p>Fencing Club is operated by Fencing Club LLC, a Washington limited liability company.</p>", "style": "subtle" } },
        { "type": "feature", "settings": { "icon": "users", "label": "Built for clubs", "detail": "Member pricing, team kits, and club drop-off." } },
        { "type": "feature", "settings": { "icon": "tag", "label": "Fair pricing", "detail": "Short supply chains keep prices down." } }
      ]
    }
  ]
}
{% endschema %}
