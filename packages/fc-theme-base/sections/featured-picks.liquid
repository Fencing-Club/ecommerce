{{ 'section-home.css' | asset_url | stylesheet_tag }}

<div class="home-section">
  {%- content_for 'block', type: 'group', id: 'header' -%}
  <div class="picks-grid">{%- content_for 'blocks' -%}</div>
</div>

{% stylesheet %}
  /* Two columns: the first two picks stack on the left and the third runs the full height on the right. */
  .picks-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-6);
  }
  .picks-grid > :nth-child(3) {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  @media (max-width: 749px) {
    .picks-grid { grid-template-columns: minmax(0, 1fr); }
    .picks-grid > :nth-child(3) {
      grid-column: auto;
      grid-row: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_picks.name",
  "tag": "section",
  "max_blocks": 3,
  "blocks": [{ "type": "_pick-card" }],
  "presets": [
    {
      "name": "t:sections.featured_picks.name",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": { "direction": "column", "gap": "md", "align": "start" },
          "blocks": [
            { "type": "text", "settings": { "text": "<p>Gear up your way</p>", "style": "eyebrow" } },
            { "type": "heading", "settings": { "heading": "Featured picks", "size": "lg" } }
          ]
        },
        {
          "type": "_pick-card",
          "settings": { "title": "Starter kits", "description": "A uniform, a blade and a mask, bundled together." },
          "blocks": [
            { "type": "_pick-link", "settings": { "label": "Foil kits" } },
            { "type": "_pick-link", "settings": { "label": "Épée kits" } }
          ]
        },
        {
          "type": "_pick-card",
          "settings": { "title": "Weapons", "description": "Competition-ready blades for every discipline." },
          "blocks": [
            { "type": "_pick-link", "settings": { "label": "Foil" } },
            { "type": "_pick-link", "settings": { "label": "Épée" } }
          ]
        },
        {
          "type": "_pick-card",
          "settings": { "title": "Bags", "description": "Room for your whole kit, from club night to competition." },
          "blocks": [{ "type": "_pick-link", "settings": { "label": "Wheel bags" } }]
        }
      ]
    }
  ]
}
{% endschema %}
