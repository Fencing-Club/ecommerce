{{ 'section-about.css' | asset_url | stylesheet_tag }}

<div class="about-section about-programs">
  {%- content_for 'block', type: 'group', id: 'header' -%}
  <div class="about-programs__grid">{%- content_for 'blocks' -%}</div>
</div>

{% schema %}
{
  "name": "t:sections.about_programs.name",
  "tag": "section",
  "blocks": [{ "type": "_program" }],
  "presets": [
    {
      "name": "t:sections.about_programs.name",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": { "direction": "column", "gap": "md" },
          "blocks": [
            { "type": "text", "settings": { "text": "<p>Programs</p>", "style": "eyebrow" } },
            { "type": "heading", "settings": { "heading": "Pricing built for clubs, schools, and teams", "size": "lg" } },
            { "type": "text", "settings": { "text": "<p>We help clubs, schools and nonprofits equip their athletes for less.</p>", "style": "lead" } }
          ]
        },
        {
          "type": "_program",
          "settings": { "icon": "badge-percent", "figure_prefix": "Up to", "figure": "15%", "figure_caption": "off house-brand gear", "title": "Club member pricing", "text": "Club members save on house-brand gear every day." }
        },
        {
          "type": "_program",
          "settings": { "icon": "boxes", "figure_prefix": "Up to", "figure": "10%", "figure_caption": "off orders of $1,500 or more", "title": "Bulk and team kitting", "text": "Large orders unlock bulk pricing." }
        }
      ]
    }
  ]
}
{% endschema %}
