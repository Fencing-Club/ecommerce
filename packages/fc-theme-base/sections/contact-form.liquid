{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

<contact-form-section class="contact-page">
  <div class="contact-page__intro">
    <header class="contact-page__hero">
      <p class="contact-page__kicker">{{ section.settings.kicker | escape }}</p>
      <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
      <p>{{ section.settings.subtitle | escape }}</p>
    </header>

    {%- content_for 'block', type: '_contact-topics', id: 'topics' -%}
  </div>

  <section class="contact-page__details" aria-labelledby="ContactDetails-{{ section.id }}">
    <div class="contact-page__details-row">
      <div class="contact-page__form-card">
        <header>
          <h2 id="ContactDetails-{{ section.id }}">{{ section.settings.form_heading | escape }}</h2>
          <p>{{ section.settings.form_note | escape }}</p>
        </header>

        {%- form 'contact', id: 'ContactForm', class: 'contact-page__form' -%}
          <input id="ContactForm-topic" type="hidden" name="contact[Topic]" value="General question">
          {%- if form.posted_successfully? -%}
            <p class="contact-page__status contact-page__status--success" tabindex="-1" autofocus>
              {{- 'templates.contact.form.post_success' | t -}}
            </p>
          {%- elsif form.errors -%}
            <div class="contact-page__status contact-page__status--error" role="alert" tabindex="-1" autofocus>
              {{- form.errors | default_errors -}}
            </div>
          {%- endif -%}

          {% capture contact_name %}{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}{% endcapture %}
          {% capture contact_email %}{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}{% endcapture %}
          {% capture contact_phone %}{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}{% endcapture %}
          {%- liquid
            assign name_label = 'sections.contact.name' | t
            assign email_label = 'sections.contact.email' | t
            assign phone_label = 'sections.contact.phone' | t
            assign message_label = 'sections.contact.message' | t
          -%}
          {% render 'ui-text-field', id: 'ContactForm-name', name: 'contact[name]', label: name_label, autocomplete: 'name', value: contact_name, placeholder: section.settings.name_placeholder %}
          {% render 'ui-text-field', id: 'ContactForm-email', name: 'contact[email]', label: email_label, type: 'email', autocomplete: 'email', autocapitalize: 'off', required: true, value: contact_email, placeholder: section.settings.email_placeholder %}
          {% render 'ui-text-field', id: 'ContactForm-phone', name: 'contact[phone]', label: phone_label, type: 'tel', autocomplete: 'tel', value: contact_phone, placeholder: section.settings.phone_placeholder %}
          {% render 'ui-text-field', id: 'ContactForm-body', name: 'contact[body]', label: message_label, multiline: true, rows: 4, value: form.body, placeholder: section.settings.message_placeholder %}
          {% render 'ui-button', type: 'submit', variant: 'primary', label: section.settings.submit_label %}
        {%- endform -%}
      </div>

      <aside class="contact-page__direct">
        <header>
          <h2>{{ section.settings.direct_heading | escape }}</h2>
          <p>{{ section.settings.direct_text | escape }}</p>
        </header>
        {%- render 'shop-contact-details', class: 'contact-page__contact-details' -%}
      </aside>
    </div>
  </section>

  {%- content_for 'block', type: '_contact-answers', id: 'answers' -%}
</contact-form-section>

{% javascript %}
  if (!customElements.get('contact-form-section')) {
    customElements.define(
      'contact-form-section',
      class ContactFormSection extends HTMLElement {
        connectedCallback() {
          this.addEventListener('click', (event) => {
            const card = event.target.closest('[data-contact-topic]');
            if (!card || !this.contains(card)) return;

            const topic = this.querySelector('#ContactForm-topic');
            if (topic) topic.value = card.dataset.contactTopic;
            requestAnimationFrame(() => this.querySelector('#ContactForm-name')?.focus());
          });
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.contact_form.settings.kicker.label",
      "default": "Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.contact_form.settings.heading.label",
      "default": "How can we help?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:sections.contact_form.settings.subtitle.label",
      "default": "Pick a topic to reach the right person, or send a note and we’ll route it. We reply within 2 business days."
    },
    {
      "type": "header",
      "content": "t:sections.contact_form.settings.form.content"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "t:sections.contact_form.settings.form_heading.label",
      "default": "Your details"
    },
    {
      "type": "text",
      "id": "form_note",
      "label": "t:sections.contact_form.settings.form_note.label",
      "default": "Tell us how to reach you about your question."
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "t:sections.contact_form.settings.name_placeholder.label",
      "default": "Your full name"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "t:sections.contact_form.settings.email_placeholder.label",
      "default": "you@email.com"
    },
    {
      "type": "text",
      "id": "phone_placeholder",
      "label": "t:sections.contact_form.settings.phone_placeholder.label",
      "default": "+1 (415) 555-0100"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "t:sections.contact_form.settings.message_placeholder.label",
      "default": "Order number, sizing questions, timing, anything else..."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "t:sections.contact_form.settings.submit_label.label",
      "default": "Send message"
    },
    {
      "type": "header",
      "content": "t:sections.contact_form.settings.direct_contact.content"
    },
    {
      "type": "text",
      "id": "direct_heading",
      "label": "t:sections.contact_form.settings.direct_heading.label",
      "default": "Prefer to just message us?"
    },
    {
      "type": "text",
      "id": "direct_text",
      "label": "t:sections.contact_form.settings.direct_text.label",
      "default": "No appointment needed. Reach us any time."
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact_form.name",
      "blocks": [
        {
          "type": "_contact-topics",
          "id": "topics",
          "static": true,
          "blocks": [
            {
              "type": "_contact-topic"
            }
          ]
        },
        {
          "type": "_contact-answers",
          "id": "answers",
          "static": true,
          "blocks": [
            {
              "type": "_contact-answer"
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
