{{ 'section-about.css' | asset_url | stylesheet_tag }}

{%- comment -%} The id is where the hero's "Read our story" button points. {%- endcomment -%}
<div class="about-section about-story" id="our-story">
  <div class="about-story__text">
    {%- content_for 'block', type: 'group', id: 'header' -%}
    <div class="about-story__body">{%- content_for 'blocks' -%}</div>
  </div>
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2500
      | image_tag:
        class: 'about-story__photo',
        alt: section.settings.image.alt,
        widths: '750, 1100, 1500, 2000, 2500',
        sizes: '(min-width: 1440px) 1248px, calc(100vw - 4rem)',
        loading: 'lazy'
    }}
  {%- endif -%}
</div>

{% stylesheet %}
  .about-story {
    gap: var(--spacing-20);
  }
  .about-story__text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-10);
  }
  .about-story__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-10);
    max-width: calc(var(--spacing) * 190);
  }
  .about-story__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 208 / 100;
    object-fit: cover;
    border-radius: var(--radius-xl);
    background: var(--muted);
  }
  @media (max-width: 749px) {
    .about-story { gap: var(--spacing-6); }
    .about-story__text,
    .about-story__body { gap: var(--spacing-6); }
    .about-story__photo { aspect-ratio: 16 / 9; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.about_story.name",
  "tag": "section",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.about_story.settings.image.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.about_story.name",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": { "direction": "column", "gap": "lg" },
          "blocks": [
            { "type": "text", "settings": { "text": "<p>Our story</p>", "style": "eyebrow" } },
            { "type": "heading", "settings": { "heading": "It started in other people's clubs", "size": "lg" } }
          ]
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Before Fencing Club, we spent years visiting fencing clubs, schools, and training halls around the world.</p>",
            "style": "lead"
          }
        },
        {
          "type": "text",
          "settings": { "text": "<p>Cost and access should never stand between a fencer and the sport.</p>", "style": "quote" }
        }
      ]
    }
  ]
}
{% endschema %}
