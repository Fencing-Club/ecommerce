{%- liquid
  assign year = 'now' | date: '%Y'
  assign copyright_name = section.settings.copyright_name | default: shop.name
-%}
<footer class="footer">
  <div class="footer__main">
    <div class="footer__brand">{%- content_for 'block', type: '_footer-brand', id: 'brand' -%}</div>
    <nav class="footer__menus" aria-label="{{ 'sections.footer.menus' | t }}">{%- content_for 'blocks' -%}</nav>
    <div class="footer__contact">{%- content_for 'block', type: '_footer-contact', id: 'contact' -%}</div>
  </div>
  <div class="footer__bottom">
    <p class="footer__copyright">{{ 'sections.footer.copyright' | t: year: year, name: copyright_name }}</p>
    {%- if section.settings.payment_enable and shop.enabled_payment_types.size > 0 -%}
      <ul class="footer__payments" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'footer__payment' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  /* A black band with light text. The roles read only --primary-foreground, which the footer doesn't set. */
  .footer {
    --foreground: var(--primary-foreground);
    --muted-foreground: #9f9fa9; /* zinc-400 */
    --border: color-mix(in srgb, var(--primary-foreground) 10%, transparent);
    --accent: color-mix(in srgb, var(--primary-foreground) 8%, transparent);
    --ring: var(--primary-foreground);
    --footer-gap: var(--spacing-14);
    display: flex;
    flex-direction: column;
    gap: var(--footer-gap);
    padding: calc(var(--spacing) * 18) var(--page-gutter) var(--spacing-10);
    background: #000; /* black */
    color: var(--foreground);
  }
  .footer :focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    box-shadow: none;
  }
  .footer__heading {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: var(--font-weight-bold);
    line-height: var(--text-xs--line-height);
    letter-spacing: 0.1rem;
    text-transform: uppercase;
    color: var(--foreground);
  }
  .footer__link {
    color: var(--muted-foreground);
    text-decoration: none;
  }
  .footer__link:hover,
  .footer__link:focus-visible,
  .footer__link[aria-current] {
    color: var(--foreground);
  }
  .footer__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  /* Desktop: brand on the left; the menus and contact columns on the right. On narrower desktops the gaps close
     from 72px towards 40px and the brand and contact columns narrow, so the row still fits. */
  .footer__main {
    --footer-column-gap: clamp(var(--spacing-10), 6vw, calc(var(--spacing) * 18));
    display: flex;
    gap: var(--footer-column-gap);
    align-items: flex-start;
  }
  .footer__brand {
    flex: 0 1 32rem;
    min-width: 0;
    margin-inline-end: auto;
  }
  .footer__menus {
    display: flex;
    gap: var(--footer-column-gap);
    white-space: nowrap;
  }
  /* 19rem holds the widest contact line ("Mon–Fri, 9am–6pm PST") beside its icon. */
  .footer__contact {
    flex: 0 1 24rem;
    min-width: 19rem;
  }

  .footer__bottom {
    display: flex;
    gap: var(--spacing-6);
    align-items: center;
    justify-content: space-between;
    padding-block-start: var(--footer-gap);
    border-block-start: 1px solid var(--border);
  }
  .footer__copyright {
    margin: 0;
    font-size: 1.3rem;
    color: var(--muted-foreground);
  }
  .footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__payment {
    display: block;
    width: 3.8rem;
    height: 2.4rem;
  }

  /* Tablet: the menus across the top, then contact beside the brand, each group under a rule. */
  @media (max-width: 989px) {
    .footer {
      --footer-gap: var(--spacing-7);
      padding-block: var(--spacing-12) var(--spacing-8);
    }
    .footer__main {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'menus menus'
        'contact brand';
      gap: 0 var(--spacing-12);
    }
    .footer__menus {
      display: grid;
      grid-area: menus;
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
      gap: var(--spacing-6);
      margin-block-end: var(--footer-gap);
      white-space: normal;
      padding-block-end: var(--footer-gap);
      border-block-end: 1px solid var(--border);
    }
    .footer__contact {
      grid-area: contact;
    }
    .footer__brand {
      grid-area: brand;
      margin: 0;
    }
  }

  /* Phone: menus, contact and brand stack under rules, and the payment marks sit above the centred copyright. */
  @media (max-width: 749px) {
    .footer__main {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'menus'
        'contact'
        'brand';
    }
    .footer__menus {
      gap: var(--spacing-3);
    }
    .footer__contact {
      margin-block-end: var(--footer-gap);
      padding-block-end: var(--footer-gap);
      border-block-end: 1px solid var(--border);
    }
    .footer__bottom {
      flex-direction: column-reverse;
      gap: calc(var(--spacing) * 4.5);
      text-align: center;
    }
    .footer__payments {
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 4,
  "blocks": [{ "type": "_footer-menu" }],
  "settings": [
    {
      "type": "text",
      "id": "copyright_name",
      "label": "t:sections.footer.settings.copyright_name.label",
      "info": "t:sections.footer.settings.copyright_name.info"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "t:sections.footer.settings.payment_enable.label",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.footer.name",
      "blocks": [
        { "type": "_footer-brand", "id": "brand", "static": true },
        { "type": "_footer-menu", "settings": { "heading": "Shop", "menu": "footer" } },
        { "type": "_footer-contact", "id": "contact", "static": true }
      ]
    }
  ]
}
{% endschema %}
