{{ 'section-about.css' | asset_url | stylesheet_tag }}

<div class="about-section about-section--phase about-closing">
  {%- content_for 'block', type: 'phase-heading', id: 'phase' -%}
  <div class="about-closing__intro">{%- content_for 'block', type: 'group', id: 'intro' -%}</div>
  <div class="about-closing__panel about-dark">
    {%- content_for 'block', type: 'group', id: 'panel' -%}
    {%- content_for 'block', type: 'button', id: 'action' -%}
  </div>
</div>

{% stylesheet %}
  .about-closing__intro {
    max-width: calc(var(--spacing) * 180);
  }
  /* The invitation and its button share a row; phones stack the button under it. */
  .about-closing__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-10);
    padding: var(--spacing-14);
    border-radius: var(--radius-xl);
  }
  @media (max-width: 749px) {
    .about-closing__panel {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
      gap: var(--spacing-6);
      padding: var(--spacing-8) var(--spacing-6);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.about_closing.name",
  "tag": "section",
  "presets": [
    {
      "name": "t:sections.about_closing.name",
      "blocks": [
        {
          "type": "phase-heading",
          "id": "phase",
          "static": true,
          "settings": { "meaning": "The deciding touch", "word": "La belle" }
        },
        {
          "type": "group",
          "id": "intro",
          "static": true,
          "settings": { "direction": "column", "gap": "md" },
          "blocks": [
            { "type": "heading", "settings": { "heading": "We back the people building this sport.", "tag": "h3", "size": "md" } },
            { "type": "text", "settings": { "text": "<p>If you're building something for fencers, you can sell it in our store and ship it through our distribution network.</p>", "style": "lead" } }
          ]
        },
        {
          "type": "group",
          "id": "panel",
          "static": true,
          "settings": { "direction": "column", "gap": "lg" },
          "blocks": [
            { "type": "heading", "settings": { "heading": "Tell us what you're building.", "tag": "h3", "size": "md" } },
            { "type": "text", "settings": { "text": "<p>Ask about selling with us or shipping through our network, or just say hello.</p>", "style": "lead" } }
          ]
        },
        {
          "type": "button",
          "id": "action",
          "static": true,
          "settings": { "label": "Get in touch", "link": "/pages/contact", "style": "primary", "size": "lg" }
        }
      ]
    }
  ]
}
{% endschema %}
