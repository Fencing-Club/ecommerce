{{ 'section-faq.css' | asset_url | stylesheet_tag }}
{{ 'component-support-band.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  A section can't read its theme blocks' settings, so the topic links come from the rendered `_faq-topic` headings:
  each carries its title and anchor in `data-faq-topic` and `id`.
{%- endcomment -%}
{%- capture faq_blocks -%}{%- content_for 'blocks' -%}{%- endcapture -%}
{%- assign faq_topics = faq_blocks | split: 'data-faq-topic="' -%}

<div
  class="faq-page"
  {% if settings.structured_data_enabled %}
    itemscope itemtype="https://schema.org/FAQPage"
  {% endif %}
>
  <header class="faq-page__hero">
    <p class="faq-page__kicker">{{ section.settings.kicker | escape }}</p>
    <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
    <p class="faq-page__subtitle">{{ section.settings.subtitle | escape }}</p>
    <nav class="faq-page__topics" aria-label="{{ 'sections.faq.topics' | t }}">
      {%- for faq_topic in faq_topics offset: 1 -%}
        {%- assign faq_topic_parts = faq_topic | split: '"' -%}
        <a class="ui-pill" href="#{{ faq_topic_parts[2] }}">{{ faq_topic_parts[0] }}</a>
      {%- endfor -%}
    </nav>
  </header>

  <div class="faq-page__content">
    <div class="faq-page__column">{{ faq_blocks }}</div>
  </div>

  <div class="faq-page__contact">
    {%- assign faq_contact_url = section.settings.contact_url | default: pages.contact.url -%}
    {%- render 'ui-support-band',
      heading: section.settings.contact_heading,
      text: section.settings.contact_text,
      primary_label: section.settings.contact_label,
      primary_url: faq_contact_url
    -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.faq.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 50,
  "blocks": [{ "type": "_faq-topic" }, { "type": "_faq-item" }],
  "settings": [
    { "type": "text", "id": "kicker", "label": "t:sections.faq.settings.kicker.label", "default": "Help center" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.faq.settings.heading.label",
      "default": "Frequently asked questions"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:sections.faq.settings.subtitle.label",
      "default": "Everything about shipping, returns, discounts, programs, sizing, gear, and who we are, in one place."
    },
    { "type": "header", "content": "t:sections.faq.settings.contact.content" },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "t:sections.faq.settings.contact_heading.label",
      "default": "Questions?"
    },
    {
      "type": "textarea",
      "id": "contact_text",
      "label": "t:sections.faq.settings.contact_text.label",
      "default": "Cannot find the answer you are looking for? Contact us. We are happy to help."
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "t:sections.faq.settings.contact_label.label",
      "default": "Contact us"
    },
    { "type": "url", "id": "contact_url", "label": "t:sections.faq.settings.contact_url.label" }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [
        { "type": "_faq-topic" },
        { "type": "_faq-item" },
        {
          "type": "_faq-item",
          "settings": {
            "question": "How quickly are orders dispatched?",
            "answer": "<p>Orders placed by 1pm Pacific time, Monday to Friday, go out the same day.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
