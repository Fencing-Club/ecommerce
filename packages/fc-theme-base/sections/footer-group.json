{
  "name": "t:sections.footer.name",
  "type": "footer",
  "sections": {
    "newsletter": {
      "type": "newsletter",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Get first access to new gear & restocks",
            "tag": "h2",
            "size": "lg"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Join the list for early drops, limited restocks, and fitting guides. No noise, just the essentials.</p>",
            "style": "subtle"
          }
        },
        "signup": {
          "type": "email-signup",
          "static": true,
          "settings": {
            "label": "Enter your email",
            "button_label": "Subscribe",
            "disclaimer": "We respect your privacy. Unsubscribe anytime."
          }
        }
      },
      "block_order": [
        "heading",
        "text"
      ],
      "settings": {
        "layout": "split"
      }
    },
    "footer": {
      "type": "footer",
      "blocks": {
        "brand": {
          "type": "_footer-brand",
          "static": true,
          "settings": {
            "show_social": true
          }
        },
        "shop": {
          "type": "_footer-menu",
          "settings": {
            "heading": "Shop",
            "menu": "footer-shop"
          }
        },
        "support": {
          "type": "_footer-menu",
          "settings": {
            "heading": "Support",
            "menu": "footer-support"
          }
        },
        "company": {
          "type": "_footer-menu",
          "settings": {
            "heading": "Company",
            "menu": "footer-company"
          }
        },
        "contact": {
          "type": "_footer-contact",
          "static": true,
          "settings": {
            "heading": "Contact"
          }
        }
      },
      "block_order": [
        "shop",
        "support",
        "company"
      ],
      "settings": {
        "copyright_name": "Fencing Club",
        "payment_enable": true
      }
    }
  },
  "order": [
    "newsletter",
    "footer"
  ]
}
