{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'section-main-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" type="module"></script>
<script src="{{ 'collection-load-more.js' | asset_url }}" type="module"></script>
<script src="{{ 'collection-page.js' | asset_url }}" type="module"></script>
{%- unless section.settings.quick_add == 'none' -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- render 'quick-view-dialog' -%}
{%- endunless -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    --collection-mobile-columns: {{ section.settings.columns_mobile }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div class="collection-product-area section-{{ section.id }}-padding">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if settings.structured_data_enabled -%}
        {%- assign structured_data_position_offset = paginate.current_page
          | minus: 1
          | times: paginate.page_size
        -%}
        {%- render 'structured-data',
          collection_item_list_enabled: true,
          collection_item_list: collection.products,
          collection_item_count: paginate.items,
          collection_position_offset: structured_data_position_offset
        -%}
      {%- endif -%}
      {%- liquid
        assign filters_id = 'CollectionFilters-' | append: section.id
        assign guide_url = blank
        if section.settings.guide_anchor != blank
          assign guide_url = '#' | append: section.settings.guide_anchor
        endif
        assign toolbar_filters_id = blank
        assign filter_drawer = blank
      -%}
      {%- if section.settings.enable_filtering -%}
        {%- comment -%}
          Phones pick filters in a drawer and apply them together; collection-filters.js builds the URL on Apply.
        {%- endcomment -%}
        {%- liquid
          assign toolbar_filters_id = filters_id
          assign mobile_filter_id = section.id | append: '-mobile'
          assign filter_drawer_id = 'CollectionFilterDrawer-' | append: section.id
          assign filter_title = 'collections.toolbar.filters' | t
          assign filter_close_label = 'accessibility.close' | t
          assign filter_remove_label = 'products.facets.clear_all' | t
          assign filter_apply_label = 'products.facets.apply' | t
          assign filter_count_label = 'products.facets.product_count_simple' | t: count: collection.products_count
        -%}
        {%- capture filter_trigger -%}
          <button
            type="button"
            class="collection-toolbar__drawer-trigger"
            data-drawer-open
            aria-controls="{{ filter_drawer_id }}"
            aria-expanded="false"
            aria-haspopup="dialog"
          >
            {%- render 'ui-icon', icon: 'sliders-horizontal', size: 16 -%}
            <span>{{ filter_title }}</span>
          </button>
        {%- endcapture -%}
        {%- capture filter_content -%}
          {%- render 'collection-facet-filters', results: collection, section_id: mobile_filter_id, show_categories: true -%}
        {%- endcapture -%}
        {%- capture filter_footer -%}
          {%- render 'ui-button',
            label: filter_remove_label,
            url: collection.url,
            variant: 'outline',
            size: 'md',
            additional_props: 'data-clear-collection-filters'
          -%}
          {%- render 'ui-button',
            label: filter_apply_label,
            variant: 'primary',
            size: 'md',
            additional_props: 'data-apply-collection-filters'
          -%}
        {%- endcapture -%}
        {%- capture filter_drawer -%}
          {%- render 'ui-drawer',
            id: filter_drawer_id,
            title: filter_title,
            description: filter_count_label,
            close_label: filter_close_label,
            content: filter_content,
            footer: filter_footer,
            trigger: filter_trigger
          -%}
        {%- endcapture -%}
      {%- endif -%}

      <div class="collection-toolbar-band">
        {%- render 'collection-toolbar',
          results: collection,
          section_id: section.id,
          filters_id: toolbar_filters_id,
          filter_drawer: filter_drawer,
          enable_sorting: section.settings.enable_sorting,
          sort_label: section.settings.sort_label,
          guide_url: guide_url
        -%}
      </div>

      <div class="collection-layout{% unless section.settings.enable_filtering %} collection-layout--no-filters{% endunless %}" data-collection-layout>
        {%- if section.settings.enable_filtering -%}
          <aside
            class="collection-filter-panel"
            id="{{ filters_id }}"
            aria-label="{{ 'collections.toolbar.filters' | t }}"
            data-id="{{ section.id }}"
          >
            {%- comment -%} The filter groups' h3 names sit under this heading, not straight under the page's h1. {%- endcomment -%}
            <h2 class="visually-hidden">{{ 'collections.toolbar.filters' | t }}</h2>
            {%- assign desktop_filter_id = section.id | append: '-desktop' -%}
            {%- render 'collection-facet-filters', results: collection, section_id: desktop_filter_id, show_categories: true -%}
          </aside>
        {%- endif -%}

        <div class="collection-grid-column product-grid-container" id="ProductGridContainer">
          {%- render 'collection-active-filters', results: collection, clear_url: collection.url -%}

          {%- if collection.products.size == 0 -%}
            {%- render 'collection-no-results',
              results: collection,
              section_id: section.id,
              clear_url: collection.url,
              contact_url: section.settings.contact_url
            -%}
          {%- else -%}
            <div class="loading-overlay gradient"></div>
            {%- comment -%} The cards' h3 names sit under this heading, not straight under the page's h1. {%- endcomment -%}
            <h2 class="visually-hidden">{{ 'collections.grid_heading' | t }}</h2>
            <ul id="product-grid" data-id="{{ section.id }}" class="collection-product-grid list-unstyled">
              {%- for product in collection.products -%}
                {%- liquid
                  assign show_add = false
                  unless section.settings.quick_add == 'none'
                    assign show_add = true
                  endunless
                  assign card_id = 'CollectionProduct-' | append: section.id | append: '-' | append: product.id
                  # The first page's first row shows at load; its first photo is the page's largest image.
                  assign card_loading = 'lazy'
                  assign card_fetchpriority = 'auto'
                  if paginate.current_page == 1 and forloop.index <= 4
                    assign card_loading = 'eager'
                    if forloop.first
                      assign card_fetchpriority = 'high'
                    endif
                  endif
                -%}
                <li>
                  {%- render 'ui-product-card',
                    product: product,
                    card_id: card_id,
                    show_price: true,
                    show_add: show_add,
                    quick_view: show_add,
                    add_label: section.settings.add_label,
                    section_id: section.id,
                    image_sizes: '(min-width: 990px) 300px, (min-width: 750px) calc((100vw - 104px) / 2), calc((100vw - 52px) / 2)',
                    image_widths: '300, 450, 600',
                    image_loading: card_loading,
                    image_fetchpriority: card_fetchpriority
                  -%}
                </li>
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              {%- liquid
                assign shown = paginate.current_offset | plus: collection.products.size
                assign progress = shown | times: 100 | divided_by: paginate.items
              -%}
              <collection-load-more class="collection-load-more" data-section-id="{{ section.id }}">
                <p class="collection-load-more__status">{{ 'collections.load_more.showing' | t: shown: shown, total: paginate.items }}</p>
                <span class="collection-load-more__bar" aria-hidden="true"><span style="width: {{ progress }}%"></span></span>
                {%- render 'ui-pagination',
                  paginate: paginate,
                  anchor: 'product-grid',
                  mode: 'next',
                  next_label: section.settings.load_more_label,
                  class: 'collection-load-more__pagination'
                -%}
              </collection-load-more>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</collection-component>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "standard",
      "label": "t:sections.main-collection-product-grid.settings.quick_add.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_1"
        },
        {
          "value": "standard",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_2"
        }
      ]
    },
    { "type": "text", "id": "add_label", "label": "Add button label", "default": "Add to cart" },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    { "type": "text", "id": "sort_label", "label": "Sort prefix", "default": "Sort:" },
    { "type": "text", "id": "load_more_label", "label": "Next page label", "default": "Load more" },
    {
      "type": "text",
      "id": "guide_anchor",
      "label": "Buying guide anchor",
      "info": "The protection levels help links to the buying guide section with this anchor.",
      "default": "BuyingGuide"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Ask us to find it link",
      "info": "Shown when filters leave nothing. Leave empty to hide the button."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ]
}
{% endschema %}
