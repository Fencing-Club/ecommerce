{{ 'section-home.css' | asset_url | stylesheet_tag }}

<div class="home-section why-us">
  <div class="why-us__media">{%- content_for 'block', type: 'image', id: 'image' -%}</div>
  <div class="why-us__content">{%- content_for 'blocks' -%}</div>
</div>

{% stylesheet %}
  .home-section.why-us {
    display: grid;
    grid-template-columns: calc(var(--spacing) * 130) minmax(0, 1fr);
    gap: var(--spacing-14);
    align-items: start;
    padding-block: var(--spacing-20);
  }
  .why-us__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-5);
  }
  @media (max-width: 1199px) {
    .home-section.why-us {
      grid-template-columns: calc(var(--spacing) * 100) minmax(0, 1fr);
      gap: var(--spacing-10);
    }
  }
  @media (max-width: 989px) {
    .home-section.why-us { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 749px) {
    .home-section.why-us { padding-block: var(--spacing-14); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.why_us.name",
  "tag": "section",
  "blocks": [{ "type": "@theme" }],
  "presets": [
    {
      "name": "t:sections.why_us.name",
      "blocks": [
        { "type": "image", "id": "image", "static": true, "settings": { "aspect_ratio": "landscape" } },
        { "type": "text", "settings": { "text": "<p>Why Fencing Club</p>", "style": "eyebrow" } },
        { "type": "heading", "settings": { "heading": "Trusted by competitive fencers", "size": "lg" } },
        { "type": "text", "settings": { "text": "<p>Competition-grade equipment, tested by fencers and trusted by clubs.</p>", "style": "subtle" } },
        {
          "type": "group",
          "settings": { "direction": "row", "gap": "md", "align": "start" },
          "blocks": [
            { "type": "feature", "settings": { "icon": "badge-check", "label": "Expert advice", "detail": "Guidance from national-level fencers" } },
            { "type": "feature", "settings": { "icon": "truck", "label": "Fast shipping", "detail": "Ships in 1 business day" } },
            { "type": "feature", "settings": { "icon": "rotate-ccw", "label": "Easy returns", "detail": "30 days, postage paid" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
