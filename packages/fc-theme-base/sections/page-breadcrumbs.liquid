{%- liquid
  assign current_label = page.title
  assign parent_page = section.settings.parent_page
  if request.page_type == 'metaobject' and metaobject.system.type == 'size_chart'
    assign current_label = metaobject.title.value
    if parent_page == blank
      assign parent_page = settings.size_chart_index_page | default: pages['size-charts']
    endif
  endif
-%}
{%- comment -%}
  The breadcrumb band under the header, on the page gutter. A page template adds it as its first section.
{%- endcomment -%}
<div class="page-breadcrumbs">
  {%- assign home_label = 'general.breadcrumb_home' | t -%}
  {%- render 'ui-breadcrumbs',
    root_label: home_label,
    root_url: routes.root_url,
    parent_label: parent_page.title,
    parent_url: parent_page.url,
    current_label: current_label
  -%}
</div>

{% stylesheet %}
  .page-breadcrumbs {
    padding: var(--spacing-4) var(--page-gutter);
    background: var(--background);
  }
  .page-breadcrumbs .ui-breadcrumbs {
    flex-wrap: wrap;
  }
  .page-breadcrumbs [aria-current] {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media screen and (min-width: 990px) {
    .page-breadcrumbs {
      padding-block: calc(var(--spacing) * 4.5);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.page_breadcrumbs.name",
  "tag": "section",
  "settings": [
    {
      "type": "page",
      "id": "parent_page",
      "label": "t:sections.page_breadcrumbs.settings.parent_page.label",
      "info": "t:sections.page_breadcrumbs.settings.parent_page.info"
    }
  ],
  "presets": [{ "name": "t:sections.page_breadcrumbs.name" }]
}
{% endschema %}
