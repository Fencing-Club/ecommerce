{
  "name": "@repo/fc-theme-base",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check:theme": "shopify theme check --path .",
    "dev": "shopify theme dev --path .",
    "package": "shopify theme package --path .",
    "pull": "shopify theme pull --path .",
    "push": "shopify theme push --path .",
    "content:build": "node content/build-manifest.mjs",
    "lab": "node tests/component-library.mjs",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "storybook": "storybook dev -p 6107",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@shopify/cli": "^4.9.4",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/html-vite": "10.6.7",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "^21.0.4",
    "liquidjs": "^10.30.1",
    "playwright": "1.65.1",
    "storybook": "10.6.7",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  }
}
