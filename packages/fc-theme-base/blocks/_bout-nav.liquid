{%- comment -%}
  The About hero's row of chapter links, one `_bout-link` per call of the bout. The first link is the chapter you're
  in, so it carries the heavier rule. Phones scroll the row sideways.
{%- endcomment -%}
<nav class="about-bout-nav" aria-label="{{ 'sections.about_hero.chapters' | t }}" {{ block.shopify_attributes }}>
  {%- content_for 'blocks' -%}
</nav>

{% stylesheet %}
  .about-bout-nav {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
  }
  .about-bout-nav > :first-child .about-bout-link {
    border-top: 2px solid var(--foreground);
    padding-top: calc(var(--spacing-5) + 1px);
  }
  .about-bout-nav > :first-child .about-bout-link__call {
    color: var(--foreground);
  }
  @media (max-width: 749px) {
    .about-bout-nav {
      grid-auto-columns: calc(var(--spacing) * 33);
      gap: var(--spacing-5);
      margin-inline: calc(var(--page-gutter) * -1);
      padding-inline: var(--page-gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .about-bout-nav > :first-child .about-bout-link {
      padding-top: calc(var(--spacing-4) - 1px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.bout_nav.name",
  "blocks": [{ "type": "_bout-link" }],
  "presets": [
    {
      "name": "t:blocks.bout_nav.name",
      "blocks": [{ "type": "_bout-link" }]
    }
  ]
}
{% endschema %}
