{%- comment -%}
  The About hero's row of chapter links, one `_bout-link` per call of the bout. The first link is the chapter you're
  in, so it carries the heavier rule. Phones scroll the row sideways.
{%- endcomment -%}
<nav class="about-bout-nav" aria-label="{{ 'sections.about_hero.chapters' | t }}" {{ block.shopify_attributes }}>
  {%- content_for 'blocks' -%}
</nav>

{% schema %}
{
  "name": "t:blocks.bout_nav.name",
  "blocks": [{ "type": "_bout-link" }],
  "presets": [
    {
      "name": "t:blocks.bout_nav.name",
      "blocks": [{ "type": "_bout-link" }]
    }
  ]
}
{% endschema %}
