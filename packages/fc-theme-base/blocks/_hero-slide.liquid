{%- comment -%}
  One hero slide: a full-bleed photo under a dark scrim, with the blocks inside it on the page gutter. Text inside the
  slide turns light. The section's carousel fades between slides.
{%- endcomment -%}
{%- liquid
  # The first slide's photo is the page's largest image, so it loads first and at high priority.
  assign slide_loading = 'lazy'
  assign slide_priority = 'auto'
  if section.blocks.first.id == block.id
    assign slide_loading = 'eager'
    assign slide_priority = 'high'
  endif
  # A focal point set in admin decides the crop; without one, CSS keeps the upper part.
  assign focal_point = block.settings.image.presentation.focal_point
  assign focal_style = nil
  if focal_point != blank and focal_point != '50.0% 50.0%'
    assign focal_style = 'object-position: ' | append: focal_point
  endif
-%}
<div class="hero-slide" data-carousel-slide role="group" aria-roledescription="slide" {{ block.shopify_attributes }}>
  {%- if block.settings.image -%}
    {{
      block.settings.image
      | image_url: width: 2880
      | image_tag:
        class: 'hero-slide__image',
        widths: '750, 1100, 1440, 2160, 2880',
        sizes: '100vw',
        alt: block.settings.image.alt,
        loading: slide_loading,
        fetchpriority: slide_priority,
        style: focal_style
    }}
  {%- endif -%}
  {%- comment -%}
    A page has one level 1 heading. Only the first slide's heading can be it, so later slides step a level 1 heading
    down to level 2.
  {%- endcomment -%}
  {%- capture slide_blocks -%}{%- content_for 'blocks' -%}{%- endcapture -%}
  {%- unless section.blocks.first.id == block.id -%}
    {%- assign slide_blocks = slide_blocks | replace: '<h1 ', '<h2 ' | replace: '<h1>', '<h2>' | replace: '</h1>', '</h2>' -%}
  {%- endunless -%}
  <div class="hero-slide__content">
    <div class="hero-slide__inner">{{ slide_blocks }}</div>
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.hero_slide.name",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:blocks.hero_slide.settings.image.label",
      "info": "t:blocks.hero_slide.settings.image.info"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.hero_slide.name",
      "blocks": [
        { "type": "text", "settings": { "text": "<p>New release</p>", "style": "eyebrow" } },
        { "type": "heading", "settings": { "heading": "Gear for every bout", "tag": "h2", "size": "xl" } },
        { "type": "text", "settings": { "text": "<p>Competition equipment for fencers at every level.</p>" } },
        {
          "type": "group",
          "settings": { "direction": "row", "gap": "md", "align": "center" },
          "blocks": [
            { "type": "button", "settings": { "label": "Shop now", "style": "secondary", "size": "lg" } },
            { "type": "link", "settings": { "label": "Learn more" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
