{%- comment -%}
  A figure on the About page's scoreboard: a number and what it counts.
{%- endcomment -%}
<div class="about-stat" {{ block.shopify_attributes }}>
  <p class="about-stat__number">{{ block.settings.number | escape }}</p>
  <p class="about-stat__label">{{ block.settings.label | escape }}</p>
</div>

{% schema %}
{
  "name": "t:blocks.stat.name",
  "settings": [
    {
      "type": "text",
      "id": "number",
      "label": "t:blocks.stat.settings.number.label",
      "default": "t:blocks.stat.settings.number.default"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.stat.settings.label.label",
      "default": "t:blocks.stat.settings.label.default"
    }
  ],
  "presets": [{ "name": "t:blocks.stat.name" }]
}
{% endschema %}
