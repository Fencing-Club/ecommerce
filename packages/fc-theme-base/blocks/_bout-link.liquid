{%- comment -%}
  A chapter link in the About hero: the call, such as Prêts, over what that chapter covers.
{%- endcomment -%}
<a class="about-bout-link" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
  <span class="about-bout-link__call">{{ block.settings.call | escape }}</span>
  <span class="about-bout-link__topic">{{ block.settings.topic | escape }}</span>
</a>

{% stylesheet %}
  .about-bout-link {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1-5);
    height: 100%;
    padding: var(--spacing-5) var(--spacing-6) var(--spacing-9) 0;
    border-top: 1px solid color-mix(in srgb, var(--foreground) 18%, transparent);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }
  .about-bout-link__call {
    font-size: calc(var(--spacing) * 4.25);
    line-height: var(--leading-snug);
    font-weight: var(--font-weight-semibold);
    color: color-mix(in srgb, var(--foreground) 80%, transparent);
    transition: color 0.2s ease;
  }
  .about-bout-link__topic {
    font-size: calc(var(--spacing) * 3.25);
    line-height: var(--leading-normal);
    color: var(--muted-foreground);
  }
  .about-bout-link:hover {
    border-top-color: color-mix(in srgb, var(--foreground) 60%, transparent);
  }
  .about-bout-link:hover .about-bout-link__call {
    color: var(--foreground);
  }
  .about-bout-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }
  @media (max-width: 749px) {
    .about-bout-link {
      gap: var(--spacing-1);
      padding: var(--spacing-4) 0 var(--spacing-6);
    }
    .about-bout-link__call { font-size: calc(var(--spacing) * 3.75); }
    .about-bout-link__topic { font-size: var(--text-xs); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.bout_link.name",
  "settings": [
    {
      "type": "text",
      "id": "call",
      "label": "t:blocks.bout_link.settings.call.label",
      "default": "Allez"
    },
    {
      "type": "text",
      "id": "topic",
      "label": "t:blocks.bout_link.settings.topic.label",
      "default": "How far we've come"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.bout_link.settings.link.label",
      "info": "t:blocks.bout_link.settings.link.info"
    }
  ],
  "presets": [{ "name": "t:blocks.bout_link.name" }]
}
{% endschema %}
