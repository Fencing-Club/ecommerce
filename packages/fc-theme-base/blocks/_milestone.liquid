{%- comment -%}
  A milestone on the About page's timeline: when it happened, a dot on the shaded track and what happened. The line
  into a dot is solid unless the milestone is planned; the line out is solid only once it's done. One in progress has
  a ringed dot and an In progress pill; a planned one has a hollow dot, softer text and a Planned pill. Phones put the
  date over the title, beside the track.
{%- endcomment -%}
{%- liquid
  assign status = block.settings.status | default: 'done'
-%}
<div class="about-milestone about-milestone--{{ status | replace: '_', '-' }}" {{ block.shopify_attributes }}>
  <p class="about-milestone__when">
    <span class="about-milestone__date">{{ block.settings.date | escape }}</span>
    {%- case status -%}
      {%- when 'in_progress' -%}
        <span class="about-milestone__pill">{{ 'sections.about_timeline.in_progress' | t }}</span>
      {%- when 'planned' -%}
        <span class="about-milestone__pill">{{ 'sections.about_timeline.planned' | t }}</span>
    {%- endcase -%}
  </p>
  <span class="about-milestone__track" aria-hidden="true"><span class="about-milestone__dot"></span></span>
  <div class="about-milestone__copy">
    <h3 class="about-milestone__title">{{ block.settings.title | escape }}</h3>
    {%- if block.settings.text != blank -%}
      <p class="about-milestone__text">{{ block.settings.text | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.milestone.name",
  "settings": [
    {
      "type": "text",
      "id": "date",
      "label": "t:blocks.milestone.settings.date.label",
      "default": "t:blocks.milestone.settings.date.default"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:blocks.milestone.settings.title.label",
      "default": "t:blocks.milestone.settings.title.default"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:blocks.milestone.settings.text.label"
    },
    {
      "type": "select",
      "id": "status",
      "label": "t:blocks.milestone.settings.status.label",
      "default": "done",
      "options": [
        { "value": "done", "label": "t:blocks.milestone.settings.status.options.done" },
        { "value": "in_progress", "label": "t:blocks.milestone.settings.status.options.in_progress" },
        { "value": "planned", "label": "t:blocks.milestone.settings.status.options.planned" }
      ]
    }
  ],
  "presets": [{ "name": "t:blocks.milestone.name" }]
}
{% endschema %}
