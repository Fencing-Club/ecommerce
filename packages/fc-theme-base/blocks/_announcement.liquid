{%- comment -%}
  One announcement in the announcement bar: a ui-banner in the announcement's tone. The bar fades between them.
  A free shipping announcement takes its minimum from Theme settings > Cart, as the cart does, and only shoppers who
  get free shipping see it (snippets/cart-free-shipping.liquid).
{%- endcomment -%}
{%- liquid
  assign title = block.settings.title
  assign message = block.settings.message
  assign shown = true
  if block.settings.content == 'free_shipping'
    capture free_shipping
      render 'cart-free-shipping'
    endcapture
    assign free_shipping = free_shipping | plus: 0
    assign shown = false
    if free_shipping > 0
      assign shown = true
      assign amount = free_shipping | money_without_trailing_zeros
      assign title = 'sections.announcement_bar.free_shipping_title' | t
      assign message = 'sections.announcement_bar.free_shipping_message' | t: amount: amount
    endif
  endif
-%}
{%- if shown -%}
  <div
    class="announcement"
    data-carousel-slide
    role="group"
    aria-roledescription="{{ 'sections.announcement_bar.slide' | t }}"
    {{ block.shopify_attributes }}
  >
    {%- render 'ui-banner',
      title: title,
      message: message,
      link_label: block.settings.link_label,
      url: block.settings.link,
      tone: block.settings.tone
    -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement {
    display: flex;
    flex: 1 1 auto;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-enter) var(--ease-in-out),
      visibility 0s linear var(--duration-enter);
  }
  .announcement.is-active,
  fc-carousel:not(:defined) > [data-carousel-track] > :first-child .announcement,
  [data-carousel-track] > :only-child .announcement {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--duration-enter) var(--ease-in-out),
      visibility 0s;
  }
  .announcement > .ui-banner {
    flex: 1 1 auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .announcement,
    .announcement.is-active { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.announcement.name",
  "settings": [
    {
      "type": "select",
      "id": "content",
      "label": "t:blocks.announcement.settings.content.label",
      "info": "t:blocks.announcement.settings.content.info",
      "default": "custom",
      "options": [
        { "value": "custom", "label": "t:blocks.announcement.settings.content.options__custom" },
        { "value": "free_shipping", "label": "t:blocks.announcement.settings.content.options__free_shipping" }
      ]
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:blocks.announcement.settings.title.label",
      "default": "Hassle-free returns",
      "visible_if": "{{ block.settings.content == 'custom' }}"
    },
    {
      "type": "text",
      "id": "message",
      "label": "t:blocks.announcement.settings.message.label",
      "default": "30-day postage paid returns",
      "visible_if": "{{ block.settings.content == 'custom' }}"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:blocks.announcement.settings.tone.label",
      "info": "t:blocks.announcement.settings.tone.info",
      "default": "default",
      "options": [
        { "value": "default", "label": "t:blocks.announcement.settings.tone.options__default" },
        { "value": "sale", "label": "t:blocks.announcement.settings.tone.options__sale" },
        { "value": "event", "label": "t:blocks.announcement.settings.tone.options__event" },
        { "value": "vacation", "label": "t:blocks.announcement.settings.tone.options__vacation" }
      ]
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.announcement.settings.link.label"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:blocks.announcement.settings.link_label.label",
      "info": "t:blocks.announcement.settings.link_label.info"
    }
  ],
  "presets": [{ "name": "t:blocks.announcement.name" }]
}
{% endschema %}
