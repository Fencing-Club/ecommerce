{% doc %}
  The product details section's Reviews: the reviews app's block, under a heading, with the review count from the
  app's rating_count field in its label. Renders nothing until the product has a review and an app block is added.
{% enddoc %}
{%- assign count = product.metafields.reviews.rating_count.value | default: 0 -%}
{%- capture reviews -%}
  {%- if count > 0 -%}{%- content_for 'blocks' -%}{%- endif -%}
{%- endcapture -%}
{%- if reviews != blank -%}
  {%- liquid
    assign label = 'products.details.reviews.label_count' | t: count: count
    assign heading = 'products.details.reviews.heading' | t
  -%}
  {%- render 'product-details-part',
    id: 'product-reviews',
    label: label,
    heading: heading,
    content: reviews,
    block: block
  -%}
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_reviews.name",
  "blocks": [{ "type": "@app" }],
  "settings": [],
  "presets": [{ "name": "t:blocks.product_reviews.name" }]
}
{% endschema %}
