{%- comment -%}
  The dark band under the About page's clubs, such as the offer to drop orders off at them.
{%- endcomment -%}
<div class="about-callout about-dark" {{ block.shopify_attributes }}>
  <span class="about-callout__icon">{%- render 'ui-icon', icon: 'truck', size: 24 -%}</span>
  <div class="about-callout__copy">
    <h3 class="about-callout__title">{{ block.settings.title | escape }}</h3>
    {%- if block.settings.text != blank -%}
      <p class="about-callout__text">{{ block.settings.text | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.clubs_callout.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:blocks.clubs_callout.settings.title.label",
      "default": "t:blocks.clubs_callout.settings.title.default"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:blocks.clubs_callout.settings.text.label"
    }
  ],
  "presets": [{ "name": "t:blocks.clubs_callout.name" }]
}
{% endschema %}
