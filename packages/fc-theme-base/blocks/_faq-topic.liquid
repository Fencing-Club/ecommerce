{%- comment -%}
  A topic heading on the FAQ page. The questions after it, up to the next topic, belong to it, and the topic links
  above the questions jump to it.
{%- endcomment -%}
{%- comment -%} The section reads the title and anchor from data-faq-topic and id, in that order. {%- endcomment -%}
<h2
  class="faq-topic"
  data-faq-topic="{{ block.settings.title | escape }}"
  id="{{ block.settings.title | handleize }}"
  {{ block.shopify_attributes }}
>
  {{- block.settings.title | escape -}}
</h2>

{% stylesheet %}
  .faq-topic {
    margin: 0;
    padding-bottom: var(--spacing-3-5);
    scroll-margin-top: var(--spacing-5);
    font-family: var(--font-body-family);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .shopify-block:not(:first-child):has(> .faq-topic) {
    margin-top: var(--spacing-12);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.faq_topic.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:blocks.faq_topic.settings.title.label",
      "default": "Shipping"
    }
  ],
  "presets": [{ "name": "t:blocks.faq_topic.name" }]
}
{% endschema %}
