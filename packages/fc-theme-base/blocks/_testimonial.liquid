{%- comment -%}
  One customer quote with an optional star rating. The section's carousel moves between them.
{%- endcomment -%}
<figure class="testimonial" data-carousel-slide {{ block.shopify_attributes }}>
  {%- if block.settings.rating > 0 -%}
    <span class="testimonial__stars" role="img" aria-label="{{ 'blocks.testimonial.rating' | t: rating: block.settings.rating }}">
      {%- for star in (1..block.settings.rating) -%}
        {%- render 'ui-icon', icon: 'star', size: 16 -%}
      {%- endfor -%}
    </span>
  {%- endif -%}
  <blockquote class="testimonial__quote">{{ block.settings.quote | escape }}</blockquote>
  <figcaption class="testimonial__by">
    <span class="testimonial__name">{{ block.settings.name | escape }}</span>
    {%- if block.settings.role != blank -%}
      <span class="testimonial__role">{{ block.settings.role | escape }}</span>
    {%- endif -%}
  </figcaption>
</figure>

{% stylesheet %}
  .testimonial {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
    margin: 0;
    padding: var(--spacing-8);
    border-radius: var(--radius-xl);
    background: var(--muted);
    color: var(--foreground);
  }
  .testimonial__stars {
    display: flex;
    gap: var(--spacing-1);
  }
  .testimonial__quote {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: var(--text-lg);
    font-style: normal;
    line-height: var(--leading-normal);
  }
  .testimonial__by {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-0-5);
    margin-top: auto;
  }
  .testimonial__name {
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    font-weight: var(--font-weight-semibold);
  }
  .testimonial__role {
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--muted-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.testimonial.name",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "t:blocks.testimonial.settings.quote.label",
      "default": "t:blocks.testimonial.settings.quote.default"
    },
    {
      "type": "text",
      "id": "name",
      "label": "t:blocks.testimonial.settings.name.label",
      "default": "t:blocks.testimonial.settings.name.default"
    },
    {
      "type": "text",
      "id": "role",
      "label": "t:blocks.testimonial.settings.role.label"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "t:blocks.testimonial.settings.rating.label",
      "info": "t:blocks.testimonial.settings.rating.info",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    }
  ],
  "presets": [{ "name": "t:blocks.testimonial.name" }]
}
{% endschema %}
