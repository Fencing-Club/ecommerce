{%- comment -%}
  Lays out the blocks inside it in a column or a row. Rows wrap when they run out of room.
{%- endcomment -%}
{%- liquid
  assign classes = 'block-group block-group--' | append: block.settings.direction
  assign classes = classes | append: ' block-group--gap-' | append: block.settings.gap
  assign classes = classes | append: ' block-group--align-' | append: block.settings.align
  assign classes = classes | append: ' block-group--justify-' | append: block.settings.justify
-%}
<div class="{{ classes }}" {{ block.shopify_attributes }}>
  {%- content_for 'blocks' -%}
</div>

{% stylesheet %}
  .block-group {
    display: flex;
    min-width: 0;
  }
  .block-group--column { flex-direction: column; }
  .block-group--row {
    flex-direction: row;
    flex-wrap: wrap;
  }
  .block-group--gap-sm { gap: var(--spacing-2); }
  .block-group--gap-md { gap: var(--spacing-4); }
  .block-group--gap-lg { gap: var(--spacing-6); }
  .block-group--gap-xl { gap: var(--spacing-10); }
  .block-group--align-start { align-items: flex-start; }
  .block-group--align-center { align-items: center; }
  .block-group--align-end { align-items: flex-end; }
  .block-group--align-stretch { align-items: stretch; }
  .block-group--justify-start { justify-content: flex-start; }
  .block-group--justify-center { justify-content: center; }
  .block-group--justify-end { justify-content: flex-end; }
  .block-group--justify-between { justify-content: space-between; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.group.name",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "select",
      "id": "direction",
      "label": "t:blocks.group.settings.direction.label",
      "default": "column",
      "options": [
        { "value": "column", "label": "t:blocks.group.settings.direction.options.column" },
        { "value": "row", "label": "t:blocks.group.settings.direction.options.row" }
      ]
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:blocks.group.settings.gap.label",
      "default": "md",
      "options": [
        { "value": "sm", "label": "t:blocks.all.size.options.sm" },
        { "value": "md", "label": "t:blocks.all.size.options.md" },
        { "value": "lg", "label": "t:blocks.all.size.options.lg" },
        { "value": "xl", "label": "t:blocks.all.size.options.xl" }
      ]
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:blocks.group.settings.align.label",
      "info": "t:blocks.group.settings.align.info",
      "default": "stretch",
      "options": [
        { "value": "start", "label": "t:blocks.group.settings.position.start" },
        { "value": "center", "label": "t:blocks.group.settings.position.center" },
        { "value": "end", "label": "t:blocks.group.settings.position.end" },
        { "value": "stretch", "label": "t:blocks.group.settings.position.stretch" }
      ]
    },
    {
      "type": "select",
      "id": "justify",
      "label": "t:blocks.group.settings.justify.label",
      "info": "t:blocks.group.settings.justify.info",
      "default": "start",
      "options": [
        { "value": "start", "label": "t:blocks.group.settings.position.start" },
        { "value": "center", "label": "t:blocks.group.settings.position.center" },
        { "value": "end", "label": "t:blocks.group.settings.position.end" },
        { "value": "between", "label": "t:blocks.group.settings.position.between" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:blocks.group.name",
      "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }]
    }
  ]
}
{% endschema %}
