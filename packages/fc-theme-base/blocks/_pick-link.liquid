{%- comment -%}
  A pill link inside a featured pick card.
{%- endcomment -%}
{%- if block.settings.label != blank -%}
  {%- render 'ui-pill', label: block.settings.label, url: block.settings.link, icon: 'arrow-up-right', block_attributes: block.shopify_attributes -%}
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.pick_link.name",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.pick_link.settings.label.label",
      "default": "t:blocks.pick_link.settings.label.default"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.pick_link.settings.link.label"
    }
  ],
  "presets": [{ "name": "t:blocks.pick_link.name" }]
}
{% endschema %}
