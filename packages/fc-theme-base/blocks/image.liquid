{%- assign image = block.settings.image -%}
<div class="block-image block-image--{{ block.settings.aspect_ratio }}" {{ block.shopify_attributes }}>
  {%- if image != blank -%}
    {{
      image
      | image_url: width: 1600
      | image_tag:
        class: 'block-image__media',
        widths: '400, 800, 1200, 1600',
        sizes: '(min-width: 990px) 50vw, 100vw',
        alt: image.alt,
        loading: 'lazy'
    }}
  {%- else -%}
    {{ 'image' | placeholder_svg_tag: 'block-image__media block-image__placeholder' }}
  {%- endif -%}
</div>

{% stylesheet %}
  .block-image {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--muted);
  }
  .block-image--square { aspect-ratio: 1; }
  .block-image--portrait { aspect-ratio: 4 / 5; }
  .block-image--landscape,
  .block-image--adapt:has(.block-image__placeholder) { aspect-ratio: 3 / 2; }
  .block-image--wide { aspect-ratio: 16 / 9; }
  .block-image__media {
    display: block;
    width: 100%;
    height: auto;
  }
  .block-image:not(.block-image--adapt) .block-image__media,
  .block-image__placeholder {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
  }
  .block-image__placeholder { fill: var(--muted-foreground); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.image.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:blocks.image.settings.image.label"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:blocks.image.settings.aspect_ratio.label",
      "default": "adapt",
      "options": [
        { "value": "adapt", "label": "t:blocks.image.settings.aspect_ratio.options.adapt" },
        { "value": "square", "label": "t:blocks.image.settings.aspect_ratio.options.square" },
        { "value": "portrait", "label": "t:blocks.image.settings.aspect_ratio.options.portrait" },
        { "value": "landscape", "label": "t:blocks.image.settings.aspect_ratio.options.landscape" },
        { "value": "wide", "label": "t:blocks.image.settings.aspect_ratio.options.wide" }
      ]
    }
  ],
  "presets": [{ "name": "t:blocks.image.name" }]
}
{% endschema %}
