{%- comment -%}
  A link styled as the theme's button. Without a link it shows disabled, so the merchant still sees it in the editor.
{%- endcomment -%}
{%- liquid
  assign trailing_icon = nil
  if block.settings.show_arrow
    assign trailing_icon = 'arrow-right'
  endif
  assign inactive = false
  if block.settings.link == blank
    assign inactive = true
  endif
-%}
{%- if block.settings.label != blank -%}
  <div class="block-button" {{ block.shopify_attributes }}>
    {%- render 'ui-button',
      label: block.settings.label,
      url: block.settings.link,
      variant: block.settings.style,
      size: block.settings.size,
      trailing_icon: trailing_icon,
      disabled: inactive
    -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .block-button { display: flex; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.button.name",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.button.settings.label.label",
      "default": "t:blocks.button.settings.label.default"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.button.settings.link.label"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.button.settings.style.label",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "t:blocks.button.settings.style.options.primary" },
        { "value": "secondary", "label": "t:blocks.button.settings.style.options.secondary" },
        { "value": "outline", "label": "t:blocks.button.settings.style.options.outline" }
      ]
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:blocks.all.size.label",
      "default": "md",
      "options": [
        { "value": "sm", "label": "t:blocks.all.size.options.sm" },
        { "value": "md", "label": "t:blocks.all.size.options.md" },
        { "value": "lg", "label": "t:blocks.all.size.options.lg" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "t:blocks.button.settings.show_arrow.label",
      "default": false
    }
  ],
  "presets": [{ "name": "t:blocks.button.name" }]
}
{% endschema %}
