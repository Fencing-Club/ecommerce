{%- liquid
  assign classes = 'block-text block-text--' | append: block.settings.style | append: ' block-text--' | append: block.settings.alignment
-%}
{%- if block.settings.text != blank -%}
  <div class="{{ classes }}" {{ block.shopify_attributes }}>
    {{- block.settings.text -}}
  </div>
{%- endif -%}

{% stylesheet %}
  .block-text {
    font-family: var(--font-body-family);
    overflow-wrap: anywhere;
  }
  .block-text > * { margin: 0; }
  .block-text > * + * { margin-top: var(--spacing-3); }
  .block-text a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: var(--spacing-0-5);
  }
  .block-text--body {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--foreground);
  }
  .block-text--lead {
    max-width: calc(var(--spacing) * 205);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--muted-foreground);
  }
  .block-text--subtle {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--muted-foreground);
  }
  .block-text--eyebrow {
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  /* A pull quote: a line from the copy set larger, with a rule beside it. */
  .block-text--quote {
    padding: var(--spacing-1) 0 var(--spacing-1) var(--spacing-8);
    border-inline-start: 3px solid var(--foreground);
    font-size: var(--text-3xl);
    line-height: 1.22;
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.027em;
    color: var(--foreground);
  }
  @media (max-width: 749px) {
    .block-text--quote {
      padding-inline-start: var(--spacing-5);
      font-size: var(--text-2xl);
      line-height: 1.25;
    }
  }
  .block-text--left { text-align: start; }
  .block-text--center { text-align: center; }
  .block-text--right { text-align: end; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.text.name",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:blocks.text.settings.text.label",
      "default": "t:blocks.text.settings.text.default"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.text.settings.style.label",
      "default": "body",
      "options": [
        { "value": "body", "label": "t:blocks.text.settings.style.options.body" },
        { "value": "lead", "label": "t:blocks.text.settings.style.options.lead" },
        { "value": "subtle", "label": "t:blocks.text.settings.style.options.subtle" },
        { "value": "eyebrow", "label": "t:blocks.text.settings.style.options.eyebrow" },
        { "value": "quote", "label": "t:blocks.text.settings.style.options.quote" }
      ]
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:blocks.all.alignment.label",
      "default": "left"
    }
  ],
  "presets": [{ "name": "t:blocks.text.name" }]
}
{% endschema %}
