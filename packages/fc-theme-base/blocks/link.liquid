{%- comment -%}
  A text link, such as "View all", with an optional trailing arrow.
{%- endcomment -%}
{%- liquid
  assign link_icon = nil
  if block.settings.show_arrow
    assign link_icon = 'arrow-right'
  endif
-%}
{%- if block.settings.label != blank -%}
  <span class="block-link" {{ block.shopify_attributes }}>
    {%- render 'ui-link', label: block.settings.label, url: block.settings.link, icon: link_icon -%}
  </span>
{%- endif -%}

{% stylesheet %}
  .block-link {
    display: inline-flex;
    flex: 0 0 auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.link.name",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.link.settings.label.label",
      "default": "t:blocks.link.settings.label.default"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.link.settings.link.label"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "t:blocks.link.settings.show_arrow.label",
      "default": true
    }
  ],
  "presets": [{ "name": "t:blocks.link.name" }]
}
{% endschema %}
