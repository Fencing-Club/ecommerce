    "principles": {
      "type": "about-principles",
      "blocks": {
        "phase": {
          "type": "phase-heading",
          "static": true,
          "settings": {
            "meaning": "Ready",
            "word": "Prêts",
            "tag": "h2"
          }
        },
        "lead": {
          "type": "text",
          "settings": {
            "text": "<p>Before the bout, you settle into your stance. Here's ours.</p>",
            "style": "body"
          },
          "static": true
        },
        "operations_heading": {
          "type": "heading",
          "settings": {
            "heading": "How we operate",
            "tag": "h3",
            "size": "sm"
          },
          "static": true
        },
        "operations_start": {
          "type": "text",
          "settings": {
            "text": "<p>We're a true direct retailer. We keep our own inventory at our own facility instead of dropshipping, and we work directly with manufacturing partners and established fencing brands around the world to keep quality consistent.</p>",
            "style": "lead"
          },
          "static": true
        },
        "operations_end": {
          "type": "text",
          "settings": {
            "text": "<p>Orders ship from fulfillment locations in the U.S. Sometimes a logistics partner handles delivery, but they only move the boxes; they never resell. Every question, order, and return comes back to our own team.</p>",
            "style": "lead"
          },
          "static": true
        },
        "company": {
          "type": "text",
          "settings": {
            "text": "<p>Fencing Club is operated by Fencing Club LLC, a Washington limited liability company.</p>",
            "style": "subtle"
          },
          "static": true
        },
        "fencing-only": {
          "type": "feature",
          "settings": {
            "icon": "target",
            "label": "Fencing only",
            "detail": "We're a specialist shop, not a sporting-goods aisle. We choose every product for the piste."
          }
        },
        "fair-pricing": {
          "type": "feature",
          "settings": {
            "icon": "tag",
            "label": "Fair pricing",
            "detail": "We buy direct and keep the supply chain short, so price never keeps anyone from fencing."
          }
        },
        "direct-sourcing": {
          "type": "feature",
          "settings": {
            "icon": "git-branch",
            "label": "Direct sourcing",
            "detail": "We buy straight from authorized makers, the brands your club and your referees already trust."
          }
        },
        "real-support": {
          "type": "feature",
          "settings": {
            "icon": "life-buoy",
            "label": "Real support",
            "detail": "Ask us about sizing, blades, or your first tournament kit. The people who answer fence too."
          }
        }
      },
      "block_order": [
        "fencing-only",
        "fair-pricing",
        "direct-sourcing",
        "real-support"
      ]
    },
    "programs": {
