    "principles": {
      "type": "about-principles",
      "blocks": {
        "phase": {
          "type": "phase-heading",
          "static": true,
          "settings": {
            "meaning": "Ready",
            "word": "Prêts",
            "tag": "h2"
          }
        },
        "lead": {
          "type": "text",
          "settings": {
            "text": "<p>Before a bout begins, you set your stance. Here's ours.</p>",
            "style": "body"
          },
          "static": true
        },
        "operations_heading": {
          "type": "heading",
          "settings": {
            "heading": "How we operate",
            "tag": "h3",
            "size": "sm"
          },
          "static": true
        },
        "operations_start": {
          "type": "text",
          "settings": {
            "text": "<p>We're a direct retailer. We hold our own stock instead of dropshipping, and we work with manufacturing partners and established brands worldwide to keep quality consistent.</p>",
            "style": "lead"
          },
          "static": true
        },
        "operations_end": {
          "type": "text",
          "settings": {
            "text": "<p>Orders ship from U.S. fulfillment centers. A logistics partner sometimes delivers them, but never a reseller. Our own team answers every question and handles every order and return.</p>",
            "style": "lead"
          },
          "static": true
        },
        "fencing-only": {
          "type": "feature",
          "settings": {
            "icon": "target",
            "label": "Fencing only",
            "detail": "We sell fencing gear and nothing else. Every product is picked for the piste."
          }
        },
        "fair-pricing": {
          "type": "feature",
          "settings": {
            "icon": "tag",
            "label": "Fair pricing",
            "detail": "Short supply chains keep prices fair, so cost doesn't stop anyone from fencing."
          }
        },
        "direct-sourcing": {
          "type": "feature",
          "settings": {
            "icon": "git-branch",
            "label": "Direct sourcing",
            "detail": "We buy straight from the makers, so every product is genuine."
          }
        },
        "real-support": {
          "type": "feature",
          "settings": {
            "icon": "life-buoy",
            "label": "Real support",
            "detail": "Ask us anything. The people who answer fence too."
          }
        }
      },
      "block_order": [
        "fencing-only",
        "fair-pricing",
        "direct-sourcing",
        "real-support"
      ]
    },
