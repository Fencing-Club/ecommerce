            "intro": {
              "type": "text",
              "settings": {
                "text": "<p>Equipping a whole club adds up fast. We help clubs, schools, and nonprofits do it for less, with member pricing and bulk discounts today and club partnerships on the way.</p>",
                "style": "lead"
              }
            }
          },
          "block_order": [
            "eyebrow",
            "heading",
            "intro"
          ],
          "static": true
        },
        "club-pricing": {
          "type": "_program",
          "settings": {
            "icon": "badge-percent",
            "title": "Club member pricing",
            "text": "Club members get everyday pricing on Fencing Club house-brand gear. Name brands such as UNIC and FWF aren't included.",
            "note": "Up to 15% off house-brand gear"
          }
        },
        "bulk": {
          "type": "_program",
          "settings": {
            "icon": "boxes",
            "title": "Bulk and team kitting",
            "text": "Kitting out a full squad? Kitting out a full squad? Orders of $1,500 or more get bulk pricing.",
            "note": "Up to 10% off"
          }
        },
        "partnerships": {
          "type": "_program",
          "settings": {
            "icon": "plug",
            "title": "Club partnerships",
            "text": "Show our gear on your club's website, with a custom checkout for the starter kits you approve.",
            "badge": "Coming soon"
          }
        }
      },
      "block_order": [
        "club-pricing",
        "bulk",
        "partnerships"
      ]
