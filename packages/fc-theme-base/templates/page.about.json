        "online": {
          "type": "_milestone",
          "settings": {
            "date": "2023",
            "title": "Online only, on purpose",
            "text": "Without a storefront to pay for, we pass the savings to fencers."
          }
        },
        "dealer": {
          "type": "_milestone",
          "settings": {
            "date": "2024",
            "title": "Authorized dealer",
            "text": "We become an authorized dealer for four brands and buy from them directly."
          }
        },
        "kitting": {
          "type": "_milestone",
          "settings": {
            "date": "2025",
            "title": "Club and team kits",
            "text": "Clubs, schools, and nonprofits get team kits and member pricing."
          }
        },
        "blades": {
          "type": "_milestone",
          "settings": {
            "date": "2027",
            "title": "FIE blades from UNIC",
            "text": "We start carrying UNIC's FIE-homologated blades.",
            "status": "planned"
          }
        },
        "masks": {
          "type": "_milestone",
          "settings": {
            "date": "Late 2026",
            "title": "Our own certified masks",
            "text": "Masks for foil, épée, and sabre, rated 350N and 1600N.",
            "status": "in_progress"
          }
        },
        "uniform": {
          "type": "_milestone",
          "settings": {
            "date": "2027",
            "title": "An 800N uniform",
            "text": "An 800N competition uniform completes the kit.",
            "status": "planned"
          }
        },
        "platform": {
          "type": "_milestone",
          "settings": {
            "date": "Early 2028",
            "title": "Club management platform",
            "text": "A white-label portal, built with clubs, for booking classes and private lessons and taking payments.",
            "status": "planned"
          }
        }
