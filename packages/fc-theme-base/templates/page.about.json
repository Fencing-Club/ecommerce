    "story": {
      "type": "about-story",
      "blocks": {
        "header": {
          "type": "group",
          "settings": {
            "direction": "column",
            "gap": "md"
          },
          "blocks": {
            "eyebrow": {
              "type": "text",
              "settings": {
                "text": "<p>Our story</p>",
                "style": "eyebrow"
              }
            },
            "heading": {
              "type": "heading",
              "settings": {
                "heading": "It started at the clubs",
                "tag": "h2",
                "size": "lg"
              }
            }
          },
          "block_order": [
            "eyebrow",
            "heading"
          ],
          "static": true
        },
        "paragraph-1": {
          "type": "text",
          "settings": {
            "text": "<p>We started Fencing Club in 2023, after years of visiting clubs, schools, and training halls around the world. Everywhere we went, fencers struggled to get proper gear. Stock was thin, quality was uneven, and long supply chains pushed prices up.</p>",
            "style": "lead"
          }
        },
        "paragraph-2": {
          "type": "text",
          "settings": {
            "text": "<p>We came home convinced that cost and access should never decide who gets to fence.</p>",
            "style": "lead"
          }
        },
        "paragraph-3": {
          "type": "text",
          "settings": {
            "text": "<p>So we built a shop that sells only fencing gear, for every level. We buy direct to keep prices fair, and we answer every question ourselves.</p>",
            "style": "lead"
          }
        }
      },
      "block_order": [
        "paragraph-1",
        "paragraph-2",
        "paragraph-3"
      ]
    },
