            "heading": "Everything for fencing, and only fencing.",
            "tag": "h1",
            "size": "xl"
          }
        },
        "mission": {
          "type": "text",
          "settings": {
            "text": "<p>Since 2023, we've supplied clubs, schools, and individual fencers with dependable gear at honest prices. Our team fences too, so our advice holds up from your first lesson to your first podium.</p>",
            "style": "lead"
          }
