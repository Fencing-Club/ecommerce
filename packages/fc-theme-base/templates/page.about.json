        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Everything for fencing, and only fencing.",
            "tag": "h1",
            "size": "xl"
          }
        },
        "mission": {
          "type": "text",
          "settings": {
            "text": "<p>We're a fencing-only shop in Woodinville, Washington. Since 2023 we've equipped clubs, schools, and fencers at every level, from a first lesson to the finals. We fence too, so we only sell gear we'd trust on the piste.</p>",
            "style": "lead"
          }
        },
