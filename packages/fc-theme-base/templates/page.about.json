    "principles": {
      "type": "about-principles",
      "blocks": {
        "phase": {
          "type": "phase-heading",
          "static": true,
          "settings": {
            "phase": "Phase 01",
            "meaning": "Ready, what we stand for",
            "word": "Prêt",
            "tag": "h2"
          }
        },
        "lead": {
          "type": "text",
          "settings": {
            "text": "<p>Before the bout, you settle into your stance. Here is ours.</p>",
            "style": "body"
          },
          "static": true
        },
        "operations_heading": {
          "type": "heading",
          "settings": {
            "heading": "How we operate",
            "tag": "h3",
            "size": "sm"
          },
          "static": true
        },
        "operations_start": {
          "type": "text",
          "settings": {
            "text": "<p>We're a true direct retailer — we hold our own inventory rather than dropship, working with manufacturing partners and established brands worldwide to keep quality consistent and prices fair.</p>",
            "style": "lead"
          },
          "static": true
        },
        "operations_end": {
          "type": "text",
          "settings": {
            "text": "<p>Orders ship from U.S. fulfillment centers — occasionally via logistics partners for delivery only, never resellers. Every question, order, and return is handled directly by our own team.</p>",
            "style": "lead"
          },
          "static": true
        },
        "fencing-only": {
          "type": "feature",
          "settings": {
            "icon": "target",
            "label": "Fencing only",
            "detail": "A specialist shop, not a general sporting-goods aisle. Every product is chosen for the piste."
          }
        },
        "fair-pricing": {
          "type": "feature",
          "settings": {
            "icon": "tag",
            "label": "Fair pricing",
            "detail": "Direct relationships and short supply chains, so cost never keeps anyone off the piste."
          }
        },
        "direct-sourcing": {
          "type": "feature",
          "settings": {
            "icon": "git-branch",
            "label": "Direct sourcing",
            "detail": "We buy straight from authorized makers — the brands your club and referees trust."
          }
        },
        "real-support": {
          "type": "feature",
          "settings": {
            "icon": "life-buoy",
            "label": "Real support",
            "detail": "Guidance from first lesson to final touch, from people who actually fence."
          }
        }
      },
      "block_order": [
        "fencing-only",
        "fair-pricing",
        "direct-sourcing",
        "real-support"
      ]
