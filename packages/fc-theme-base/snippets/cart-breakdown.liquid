{% doc %}
  Order summary rows. Codes show as removable chips in the summary card and as plain labels in the mobile breakdown.
  Shipping reads Free when the cart earns it (data-free) or a shipping code is applied (scripts add data-code-free).
  @param {string} [variant] - chips (default) or plain.
  @param {boolean} [shipping_free] - Shipping is free for this cart.
{% enddoc %}
{%- assign plain = false -%}
{%- if variant == 'plain' -%}{%- assign plain = true -%}{%- endif -%}
<dl class="fc-breakdown" data-cart-breakdown>
  <div class="fc-breakdown__row"><dt>{{ 'sections.cart.items_subtotal' | t }}</dt><dd>{{ cart.items_subtotal_price | money }}</dd></div>
  {%- for application in cart.cart_level_discount_applications -%}
    <div class="fc-breakdown__row">
      <dt>
        {{- 'sections.cart.discount' | t }}
        {%- if plain %} {{ application.title | escape }}{% else -%}
          {%- render 'cart-discount-chip', application: application -%}
        {%- endif -%}
      </dt>
      <dd class="fc-benefit">-{{ application.total_allocated_amount | money }}</dd>
    </div>
  {%- endfor -%}
  {%- for application in cart.discount_applications -%}
    {%- if application.type == 'discount_code' and application.target_selection != 'all' and application.target_type != 'shipping_line' -%}
      <div class="fc-breakdown__row">
        <dt>
          {{- 'sections.cart.discount' | t }}
          {%- if plain %} {{ application.title | escape }}{% else -%}
            {%- render 'cart-discount-chip', application: application -%}
          {%- endif -%}
        </dt>
        <dd>{{ 'sections.cart.discount_on_items' | t }}</dd>
      </div>
    {%- endif -%}
  {%- endfor -%}
  {%- if cart.requires_shipping -%}
    <div class="fc-breakdown__row" data-shipping-row {% if shipping_free %}data-free{% endif %}>
      <dt>{{ 'sections.cart.shipping' | t }}{% unless plain %}<span class="fc-chips" data-shipping-codes></span>{% endunless %}</dt>
      <dd class="fc-benefit" data-shipping-value="free">{{ 'sections.cart.free' | t }}</dd>
      <dd data-shipping-value="checkout">{{ 'sections.cart.at_checkout' | t }}</dd>
    </div>
  {%- endif -%}
  {%- if plain -%}
    <div class="fc-breakdown__row"><dt>{{ 'sections.cart.estimated_taxes' | t }}</dt><dd>{{ 'sections.cart.at_checkout' | t }}</dd></div>
  {%- endif -%}
</dl>
