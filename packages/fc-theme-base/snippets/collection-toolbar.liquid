{% doc %}
  The bar over a collection's grid: show or hide the filters, the protection level chips and what they mean, the
  product count, sorting and how many products sit in a row. Phones get Filters and Sort buttons with the chips
  below them.

  @param {object} results - The collection to count and sort.
  @param {string} section_id - Makes ids unique.
  @param {string} [filters_id] - The filter panel's id, which the filter toggle shows and hides.
  @param {string} [filter_drawer] - The phone filter drawer, with its Filters button.
  @param {boolean} [enable_sorting] - Shows the sort control.
  @param {string} [sort_label] - The sort control's prefix, such as Sort:.
  @param {string} [guide_url] - Where the levels help links for more.

  @example
  {% render 'collection-toolbar', results: collection, section_id: section.id, filters_id: 'CollectionFilters', enable_sorting: true, sort_label: 'Sort:' %}
{% enddoc %}
<div class="collection-toolbar">
  <div class="collection-toolbar__start">
    {%- if filters_id != blank -%}
      <button
        type="button"
        class="collection-toolbar__filters"
        aria-controls="{{ filters_id }}"
        aria-expanded="true"
        data-filters-toggle
      >
        {%- render 'ui-icon', icon: 'sliders-horizontal', size: 16 -%}
        <span data-filters-open>{{ 'collections.toolbar.hide_filters' | t }}</span>
        <span data-filters-closed hidden>{{ 'collections.toolbar.show_filters' | t }}</span>
      </button>
    {%- endif -%}
    {%- if filter_drawer != blank -%}
      <div class="collection-toolbar__drawer collection-curated-filters-mobile">{{ filter_drawer }}</div>
    {%- endif -%}
    {%- capture levels -%}{% render 'collection-protection-filter', results: results, section_id: section_id %}{%- endcapture -%}
    {%- if levels != blank -%}
      <div class="collection-toolbar__levels">
        {{ levels }}
        {%- render 'collection-levels-help', id: section_id, guide_url: guide_url -%}
      </div>
    {%- endif -%}
  </div>

  <div class="collection-toolbar__end">
    <div
      class="collection-toolbar__count product-count"
      id="ProductCount"
      role="status"
      data-product-count="{{ results.products_count }}"
      data-total-count="{{ results.all_products_count }}"
    >
      {{- 'products.facets.product_count_simple' | t: count: results.products_count -}}
    </div>
    {%- if enable_sorting -%}
      {%- capture sort_icon -%}<span class="collection-toolbar__sort-icon">{% render 'ui-icon', icon: 'arrow-up-down', size: 16 %}</span>{%- endcapture -%}
      {%- render 'ui-sort-dropdown',
        results: results,
        sort_label: sort_label,
        default_label: 'Featured',
        class: 'collection-toolbar__sort',
        leading: sort_icon
      -%}
    {%- endif -%}
    <div class="collection-density" role="group" aria-label="{{ 'collections.toolbar.density' | t }}">
      <button type="button" class="collection-density__option" aria-pressed="false" data-columns="3" aria-label="{{ 'collections.toolbar.columns' | t: count: 3 }}">
        {%- render 'ui-icon', icon: 'columns-3', size: 16 -%}
      </button>
      <button type="button" class="collection-density__option" aria-pressed="true" data-columns="4" aria-label="{{ 'collections.toolbar.columns' | t: count: 4 }}">
        {%- render 'ui-icon', icon: 'columns-4', size: 16 -%}
      </button>
    </div>
  </div>
</div>
