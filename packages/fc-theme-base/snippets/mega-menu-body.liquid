{% comment %}
  Renders the body of one mega menu panel. The variant is inferred from the menu tree,
  except for the two categories the design gives bespoke views.

  Accepts:
  - link: {Link} the top level menu entry (required).

  Usage:
  {% render 'mega-menu-body', link: link %}
{% endcomment %}

{%- liquid
  assign has_third_level = false
  for childlink in link.links
    if childlink.links != blank
      assign has_third_level = true
      break
    endif
  endfor

  assign variant = 'cards'
  if link.handle == 'weapons'
    assign variant = 'weapon-builder'
  elsif link.handle == 'starter-kits'
    assign variant = 'starter-kits'
  elsif has_third_level
    assign variant = 'columns'
  endif
-%}

{%- case variant -%}
  {%- when 'columns' -%}
    <div class="fc-mega__body">
      {%- render 'mega-menu-columns', link: link -%}

      {%- if link.handle == 'clothing' -%}
        {%- liquid
          assign sizing_page = settings.size_chart_index_page | default: pages['size-charts']
          assign sizing_url = sizing_page.url
          if sizing_url == blank
            assign sizing_url = routes.root_url | append: 'pages/size-charts'
          endif
        -%}
        <a class="fc-mega-feature" href="{{ sizing_url }}">
          <span class="fc-mega-feature__media">
            <img
              src="{{ 'mega-sizing-guide.jpg' | asset_url }}"
              alt=""
              loading="lazy"
              width="600"
              height="350"
            >
          </span>
          <span class="fc-mega-feature__header">
            <span class="fc-mega-feature__title">{{ 'sections.header.mega_menu.sizing_title' | t }}</span>
            <span class="fc-mega-feature__view">
              {{ 'sections.header.mega_menu.view' | t }}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </span>
          <span class="fc-mega-feature__desc">{{ 'sections.header.mega_menu.sizing_description' | t }}</span>
        </a>
      {%- endif -%}
    </div>

  {%- when 'weapon-builder' -%}
    <div class="fc-mega__body">
      {%- render 'mega-menu-columns', link: link -%}

      <div class="fc-mega-tool">
        <span class="fc-mega-tool__pill">{{ 'sections.header.mega_menu.tool' | t }}</span>
        <span class="fc-mega-tool__title">{{ 'sections.header.mega_menu.weapon_builder_title' | t }}</span>
        <span class="fc-mega-tool__copy">{{ 'sections.header.mega_menu.weapon_builder_description' | t }}</span>
        <a class="fc-mega-tool__button" href="{{ link.url }}">
          {{ 'sections.header.mega_menu.weapon_builder_action' | t }}
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </a>
      </div>
    </div>

  {%- when 'starter-kits' -%}
    <div class="fc-mega__body fc-mega__body--panels">
      {%- for panel in (1..2) -%}
        {%- capture panel_title_key %}sections.header.mega_menu.kits_{{ panel }}_title{% endcapture -%}
        {%- capture panel_description_key %}sections.header.mega_menu.kits_{{ panel }}_description{% endcapture -%}
        <div class="fc-mega-panel">
          <span class="fc-mega-panel__title">{{ panel_title_key | t }}</span>
          <span class="fc-mega-panel__desc">{{ panel_description_key | t }}</span>
          <span class="fc-mega-panel__rule"></span>

          <ul class="fc-mega-panel__options list-unstyled" role="list">
            {%- for childlink in link.links -%}
              <li>
                <a class="fc-mega-panel__option" href="{{ childlink.url }}">
                  <span>{{ childlink.title | escape }}</span>
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}

      <div class="fc-mega-panel fc-mega-panel--tool">
        <span class="fc-mega-tool__pill">{{ 'sections.header.mega_menu.tool' | t }}</span>
        <span class="fc-mega-panel__title">{{ 'sections.header.mega_menu.kit_builder_title' | t }}</span>
        <span class="fc-mega-panel__desc">{{ 'sections.header.mega_menu.kit_builder_description' | t }}</span>
        <a class="fc-mega-tool__button" href="{{ link.url }}">
          {{ 'sections.header.mega_menu.kit_builder_action' | t }}
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </a>
      </div>
    </div>

  {%- else -%}
    {%- liquid
      assign card_count = link.links | size
      assign compact = false
      if card_count > 3
        assign compact = true
      endif
    -%}

    <div class="fc-mega__cards" style="--fc-mega-columns: {{ card_count }};">
      {%- for childlink in link.links -%}
        {%- render 'mega-menu-card', childlink: childlink, compact: compact -%}
      {%- endfor -%}
    </div>
{%- endcase -%}
