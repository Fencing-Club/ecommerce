{% doc %}
  Discount code editor. Shopify confirms whether a code applies; applied codes show as chips in the order summary.
  Shopify's t filter already escapes its output, so translated attributes take no second escape.
  @param {string} context - Unique cart view name.
{% enddoc %}
{%- liquid
  assign field_id = 'CartDiscount-' | append: context
  assign status_id = 'CartDiscountStatus-' | append: context
  assign invalid_template = 'sections.cart.discount_invalid' | t: code: '[code]'
-%}
<cart-discount
  class="fc-editor fc-discount"
  id="CartDiscountEditor-{{ context }}"
  data-invalid="{{ invalid_template }}"
  data-error="{{ 'sections.cart.discount_error' | t }}"
  data-remove-error="{{ 'sections.cart.discount_remove_error' | t: code: '[code]' }}"
  data-apply="{{ 'sections.cart.apply' | t }}"
  data-applying="{{ 'sections.cart.applying' | t }}"
>
  <div class="fc-editor__head">
    <label class="fc-editor__label" for="{{ field_id }}">{% render 'ui-icon', icon: 'tag', size: 16 %}{{ 'sections.cart.discount_code' | t }}</label>
    <button type="button" class="fc-icon-button fc-icon-button--small" data-close-editor aria-label="{{ 'sections.cart.close_discount' | t }}">{% render 'ui-icon', icon: 'x', size: 16 %}</button>
  </div>
  <div class="fc-discount__row">
    <input class="fc-input" id="{{ field_id }}" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" enterkeyhint="done" aria-describedby="{{ status_id }}">
    <button type="button" class="fc-button fc-button--primary" data-apply-discount>{{ 'sections.cart.apply' | t }}</button>
  </div>
  {%- render 'cart-feedback', id: status_id -%}
</cart-discount>
