{%- comment -%}
  Renders one compact Contact quick answer.

  Accepts:
  - question: {String} Question text (required)
  - answer: {String} Answer, as rich text (required)
{%- endcomment -%}
<article class="ui-contact-quick-answer">
  <h3>{{ question | escape }}</h3>
  <div class="ui-contact-quick-answer__answer">{{ answer }}</div>
</article>