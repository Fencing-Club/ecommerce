{% doc %}
  Order summary: discount and note, summary rows, total, savings, checkout and reassurance.
  On phones the total and checkout move to the fixed checkout bar.
  @param {string} context - Unique cart view name.
  @param {string} form_id - Cart form to submit.
{% enddoc %}
{%- liquid
  capture savings_cents
    render 'cart-savings'
  endcapture
  assign savings = savings_cents | plus: 0
  assign savings_money = savings | money

  assign unavailable_count = 0
  for item in cart.items
    if item.variant.available == false
      assign unavailable_count = unavailable_count | plus: 1
    endif
  endfor

  assign checkout_reason = ''
  assign state = 'ready'
  if unavailable_count > 0
    assign checkout_reason = 'sections.cart.blocked_unavailable' | t: count: unavailable_count
    assign state = 'blocked'
  endif

  capture free_shipping
    render 'cart-free-shipping'
  endcapture
  assign free_shipping = free_shipping | plus: 0
  assign shipping_free = false
  if free_shipping > 0 and cart.total_price >= free_shipping
    assign shipping_free = true
  endif
-%}
<div class="fc-summary" data-cart-summary data-checkout-state="{{ state }}">
  {% render 'cart-extras', context: context, form_id: form_id %}
  <div data-cart-region="breakdown">{% render 'cart-breakdown', shipping_free: shipping_free %}</div>
  {%- assign discount_feedback_id = 'CartDiscountRemoveStatus-' | append: context -%}
  <div class="fc-summary__feedback" data-discount-feedback>{% render 'cart-feedback', id: discount_feedback_id %}</div>
  <template data-chip-template>{% render 'cart-discount-chip', code: '[code]' %}</template>
  <div class="fc-total" data-cart-region="total">
    <div class="fc-total__row">
      <div class="fc-total__labels">
        <p class="fc-total__label">{{ 'sections.cart.total' | t }}</p>
        <p class="fc-total__note">{% if cart.taxes_included %}{{ 'sections.cart.taxes_included' | t }}{% else %}{{ 'sections.cart.taxes_at_checkout' | t }}{% endif %}</p>
      </div>
      <p class="fc-total__value"><span>{{ cart.total_price | money }}</span></p>
    </div>
    {%- if savings > 0 -%}
      <p class="fc-savings">{% render 'fc-icon', icon: 'badge-percent', size: 16 %}<span>{{ 'sections.cart.you_save' | t: amount: savings_money }}</span></p>
    {%- endif -%}
  </div>
  <div data-cart-region="checkout">{% render 'cart-checkout', form_id: form_id, context: context, reason: checkout_reason %}</div>
  {%- if settings.cart_trust_dispatch != blank or settings.cart_trust_returns != blank -%}
    <ul class="fc-trust" role="list">
      {%- if settings.cart_trust_dispatch != blank -%}<li>{% render 'fc-icon', icon: 'truck', size: 14 %}{{ settings.cart_trust_dispatch | escape }}</li>{%- endif -%}
      {%- if settings.cart_trust_returns != blank -%}<li>{% render 'fc-icon', icon: 'rotate-ccw', size: 14 %}{{ settings.cart_trust_returns | escape }}</li>{%- endif -%}
    </ul>
  {%- endif -%}
</div>
