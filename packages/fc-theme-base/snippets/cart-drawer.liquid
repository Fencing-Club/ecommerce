{% doc %}
  Cart flyout: a 520px drawer on tablet and desktop, full screen with a fixed checkout bar on phones.
  The root's data-cart-state is ready or empty; scripts add data-load-state loading or failed while it refreshes.
{% enddoc %}
{%- liquid
  assign cart_state = 'ready'
  if cart == empty
    assign cart_state = 'empty'
  endif
-%}
{{ 'cart-experience.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-controls.js' | asset_url }}" defer="defer"></script>
<cart-drawer class="drawer fc-cart-panel" data-cart-state="{{ cart_state }}">
  <div id="CartDrawer" class="fc-flyout__frame">
    <div id="CartDrawer-Overlay" class="fc-flyout__overlay"></div>
    <div class="drawer__inner fc-flyout" role="dialog" aria-modal="true" aria-labelledby="CartDrawer-Title" tabindex="-1">
      <header class="fc-flyout__header">
        {%- assign cart_title = 'sections.cart.title' | t -%}
        <h2 class="fc-flyout__title" id="CartDrawer-Title">{%- render 'ui-link', label: cart_title, url: routes.cart_url, class: 'fc-flyout__title-link' -%}<span class="fc-flyout__count" data-cart-region="count">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span></h2>
        <div class="fc-flyout__actions">
          {%- assign close_label = 'sections.cart.close' | t -%}
          {%- render 'ui-button', aria_label: close_label, variant: 'icon', icon: 'x', class: 'drawer__close' -%}
        </div>
      </header>
      <cart-drawer-items class="fc-flyout__content" view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}" view-event-trigger="manual">
        <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="fc-flyout__form" method="post" novalidate>
          <div class="fc-flyout__progress" data-cart-region="progress">{% render 'cart-reward-progress' %}</div>
          <div class="fc-flyout__scroll" id="CartDrawer-CartItems">
            <div class="fc-flyout__gifts" data-cart-region="gifts">{% render 'cart-gifts', context: 'drawer' %}</div>
            <div data-cart-region="lines">{% render 'cart-lines', context: 'drawer' %}</div>
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
          </div>
          <div class="fc-flyout__summary">{% render 'cart-summary', context: 'drawer', form_id: 'CartDrawer-Form' %}</div>
        </form>
        <div class="fc-flyout__empty">
          {% render 'cart-message', kind: 'empty', context: 'drawer' %}
          {% render 'cart-popular' %}
        </div>
        <div class="fc-flyout__failed">{% render 'cart-message', kind: 'failed', context: 'drawer' %}</div>
        <div class="fc-flyout__loading">
          <p class="visually-hidden">{{ 'sections.cart.loading' | t }}</p>
          {% render 'cart-skeleton', part: 'progress' %}
          {% render 'cart-skeleton', part: 'lines' %}
          <div class="fc-flyout__loading-summary">{% render 'cart-skeleton', part: 'summary' %}</div>
        </div>
      </cart-drawer-items>
    </div>
  </div>
</cart-drawer>
