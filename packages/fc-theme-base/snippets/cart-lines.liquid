{% doc %}
  Product rows shared by the cart page and the cart flyout.
  @param {string} context - page or drawer.
{% enddoc %}
<ul class="fc-lines" role="list" data-cart-lines>
  {%- for item in cart.items -%}
    {% render 'cart-line-item', item: item, context: context %}
  {%- endfor -%}
</ul>
<template data-removed-template>{% render 'cart-line-removed' %}</template>
