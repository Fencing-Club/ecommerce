{% doc %}
  The chosen variant's stock. Plain, as quick view shows it: where it ships from while it's in stock, our Woodinville
  store when Shopify lists the variant as available there for pickup, otherwise the partner warehouse. Detailed, as the
  product page shows it: a dot and the same place, how many are left when few are, or that it's sold out. The product
  page's ships row is `snippets/product-ships-line.liquid`.

  @param {object} variant - The chosen variant.
  @param {boolean} [detailed] - The product page's version.
  @param {string} [size] - The chosen size, which low stock and sold out name.

  @example
  {% render 'product-stock-line', variant: product.selected_or_first_available_variant %}
{% enddoc %}
{%- liquid
  assign local = nil
  for availability in variant.store_availabilities
    if availability.available
      assign local = availability.location
      break
    endif
  endfor
  if local
    capture place
      echo local.address.city | append: ', ' | append: local.address.province_code
    endcapture
  endif
-%}
{%- if detailed -%}
  {%- liquid
    assign state = 'in'
    assign left = 0
    if variant.available == false
      assign state = 'out'
    elsif variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity <= 5
      assign state = 'low'
      assign left = variant.inventory_quantity
    endif
  -%}
  <p class="product-stock-line product-stock-line--{{ state }}">
    <span class="product-stock-line__dot" aria-hidden="true"></span>
    <span>
      {%- case state -%}
        {%- when 'out' -%}
          {%- if size != blank -%}{{ 'products.stock.sold_out_size' | t: size: size }}{%- else -%}{{ 'products.stock.sold_out' | t }}{%- endif -%}
        {%- when 'low' -%}
          {%- if size != blank -%}{{ 'products.stock.low_size' | t: count: left, size: size }}{%- else -%}{{ 'products.stock.low' | t: count: left }}{%- endif -%}
        {%- else -%}
          {%- if local -%}{{ 'products.stock.local' | t: place: place }}{%- else -%}{{ 'products.stock.partner_stock' | t }}{%- endif -%}
      {%- endcase -%}
    </span>
  </p>
{%- elsif variant.available -%}
  <p class="product-stock-line">
    {%- if local -%}
      {%- render 'ui-icon', icon: 'package-check', size: 16 -%}
      <span>{{ 'products.stock.local' | t: place: place }}</span>
    {%- else -%}
      {%- render 'ui-icon', icon: 'warehouse', size: 16 -%}
      <span>{{ 'products.stock.partner' | t }}</span>
    {%- endif -%}
  </p>
{%- endif -%}
