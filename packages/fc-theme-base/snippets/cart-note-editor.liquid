{% doc %}
  Order note. Saving is explicit: the editor stays open until the note is saved or the shopper closes it, which drops
  unsaved changes. An unsaved note blocks checkout.
  @param {string} context - Unique cart view name.
  @param {string} form_id - Owning checkout form.
{% enddoc %}
{%- liquid
  assign note_max = 500
  assign note_length = cart.note | size
  assign field_id = 'CartNote-' | append: context
  assign count_id = 'CartNoteCount-' | append: context
  assign status_id = 'CartNoteStatus-' | append: context
  assign count_template = 'sections.cart.note_length' | t: count: '[count]', max: note_max
-%}
<cart-note
  class="fc-note"
  data-saved-note="{{ cart.note | escape }}"
  data-max="{{ note_max }}"
  data-count="{{ count_template }}"
  data-error="{{ 'sections.cart.note_error' | t }}"
  data-save="{{ 'sections.cart.save_note' | t }}"
  data-saving="{{ 'sections.cart.saving' | t }}"
>
  <div class="fc-note__saved">
    <div class="fc-editor__head">
      <p class="fc-editor__label">{% render 'ui-icon', icon: 'message-square', size: 16 %}{{ 'sections.cart.order_note' | t }}</p>
      {%- assign edit_label = 'sections.cart.edit_note' | t -%}
      {%- capture edit_props -%}data-edit-note aria-controls="CartNoteEditor-{{ context }}" aria-expanded="false"{%- endcapture -%}
      {%- render 'ui-button', aria_label: edit_label, variant: 'icon', icon: 'pencil', additional_props: edit_props -%}
    </div>
    <p class="fc-note__text" data-note-text>{{ cart.note | escape }}</p>
  </div>
  <div class="fc-editor fc-note__editor" id="CartNoteEditor-{{ context }}">
    <div class="fc-editor__head">
      <label class="fc-editor__label" for="{{ field_id }}">{% render 'ui-icon', icon: 'message-square', size: 16 %}{{ 'sections.cart.order_note' | t }}</label>
      {%- assign close_label = 'sections.cart.close_note' | t -%}
      {%- render 'ui-button', aria_label: close_label, variant: 'icon', icon: 'x', additional_props: 'data-cancel-note' -%}
    </div>
    <textarea class="fc-input fc-note__input" id="{{ field_id }}" name="note" form="{{ form_id }}" rows="3" maxlength="{{ note_max }}" aria-describedby="{{ count_id }} {{ status_id }}">{{ cart.note | escape }}</textarea>
    <div class="fc-note__foot">
      <span class="fc-note__count" id="{{ count_id }}" data-note-count>{{ 'sections.cart.note_length' | t: count: note_length, max: note_max }}</span>
      {%- assign save_label = 'sections.cart.save_note' | t -%}
      {%- render 'ui-button', label: save_label, variant: 'primary', size: 'md', additional_props: 'data-save-note' -%}
    </div>
    {%- render 'cart-feedback', id: status_id -%}
  </div>
</cart-note>
