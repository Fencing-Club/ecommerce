{% doc %}
  The product page's photo viewer: every photo and video full size on a dark dialog, with the count, arrows and
  thumbnails. Arrow keys, swipes, the arrows and the thumbnails move between photos; Escape and Close shut it, and
  focus goes back to the photo that opened it. `assets/product-page.js` opens it from the gallery.

  @param {object} product - The product.
  @param {string} id - The dialog's id, which the gallery's photos point at.

  @example
  {% render 'product-photo-viewer', product: product, id: viewer_id %}
{% enddoc %}
{%- assign count = product.media.size -%}
{%- if count > 0 -%}
  <dialog class="photo-viewer" id="{{ id }}" aria-label="{{ 'products.gallery.photos_of' | t: title: product.title | escape }}" data-photo-viewer>
    <photo-gallery class="photo-viewer__gallery">
      <div class="photo-viewer__top">
        <p class="photo-viewer__counter" data-photo-counter data-template="{{ 'products.gallery.photo_count' | t: index: '[index]', count: count | escape }}">
          {{- 'products.gallery.photo_count' | t: index: 1, count: count -}}
        </p>
        <button type="button" class="photo-viewer__close" data-photo-viewer-close aria-label="{{ 'products.gallery.close' | t }}">
          {%- render 'ui-icon', icon: 'x', size: 18 -%}
        </button>
      </div>
      <div class="photo-viewer__stage">
        {%- comment -%} Focusable, so arrow keys can scroll the photos too. {%- endcomment -%}
        <div class="photo-viewer__track" data-photo-track role="group" aria-label="{{ 'products.gallery.photos' | t }}" tabindex="0">
          {%- for media in product.media -%}
            {%- assign alt = media.alt | default: product.title -%}
            <div class="photo-viewer__slide" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, preload: 'none', image_size: '1600x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag: class: 'photo-viewer__embed', loading: 'lazy' }}
                {%- else -%}
                  {%- if media.preview_image -%}
                    {{
                      media.preview_image
                      | image_url: width: 2048
                      | image_tag: loading: 'lazy', widths: '1024, 1536, 2048', sizes: '100vw', alt: alt
                    }}
                  {%- endif -%}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if count > 1 -%}
          <button type="button" class="photo-viewer__arrow photo-viewer__arrow--previous" data-photo-step="-1" aria-label="{{ 'products.gallery.previous' | t }}">
            {%- render 'ui-icon', icon: 'chevron-left', size: 20 -%}
          </button>
          <button type="button" class="photo-viewer__arrow photo-viewer__arrow--next" data-photo-step="1" aria-label="{{ 'products.gallery.next' | t }}">
            {%- render 'ui-icon', icon: 'chevron-right', size: 20 -%}
          </button>
        {%- endif -%}
      </div>
      {%- if count > 1 -%}
        <div class="photo-viewer__thumbs">
          {%- for media in product.media -%}
            <button
              type="button"
              class="photo-viewer__thumb"
              data-photo-index="{{ forloop.index0 }}"
              aria-label="{{ 'products.gallery.show_photo' | t: index: forloop.index }}"
              {% if forloop.first %}
                aria-current="true"
              {% endif %}
            >
              {%- if media.preview_image -%}
                {{ media.preview_image | image_url: width: 104 | image_tag: loading: 'lazy', alt: '', width: 52, height: 52 }}
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </photo-gallery>
  </dialog>
{%- endif -%}
