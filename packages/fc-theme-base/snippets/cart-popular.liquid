{% doc %}
  Collections suggested when the cart is empty, chosen in the theme's cart settings.

  @param {string} [image_sizes] - The tiles' image sizes attribute. Default the drawer's fixed 150px tiles.
{% enddoc %}
{%- liquid
  assign image_sizes = image_sizes | default: '150px'
  assign tiles = 0
  for index in (1..3)
    assign key = 'cart_popular_collection_' | append: index
    if settings[key] != blank
      assign tiles = tiles | plus: 1
    endif
  endfor
-%}
{%- if tiles > 0 -%}
  <div class="fc-popular">
    <h3 class="fc-popular__title">{{ settings.cart_popular_heading | escape }}</h3>
    <ul class="fc-popular__tiles" role="list">
      {%- for index in (1..3) -%}
        {%- liquid
          assign key = 'cart_popular_collection_' | append: index
          assign collection = settings[key]
          assign image = collection.featured_image | default: collection.image
        -%}
        {%- if collection != blank -%}
          <li>
            <a class="fc-popular__tile" href="{{ collection.url }}">
              <span class="fc-popular__image">{%- if image -%}{{ image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '150, 300, 450, 600, 800', sizes: image_sizes, alt: '' }}{%- endif -%}</span>
              <span class="fc-popular__label">
                <span class="fc-popular__name">{{ collection.title | escape }}</span>
                {% render 'ui-icon', icon: 'arrow-right', size: 14 %}
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}
