{% doc %}
  A price, with an optional badge and an optional unit price. On sale, the sale price leads in red and the compare-at
  price follows it, struck through.

  @param {number} price - The price in cents.
  @param {number} [compare_at_price] - The regular price in cents. Shown struck through only when higher than price.
  @param {string} [badge_label] - A short badge after the price, such as Sale.
  @param {string} [unit_price] - A formatted unit price, such as $2.50/100g.
  @param {string} [size] - sm for cards and lines, md (default), or lg for the product page.
  @param {boolean} [trim] - Drops .00 from whole amounts, so $89.00 reads $89.
{% enddoc %}
{%- liquid
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
  endif
  if trim
    assign price_text = price | money_without_trailing_zeros
    assign compare_text = compare_at_price | money_without_trailing_zeros
  else
    assign price_text = price | money
    assign compare_text = compare_at_price | money
  endif
-%}
<div class="ui-price{% if size == 'sm' %} ui-price--sm{% elsif size == 'lg' %} ui-price--lg{% endif %}">
  <div class="ui-price__row">
    {%- if on_sale -%}
      <span class="ui-price__amount ui-price__amount--sale">
        <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
        {{- price_text -}}
      </span>
      <s class="ui-price__compare">
        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
        {{- compare_text -}}
      </s>
    {%- else -%}
      <span class="ui-price__amount">{{ price_text }}</span>
    {%- endif -%}
    {%- if badge_label != blank -%}
      {%- render 'ui-badge', label: badge_label -%}
    {%- endif -%}
  </div>
  {%- if unit_price != blank -%}
    <p class="ui-price__unit">
      <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
      {{- unit_price | escape -}}
    </p>
  {%- endif -%}
</div>
