      class="ui-care-symbol__glyph"
      xmlns="http://www.w3.org/2000/svg"
      width="{{ glyph_pixels }}"
      height="{{ glyph_pixels }}"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
