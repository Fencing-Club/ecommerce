{% doc %}
  The product card on the homepage, collections, search and the product page's recommendations, and a compact row
  in predictive search. A grid card has a square photo with the protection level top left, Sale or Sold out top right,
  another brand's logo bottom left and, on touch screens, a quick add button bottom right; with quick view, pointers
  get an eye button there on hover instead, named Quick view. With more than one photo,
  hovering shows arrows and a progress bar, and phones swipe. Under the photo, the name wraps to two lines, and one
  row holds the price and up to three colors. A color with its own photo is a button that shows that photo and
  points the card's links at that color.

  @param {object} product - The product to show.
  @param {string} [variant] - home (default) for the grid card, search for the predictive search row.
  @param {string} [card_id] - The name's id. Defaults to one built from the product id.
  @param {string} [block_attributes] - Shopify's block attributes, when a block renders the card.
  @param {boolean} [show_price] - Shows the price row.
  @param {boolean} [show_add] - Shows quick add on touch screens.
  @param {string} [add_label] - Quick add's accessible name, such as Add to cart.
  @param {boolean} [quick_view] - Adds Quick view on hover, and makes quick add on touch screens open the quick add
    sheet for products with options. The page needs `quick-view-dialog` for these to open.
  @param {string} [section_id] - The section id quick add's product form reports to.
  @param {string} [tabindex] - A tabindex for the card's links.
  @param {number} [image_width] - The requested image width. Default 600.
  @param {string} [image_widths] - Responsive image widths.
  @param {string} [image_sizes] - Responsive image sizes.
  @param {string} [image_loading] - lazy (default) or eager.
  @param {string} [image_fetchpriority] - high for the card most likely to be the page's largest image, auto (default)
    otherwise.
  @param {string} [title] - A name to show instead of the product's.
  @param {string} [url] - A link to use instead of the product's.
  @param {string} [price_label] - A formatted price to show instead of the product's.
  @param {string} [image_asset] - A theme asset to show instead of the product's photos.
  @param {string} [image_alt] - The asset's alternative text.

  @example
  {% render 'ui-product-card', product: product, show_price: true %}
{% enddoc %}
{%- liquid
  assign variant = variant | default: 'home'
  assign image_width = image_width | default: 600
  assign image_widths = image_widths | default: '300, 450, 600'
  assign image_sizes = image_sizes | default: '(min-width: 990px) 300px, 50vw'
  assign image_loading = image_loading | default: 'lazy'
  assign image_fetchpriority = image_fetchpriority | default: 'auto'
  assign card_title = title | default: product.title
  assign card_url = url | default: product.url
  assign title_id = card_id
  if title_id == blank
    assign title_handle = card_title | handle
    assign title_id = 'ProductCardTitle-' | append: product.id
    if product.id == blank
      assign title_id = 'ProductCardTitle-' | append: title_handle
    endif
  endif

  assign card_images = product.media | where: 'media_type', 'image'
  assign photo_count = card_images.size | at_most: 4
  if image_asset != blank or variant == 'search'
    assign photo_count = photo_count | at_most: 1
  endif

  assign sold_out = false
  if product.available == false
    assign sold_out = true
  endif
  assign percent_off = 0
  if sold_out == false and product.compare_at_price > product.price
    assign saving = product.compare_at_price | minus: product.price | times: 100.0
    assign percent_off = saving | divided_by: product.compare_at_price | round
  endif

  assign vendor_handle = product.vendor | handle
  assign brand_logo = shop.metaobjects.brand[vendor_handle].logo.value

  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'color' or option_name == 'colour'
      assign color_option = option
      break
    endif
  endfor
-%}

<article
  class="ui-product-card ui-product-card--{{ variant }}{% if sold_out %} ui-product-card--sold-out{% endif %}"
  {{ block_attributes }}
>
  <product-card-gallery class="ui-product-card__media" data-photos="{{ photo_count }}">
    <a
      class="ui-product-card__track"
      href="{{ card_url }}"
      aria-labelledby="{{ title_id }}"
      {% if tabindex != blank %}
        tabindex="{{ tabindex }}"
      {% endif %}
    >
      {%- if image_asset != blank -%}
        <img
          class="ui-product-card__image"
          src="{{ image_asset | asset_url }}"
          alt="{{ image_alt | default: card_title | escape }}"
          width="{{ image_width }}"
          height="{{ image_width }}"
          loading="{{ image_loading }}"
          fetchpriority="{{ image_fetchpriority }}"
        >
      {%- elsif photo_count > 0 -%}
        {%- for media in card_images limit: photo_count -%}
          {%- liquid
            assign photo_loading = image_loading
            assign photo_fetchpriority = image_fetchpriority
            unless forloop.first
              assign photo_loading = 'lazy'
              assign photo_fetchpriority = 'auto'
            endunless
            assign photo = media.preview_image | default: media
            # A filter inside image_tag's arguments would end them, so the alt text is worked out first.
            assign photo_alt = photo.alt | default: card_title
          -%}
          {{
            photo
            | image_url: width: image_width
            | image_tag:
              class: 'ui-product-card__image',
              widths: image_widths,
              sizes: image_sizes,
              alt: photo_alt,
              loading: photo_loading,
              fetchpriority: photo_fetchpriority
          }}
        {%- endfor -%}
      {%- elsif product.featured_image -%}
        {%- assign featured_alt = product.featured_image.alt | default: card_title -%}
        {{
          product.featured_image
          | image_url: width: image_width
          | image_tag:
            class: 'ui-product-card__image',
            widths: image_widths,
            sizes: image_sizes,
            alt: featured_alt,
            loading: image_loading,
            fetchpriority: image_fetchpriority
        }}
      {%- else -%}
        <span class="ui-product-card__placeholder"></span>
      {%- endif -%}
    </a>

    {%- unless variant == 'search' -%}
      {%- capture protection_badge -%}{%- render 'ui-protection-badge', product: product -%}{%- endcapture -%}
      {%- if protection_badge != blank or sold_out or percent_off > 0 -%}
        <div class="ui-product-card__top">
          {{- protection_badge -}}
          {%- if sold_out -%}
            <span class="ui-product-card__promo ui-product-card__promo--sold-out">
              {{- 'products.product.sold_out' | t -}}
            </span>
          {%- elsif percent_off > 0 -%}
            <span class="ui-product-card__promo">{{ 'products.product.percent_off' | t: percent: percent_off }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if photo_count > 1 -%}
        <div class="ui-product-card__arrows">
          <button
            type="button"
            class="ui-product-card__arrow"
            data-step="-1"
            tabindex="-1"
            aria-label="{{ 'products.product.previous_photo' | t }}"
          >
            {%- render 'ui-icon', icon: 'chevron-left' -%}
          </button>
          <button
            type="button"
            class="ui-product-card__arrow"
            data-step="1"
            tabindex="-1"
            aria-label="{{ 'products.product.next_photo' | t }}"
          >
            {%- render 'ui-icon', icon: 'chevron-right' -%}
          </button>
        </div>
      {%- endif -%}

      {%- liquid
        assign quick_add = false
        if show_add and sold_out == false
          assign quick_add = true
        endif
      -%}
      {%- liquid
        assign show_quick_view = false
        if quick_view and variant != 'search'
          assign show_quick_view = true
        endif
      -%}
      {%- if brand_logo != blank or quick_add or show_quick_view or photo_count > 1 -%}
        <div class="ui-product-card__bottom">
          <div class="ui-product-card__bottom-row">
            {%- if brand_logo != blank -%}
              <span class="ui-product-card__brand">
                {{
                  brand_logo
                  | image_url: width: 120
                  | image_tag: class: 'ui-product-card__brand-logo', alt: product.vendor, loading: 'lazy'
                }}
              </span>
            {%- endif -%}
            {%- if quick_add -%}
              {%- liquid
                assign add_variant = product.selected_or_first_available_variant
                assign add_form_id = 'ProductCardAdd-' | append: section_id | append: '-' | append: product.id
                assign add_name = add_label
                if add_name == blank
                  assign add_name = 'products.product.add_to_cart' | t
                endif
              -%}
              {%- if product.variants.size == 1 and add_variant.available -%}
                <product-form class="ui-product-card__quick-add" data-section-id="{{ section_id }}">
                  {%- form 'product', product, id: add_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input type="hidden" name="id" value="{{ add_variant.id }}" class="product-variant-id">
                    <button
                      type="submit"
                      name="add"
                      class="ui-product-card__action"
                      aria-label="{{ add_name | escape }}"
                      aria-describedby="{{ title_id }}"
                    >
                      {%- render 'ui-icon', icon: 'plus' -%}
                    </button>
                  {%- endform -%}
                </product-form>
              {%- elsif show_quick_view -%}
                <button
                  type="button"
                  class="ui-product-card__action ui-product-card__quick-add"
                  data-quick-view="{{ card_url }}"
                  aria-haspopup="dialog"
                  aria-label="{{ 'products.product.choose_options' | t }}"
                  aria-describedby="{{ title_id }}"
                >
                  {%- render 'ui-icon', icon: 'plus' -%}
                </button>
              {%- else -%}
                <a
                  class="ui-product-card__action ui-product-card__quick-add"
                  href="{{ card_url }}"
                  aria-label="{{ 'products.product.choose_options' | t }}"
                  aria-describedby="{{ title_id }}"
                >
                  {%- render 'ui-icon', icon: 'plus' -%}
                </a>
              {%- endif -%}
            {%- endif -%}
            {%- if show_quick_view -%}
              {%- assign quick_view_label = 'products.quick_view.open' | t -%}
              <button
                type="button"
                class="ui-product-card__action ui-product-card__quick-view"
                data-quick-view="{{ card_url }}"
                aria-haspopup="dialog"
                aria-label="{{ quick_view_label }}"
                aria-describedby="{{ title_id }}"
                title="{{ quick_view_label }}"
              >
                {%- render 'ui-icon', icon: 'eye', size: 16 -%}
              </button>
            {%- endif -%}
          </div>
          {%- if photo_count > 1 -%}
            <div class="ui-product-card__progress" aria-hidden="true">
              {%- for i in (1..photo_count) -%}
                <span class="ui-product-card__segment"{% if forloop.first %} data-current{% endif %}></span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endunless -%}
  </product-card-gallery>

  <div class="ui-product-card__info">
    <h3 class="ui-product-card__name" id="{{ title_id }}">
      <a
        class="ui-product-card__link"
        href="{{ card_url }}"
        {% if tabindex != blank %}
          tabindex="{{ tabindex }}"
        {% endif %}
      >
        {{- card_title | escape -}}
      </a>
    </h3>

    {%- if show_price -%}
      <div class="ui-product-card__price-row">
        {%- if price_label != blank -%}
          <span class="ui-product-card__price-label">{{ price_label | escape }}</span>
        {%- else -%}
          {%- liquid
            assign compare_at_price = product.compare_at_price
            if sold_out
              assign compare_at_price = 0
            endif
          -%}
          {%- render 'ui-price', price: product.price, compare_at_price: compare_at_price, size: 'sm', trim: true -%}
        {%- endif -%}

        {%- if color_option != blank and variant != 'search' -%}
          {%- assign color_count = color_option.values.size -%}
          {%- assign extra_colors = color_count | minus: 3 -%}
          {%- assign color_names = color_option.values | join: ', ' -%}
          <div class="ui-product-card__swatches">
            <span class="visually-hidden">
              {{- 'products.product.colors_available' | t: count: color_count, colors: color_names -}}
            </span>
            {%- liquid
              # The ring starts on the color in the first photo, or on the product's first color when the first
              # photo isn't one color's.
              assign first_photo_id = card_images.first.id
              assign first_photo_color = ''
              for value in color_option.values limit: 3
                if image_asset == blank and value.variant.featured_media.id == first_photo_id
                  assign first_photo_color = value.name
                  break
                endif
              endfor
            -%}
            {%- for value in color_option.values limit: 3 -%}
              {%- liquid
                assign current_color = value.selected
                if first_photo_color != blank
                  assign current_color = false
                  if value.name == first_photo_color
                    assign current_color = true
                  endif
                endif
                assign color_media = ''
                if image_asset == blank
                  assign color_media = value.variant.featured_media
                endif
                assign photo_index = -1
                if color_media != blank
                  for media in card_images limit: photo_count
                    if media.id == color_media.id
                      assign photo_index = forloop.index0
                      break
                    endif
                  endfor
                endif
              -%}
              {%- if color_media != blank -%}
                {%- liquid
                  assign show_color = 'products.product.show_color' | t: color: value
                  assign color_photo = color_media.preview_image | default: color_media
                  assign photo_widths = image_widths | split: ','
                -%}
                {%- capture photo_srcset -%}
                  {%- for photo_width in photo_widths -%}
                    {%- assign photo_width = photo_width | strip | plus: 0 -%}
                    {{- color_photo | image_url: width: photo_width }} {{ photo_width }}w{% unless forloop.last %}, {% endunless -%}
                  {%- endfor -%}
                {%- endcapture -%}
                <button
                  type="button"
                  class="ui-product-card__swatch"
                  aria-label="{{ show_color | escape }}"
                  aria-pressed="{{ current_color }}"
                  data-card-swatch
                  {% if url == blank %}
                    data-url="{{ value.variant.url }}"
                  {% endif %}
                  {% if photo_index >= 0 %}
                    data-photo-index="{{ photo_index }}"
                  {% else %}
                    data-photo-src="{{ color_photo | image_url: width: image_width }}"
                    data-photo-srcset="{{ photo_srcset }}"
                    data-photo-alt="{{ color_photo.alt | default: card_title | escape }}"
                  {% endif %}
                >
                  {%- render 'swatch', swatch: value.swatch, color_name: value -%}
                </button>
              {%- else -%}
                <span class="ui-product-card__swatch" aria-hidden="true"{% if current_color %} data-current{% endif %}>
                  {%- render 'swatch', swatch: value.swatch, color_name: value -%}
                </span>
              {%- endif -%}
            {%- endfor -%}
            {%- if extra_colors > 0 -%}
              <span class="ui-product-card__more-colors" aria-hidden="true">+{{ extra_colors }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</article>
