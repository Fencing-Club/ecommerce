{% doc %}
  The product's size chart in a drawer, which the product page's Size guide link opens. Renders nothing when the
  product has no complete chart.

  @param {product} product - The product.
  @param {string} id - The drawer's dialog id, which Size guide points at.

  @example
  {% render 'size-chart-flyout', product: product, id: 'SizeChart-' | append: section.id %}
{% enddoc %}
{%- assign chart = product.metafields.custom.size_chart.value -%}
{%- capture validity -%}{%- render 'size-chart-validity', chart: chart -%}{%- endcapture -%}
{%- assign validity = validity | strip -%}
{%- if validity == 'true' -%}
  {{ 'size-chart.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'size-chart.js' | asset_url }}" defer="defer"></script>
  {%- liquid
    assign full_chart_link_id = id | append: '-FullChart'
    # The drawer escapes its title, so the chart's name goes in after the translation, which is escaped already.
    assign drawer_title = 'products.size_chart.title' | t: title: '[title]' | replace: '[title]', chart.title.value
    assign close_label = 'products.size_chart.close' | t
    assign full_chart_label = 'products.size_chart.full_chart' | t
  -%}
  {%- capture content -%}
    {% render 'size-chart-content', chart: chart, instance_id: id, is_flyout: true, full_chart_link_id: full_chart_link_id %}
  {%- endcapture -%}
  {%- capture footer -%}
    {% render 'ui-link', id: full_chart_link_id, label: full_chart_label, url: chart.system.url, icon: 'arrow-right', class: 'size-chart__full-link' %}
  {%- endcapture -%}
  {% render 'ui-drawer', id: id, title: drawer_title, close_label: close_label, content: content, footer: footer, size: 'wide' %}
{%- endif -%}
