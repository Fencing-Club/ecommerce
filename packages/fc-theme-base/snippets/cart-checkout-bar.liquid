{% doc %}
  Fixed checkout bar for phones. Tapping Total opens the order breakdown.
  @param {string} context - Unique cart view name.
  @param {string} form_id - Cart form to submit.
{% enddoc %}
{%- liquid
  capture savings_cents
    render 'cart-savings'
  endcapture
  assign savings = savings_cents | plus: 0
  assign savings_money = savings | money

  assign unavailable_count = 0
  for item in cart.items
    if item.variant.available == false
      assign unavailable_count = unavailable_count | plus: 1
    endif
  endfor
  assign checkout_reason = ''
  assign state = 'ready'
  if unavailable_count > 0
    assign checkout_reason = 'sections.cart.blocked_unavailable' | t: count: unavailable_count
    assign state = 'blocked'
  endif
  assign shipping_free = false
  assign bar_context = context | append: '-bar'
-%}
<cart-checkout-bar class="fc-bar" data-cart-bar data-checkout-state="{{ state }}">
  <div class="fc-bar__breakdown" id="CartBreakdown-{{ context }}" hidden>
    <div class="fc-bar__breakdown-head">
      <p class="fc-bar__breakdown-title" id="CartBreakdownTitle-{{ context }}">{{ 'sections.cart.order_summary' | t }}</p>
      <button type="button" class="fc-icon-button fc-icon-button--small" data-close-breakdown aria-label="{{ 'sections.cart.close_summary' | t }}">{% render 'fc-icon', icon: 'x', size: 16 %}</button>
    </div>
    <div data-cart-region="bar-breakdown">{% render 'cart-breakdown', variant: 'plain', shipping_free: shipping_free %}</div>
  </div>
  <div class="fc-bar__row" data-cart-region="bar-total">
    <div class="fc-bar__total">
      <button type="button" class="fc-bar__toggle" data-toggle-breakdown aria-controls="CartBreakdown-{{ context }}" aria-expanded="false">{{ 'sections.cart.total' | t }}{% render 'fc-icon', icon: 'chevron-up', size: 14 %}</button>
      <p class="fc-bar__value"><span>{{ cart.total_price | money }}</span></p>
    </div>
    {%- if savings > 0 -%}
      <p class="fc-bar__savings">{% render 'fc-icon', icon: 'badge-percent', size: 15 %}<span>{{ 'sections.cart.you_save' | t: amount: savings_money }}</span></p>
    {%- endif -%}
  </div>
  <div data-cart-region="bar-checkout">{% render 'cart-checkout', form_id: form_id, context: bar_context, reason: checkout_reason %}</div>
  <p class="fc-bar__note">{% if cart.taxes_included %}{{ 'sections.cart.taxes_included' | t }}{% else %}{{ 'sections.cart.taxes_at_checkout' | t }}{% endif %}</p>
</cart-checkout-bar>
