{%- comment -%}
  Renders one accessible FAQ disclosure.

  Accepts:
  - question: {String} Question text (required)
  - answer: {RichText} Answer content (required)
  - open: {Boolean} Expand the item initially
  - link_label: {String} Optional related link label
  - link_url: {String} Optional related link target
  - structured_data: {Boolean} Mark the item up as a schema.org Question, for a page marked up as an FAQPage
  - variant: {String} plain drops the Q and A badges and shows plus and minus, as in a collection's buying guide
  - block: {Block} Optional Theme Editor block
{%- endcomment -%}
<details
  class="ui-faq-item{% if variant == 'plain' %} ui-faq-item--plain{% endif %}"
  data-motion
  {% if open %}
    open
  {% endif %}
  {% if structured_data %}
    itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
  {% endif %}
  {% if block %}
    {{ block.shopify_attributes }}
  {% endif %}
>
  <summary class="ui-faq-item__question">
    {%- unless variant == 'plain' -%}
      <span class="ui-faq-item__badge ui-faq-item__badge--question" aria-hidden="true">Q</span>
    {%- endunless -%}
    <span class="ui-faq-item__question-text"{% if structured_data %} itemprop="name"{% endif %}>{{ question | escape }}</span>
    <span class="ui-faq-item__chevron" aria-hidden="true">
      {%- if variant == 'plain' -%}
        {%- render 'ui-icon', icon: 'plus', size: 18 -%}
        {%- render 'ui-icon', icon: 'minus', size: 18 -%}
      {%- else -%}
        {%- render 'ui-icon', icon: 'chevron-down', size: 18 -%}
      {%- endif -%}
    </span>
  </summary>
  <div
    class="ui-faq-item__answer"
    {% if structured_data %}
      itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"
    {% endif %}
  >
    {%- unless variant == 'plain' -%}
      <span class="ui-faq-item__badge ui-faq-item__badge--answer" aria-hidden="true">A</span>
    {%- endunless -%}
    <div class="ui-faq-item__answer-copy">
      <div class="ui-faq-item__answer-text rte"{% if structured_data %} itemprop="text"{% endif %}>{{ answer }}</div>
      {%- if link_label != blank and link_url != blank -%}
        {%- render 'ui-link', label: link_label, url: link_url, icon: 'arrow-right' -%}
      {%- endif -%}
    </div>
  </div>
</details>