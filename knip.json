{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["beachball.config.js", ".agents/skills/**"],
  "tags": ["-vendored"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["rulesync"]
    },
    "packages/fc-theme": {
      "entry": ["assets/*.js"],
      "ignore": ["assets/vendor-scripts-v11.js"]
    },
    "packages/fc-theme-base": {
      "entry": [
        "assets/*.js",
        "content/capture-migration.mjs",
        "tests/component-library/{cart-shim,cart-states,library,privacy-fixture,workflows}.js",
        "tests/preview-size-charts.mjs"
      ]
    },
    "packages/fc-templates": {
      "entry": ["src/emails/marketing/*.tsx", "src/emails/notifications/*.tsx", "src/emails/printouts/*/*.tsx"],
      "ignoreDependencies": ["@react-email/ui"]
    },
    "apps/copacker": {
      "entry": [
        ".storybook/mocks/*.ts",
        "tests/start-runtime/{cloudflare,vite}.config.ts",
        "tests/start-runtime/src/router.tsx",
        "tests/start-runtime/src/start.ts",
        "tests/start-runtime/src/server.ts",
        "tests/start-runtime/src/routes/**/*.{ts,tsx}",
        "cloudflare.config.ts",
        "e2e/runtime/cloudflare.config.ts",
        "src/{router,start,server}.{ts,tsx}",
        "src/routes/**/*.{ts,tsx}",
        "dev-domains.config.ts"
      ],
      "ignore": [".storybook/public/**"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/copacker/scheduler": {
      "entry": ["index.ts", "cloudflare.config.ts"]
    },
    "apps/video": {
      "entry": ["src/index.ts", "remotion.config.ts", "scripts/*.ts"]
    },
    "packages/copacker-emails": {
      "entry": ["src/emails/*.tsx"]
    }
  }
}
