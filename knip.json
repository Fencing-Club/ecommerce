{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["beachball.config.js"],
  "tags": ["-vendored"],
  "workspaces": {
    "packages/fc-theme": {
      "entry": ["assets/*.js"],
      "ignore": ["assets/vendor-scripts-v11.js"]
    },
    "packages/fc-theme-base": {
      "entry": [
        "assets/*.js",
        "content/capture-migration.mjs",
        "tests/component-library/{library,privacy-fixture,workflows}.js",
        "tests/preview-size-charts.mjs"
      ]
    },
    "packages/fc-templates": {
      "entry": ["src/emails/marketing/*.tsx", "src/emails/notifications/*.tsx", "src/emails/printouts/*/*.tsx"],
      "ignoreDependencies": ["@repo/oxlint-config", "@react-email/ui"]
    },
    "packages/shopify-emails": {
      "ignoreDependencies": ["@repo/oxlint-config"]
    },
    "packages/shopify-content": {
      "ignoreDependencies": ["@repo/oxlint-config"]
    },
    "apps/copacker": {
      "entry": [".storybook/mocks/*.ts", "dev-domains.config.ts"],
      "ignore": [".storybook/public/**"],
      "ignoreDependencies": ["@repo/oxlint-config"]
    },
    "apps/video": {
      "entry": ["src/index.ts", "remotion.config.ts", "scripts/*.ts"],
      "ignoreDependencies": ["@repo/oxlint-config"]
    },
    "packages/aisle": {
      "ignoreDependencies": ["@repo/oxlint-config"]
    },
    "packages/copacker-emails": {
      "entry": ["src/emails/*.tsx"],
      "ignoreDependencies": ["@repo/oxlint-config"]
    },
    "apps/turbo-cache": {
      "ignoreDependencies": ["@repo/oxlint-config"]
    }
  },
  "ignoreIssues": {
    "apps/copacker/src/components/ui/**": ["exports", "types"]
  }
}
