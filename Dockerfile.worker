# The retained background executor runs TypeScript through tsx. Web and Storybook run on Cloudflare.
FROM node:24-bookworm-slim
WORKDIR /app
RUN npm install -g pnpm@12.10.1
COPY . .
ENV LEFTHOOK=0
RUN npm pkg delete scripts.prepare && pnpm install --frozen-lockfile --filter copacker...
ENV NODE_ENV=production
CMD ["pnpm", "--filter", "copacker", "worker"]
