# The worker runs its TypeScript through tsx, so unlike the web image it skips next build.
FROM node:24-bookworm-slim
WORKDIR /app
ARG NPM_REGISTRY=https://registry.npmjs.org/
RUN npm install -g pnpm@12.10.1 --registry=$NPM_REGISTRY
COPY . .
ENV LEFTHOOK=0
RUN npm pkg delete scripts.prepare && pnpm install --frozen-lockfile --filter copacker... --registry=$NPM_REGISTRY
ENV NODE_ENV=production
CMD ["pnpm", "--filter", "copacker", "worker"]
