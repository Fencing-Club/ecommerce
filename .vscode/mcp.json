{
  "servers": {
    "langfuse": {
      "type": "http",
      "url": "https://us.cloud.langfuse.com/api/public/mcp",
      "headers": {
        "Authorization": "Basic ${input:langfuse-basic-auth}"
      }
    },
    "openrouter": {
      "type": "http",
      "url": "https://mcp.openrouter.ai/mcp"
    },
    "fluent-agent": {
      "type": "http",
      "url": "https://chat.fluentui.dev/mcp/server"
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    }
  },
  "inputs": [
    {
      "id": "n8n-access-token",
      "type": "promptString",
      "description": "n8n MCP access token",
      "password": true
    },
    {
      "id": "langfuse-basic-auth",
      "type": "promptString",
      "description": "Base64-encoded Langfuse public key and secret key",
      "password": true
    }
  ]
}
